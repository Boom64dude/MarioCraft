diff --git a/fabric/src/main/java/dev/skycraft/world/MarioAllies.java b/fabric/src/main/java/dev/skycraft/world/MarioAllies.java
new file mode 100644
index 0000000..6a9ee7d
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/world/MarioAllies.java
@@ -0,0 +1,131 @@
+package dev.skycraft.world;
+
+import dev.skycraft.SkyCraft;
+import dev.skycraft.combat.SkyrimActorEntity;
+import dev.skycraft.link.SkyLink;
+import dev.skycraft.mixin.MobGoalsAccessor;
+import dev.skycraft.mixin.NearestAttackableTargetGoalAccessor;
+import net.fabricmc.fabric.api.event.lifecycle.v1.ServerEntityEvents;
+import net.fabricmc.fabric.api.event.lifecycle.v1.ServerTickEvents;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.damagesource.DamageSource;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.NeutralMob;
+import net.minecraft.world.entity.ai.Brain;
+import net.minecraft.world.entity.ai.goal.target.HurtByTargetGoal;
+import net.minecraft.world.entity.ai.goal.target.NearestAttackableTargetGoal;
+import net.minecraft.world.entity.ai.memory.MemoryModuleType;
+import net.minecraft.world.entity.monster.Enemy;
+import net.minecraft.world.entity.player.Player;
+import org.jspecify.annotations.Nullable;
+
+/**
+ * MarioCraft: Minecraft's mobs fight for Steve. A mob spawned in Mario's world (spawn egg, /summon,
+ * a built Wither or Iron Golem...) stops going after players and goes after SM64's enemies instead:
+ * Goombas, Bob-ombs, Bullies, bosses. Their hits land on the enemies' stand-ins, which SM64 turns
+ * into Mario's attacks like Steve's own (mc_actors.c); creepers' and Withers' blasts hit them too.
+ * Mobs that can't attack (cows, sheep...) are left as they are. Hostile mobs never go after a player,
+ * not even one who hits them, and can't hurt one (MobNoPlayerTargetMixin, WitherHeadsMixin,
+ * PlayerHostileDamageMixin); neutral mobs still get angry at whoever hits them, as in
+ * Minecraft.
+ */
+public final class MarioAllies {
+	private static boolean logged;
+
+	private MarioAllies() {
+	}
+
+	public static void init() {
+		ServerEntityEvents.ENTITY_LOAD.register((entity, level) -> befriend(entity));
+		ServerTickEvents.END_SERVER_TICK.register(server -> {
+			if (++ticks % 5 != 0 || !SkyLink.active()) {
+				return;
+			}
+			for (ServerLevel level : server.getAllLevels()) {
+				for (Entity e : level.getAllEntities()) {
+					if (hostile(e)) {
+						forgetPlayers((Mob) e);
+					}
+				}
+			}
+		});
+	}
+
+	private static int ticks;
+
+	/**
+	 * A hostile mob (zombies, skeletons, creepers, the Wither...): in Mario's world it's on Steve's
+	 * side, never after players. Neutral mobs (wolves, golems, endermen, bees, zombified piglins...)
+	 * and peaceful ones are left as in Minecraft.
+	 */
+	public static boolean hostile(@Nullable Entity e) {
+		return e instanceof Mob && e instanceof Enemy && !(e instanceof NeutralMob) && !(e instanceof SkyrimActorEntity);
+	}
+
+	/** True if this damage comes from a hostile mob (or its arrow, skull, fireball, explosion). */
+	public static boolean fromHostile(DamageSource source) {
+		return SkyLink.active() && (hostile(source.getEntity()) || hostile(source.getDirectEntity()));
+	}
+
+	/** Mobs that think with a brain (piglin brutes, hoglins, zoglins, the warden...) don't use setTarget. */
+	private static void forgetPlayers(Mob mob) {
+		if (mob.getTarget() instanceof Player) {
+			mob.setTarget(null);
+		}
+		Brain<?> brain = mob.getBrain();
+		if (brain.hasMemoryValue(MemoryModuleType.ATTACK_TARGET) && brain.getMemory(MemoryModuleType.ATTACK_TARGET).orElse(null) instanceof Player) {
+			brain.eraseMemory(MemoryModuleType.ATTACK_TARGET);
+		}
+		if (brain.hasMemoryValue(MemoryModuleType.ANGRY_AT)) {
+			var uuid = brain.getMemory(MemoryModuleType.ANGRY_AT).orElse(null);
+			if (uuid != null && mob.level().getPlayerByUUID(uuid) != null) {
+				brain.eraseMemory(MemoryModuleType.ANGRY_AT);
+			}
+		}
+	}
+
+	private static void befriend(Entity entity) {
+		if (!(entity instanceof Mob mob) || entity instanceof SkyrimActorEntity || !SkyLink.active()) {
+			return;
+		}
+		if (hostile(mob)) {
+			// No getting even with players either (Minecraft's "hit me and I'll come for you").
+			((MobGoalsAccessor) mob).skycraft$targets().removeAllGoals(goal -> goal instanceof HurtByTargetGoal);
+		}
+		// Goals aren't saved with the mob: a reloaded one starts with Minecraft's again (and loses ours).
+		boolean already = ((MobGoalsAccessor) mob).skycraft$targets().getAvailableGoals().stream()
+			.anyMatch(w -> w.getGoal() instanceof NearestAttackableTargetGoal<?> n
+				&& ((NearestAttackableTargetGoalAccessor) n).skycraft$targetType() == SkyrimActorEntity.class);
+		if (already) {
+			return;
+		}
+		boolean[] hostileToPlayers = { false };
+		boolean hostile = hostile(mob);
+		((MobGoalsAccessor) mob).skycraft$targets().removeAllGoals(goal -> {
+			// (A neutral mob's "after players" goals are its anger at those who hit it: kept.)
+			if (goal instanceof NearestAttackableTargetGoal<?> nearest
+				&& ((NearestAttackableTargetGoalAccessor) nearest).skycraft$targetType().isAssignableFrom(Player.class) && !hostile) {
+				hostileToPlayers[0] = true;
+				return false;
+			}
+			if (goal instanceof NearestAttackableTargetGoal<?> nearest
+				&& ((NearestAttackableTargetGoalAccessor) nearest).skycraft$targetType().isAssignableFrom(Player.class)) {
+				hostileToPlayers[0] = true;
+				return true;
+			}
+			return false;
+		});
+		boolean fights = hostileToPlayers[0] || ((MobGoalsAccessor) mob).skycraft$goals().getAvailableGoals().stream()
+			.anyMatch(w -> w.getGoal().getClass().getSimpleName().contains("Attack") || w.getGoal().getClass().getSimpleName().contains("Swell"));
+		if (!fights) {
+			return;
+		}
+		((MobGoalsAccessor) mob).skycraft$targets().addGoal(1, new NearestAttackableTargetGoal<>(mob, SkyrimActorEntity.class, 5, false, false,
+			(target, level) -> target instanceof SkyrimActorEntity actor && actor.hostile()));
+		if (!logged) {
+			logged = true;
+			SkyCraft.LOG.info("MarioCraft: {} now fights SM64's enemies for the player", mob.getType().toShortString());
+		}
+	}
+}
diff --git a/fabric/src/main/java/dev/skycraft/world/MarioFalls.java b/fabric/src/main/java/dev/skycraft/world/MarioFalls.java
new file mode 100644
index 0000000..3179ff8
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/world/MarioFalls.java
@@ -0,0 +1,115 @@
+package dev.skycraft.world;
+
+import java.util.HashMap;
+import java.util.Iterator;
+import java.util.Map;
+import java.util.UUID;
+import net.fabricmc.fabric.api.event.lifecycle.v1.ServerTickEvents;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerPlayer;
+
+/**
+ * MarioCraft: Minecraft's fall damage, except for the drop SM64 puts the player into: coming into
+ * a level, out of a painting, pipe or warp, or being let go of by a cannon, a pole or Hoot. Mario
+ * lands from all of those unhurt, and the player had no say in how high up they started.
+ *
+ * <p>A player is marked safe when that happens (by their client: SkyClient), and the mark goes with
+ * their next landing (PlayerFallMixin), or once they've stood on the ground for a second, so it
+ * can't save them from a real fall later.
+ */
+public final class MarioFalls {
+	private static final int GROUNDED_TICKS = 20;
+	private static final int MAX_TICKS = 20 * 30; // never longer than half a minute
+	private static final Map<UUID, int[]> SAFE = new HashMap<>(); // uuid -> { ticks on the ground, ticks marked }
+
+	private MarioFalls() {
+	}
+
+	public static void init() {
+		ServerTickEvents.END_SERVER_TICK.register(MarioFalls::tick);
+	}
+
+	/**
+	 * Mario's caps as Minecraft effects, for the next two seconds (refreshed while the cap lasts):
+	 * the wing cap glides (Slow Falling, with its flight), the metal cap is iron (Resistance V,
+	 * Fire Resistance, Water Breathing: Metal Mario is unhurt and walks underwater), the vanish cap
+	 * is Invisibility. (Here because it's the other player-state helper the server keeps.)
+	 */
+	public static void capEffects(ServerPlayer player, int mask) {
+		int ticks = 40;
+		if ((mask & dev.skycraft.link.Proto.SKY_WING_CAP) != 0) {
+			player.addEffect(new net.minecraft.world.effect.MobEffectInstance(net.minecraft.world.effect.MobEffects.SLOW_FALLING, ticks, 0, true, true));
+		}
+		if ((mask & dev.skycraft.link.Proto.SKY_METAL_CAP) != 0) {
+			player.addEffect(new net.minecraft.world.effect.MobEffectInstance(net.minecraft.world.effect.MobEffects.RESISTANCE, ticks, 4, true, true));
+			player.addEffect(new net.minecraft.world.effect.MobEffectInstance(net.minecraft.world.effect.MobEffects.FIRE_RESISTANCE, ticks, 0, true, true));
+			player.addEffect(new net.minecraft.world.effect.MobEffectInstance(net.minecraft.world.effect.MobEffects.WATER_BREATHING, ticks, 0, true, true));
+		}
+		if ((mask & dev.skycraft.link.Proto.SKY_WATER_LEVEL) != 0) {
+			// (short: it's gone a moment after he leaves the water or the level)
+			player.addEffect(new net.minecraft.world.effect.MobEffectInstance(net.minecraft.world.effect.MobEffects.WATER_BREATHING, 25, 0, true, true));
+			player.setAirSupply(player.getMaxAirSupply());
+		}
+		if ((mask & dev.skycraft.link.Proto.SKY_VANISH_CAP) != 0) {
+			player.addEffect(new net.minecraft.world.effect.MobEffectInstance(net.minecraft.world.effect.MobEffects.INVISIBILITY, ticks, 0, true, true));
+		}
+	}
+
+	/**
+	 * SM64 healed the player (coins, a heart, a 1-up): their hearts, and their hunger too. Mario's
+	 * world has no food, and a hungry Steve can't sprint (no long or triple jumps) or heal by himself:
+	 * a coin is a bite to eat.
+	 */
+	public static void marioHeal(ServerPlayer player, float amount) {
+		player.heal(amount);
+		int food = Math.max(1, Math.round(amount));
+		player.getFoodData().eat(food, 0.4F);
+	}
+
+	public static void markSafe(ServerPlayer player) {
+		SAFE.put(player.getUUID(), new int[] { 0, 0 });
+		player.resetFallDistance();
+	}
+
+	/** At a landing: true (and the mark is used up) if this one mustn't hurt. */
+	public static boolean takeSafe(ServerPlayer player) {
+		return SAFE.remove(player.getUUID()) != null;
+	}
+
+	/**
+	 * One of Mario's jumps (a double or triple jump, a backflip, a wall kick: SM64's mariocraft.c)
+	 * took the player this many blocks higher than Minecraft's jump: those blocks of the fall don't
+	 * count. Mario lands his own jumps unhurt; a jump off a cliff still hurts as much as the cliff.
+	 */
+	private static final Map<UUID, float[]> JUMP_BONUS = new HashMap<>(); // uuid -> { blocks, ticks }
+
+	public static void markJump(ServerPlayer player, float blocks) {
+		JUMP_BONUS.put(player.getUUID(), new float[] { Math.max(0.0F, Math.min(blocks, 6.0F)), 0.0F });
+	}
+
+	/** At a landing: the fall, less the last Mario jump's extra height (used up). */
+	public static double takeJumpBonus(ServerPlayer player, double fallDistance) {
+		float[] b = JUMP_BONUS.remove(player.getUUID());
+		return b == null ? fallDistance : Math.max(0.0, fallDistance - b[0]);
+	}
+
+	private static void tick(MinecraftServer server) {
+		JUMP_BONUS.values().removeIf(b -> ++b[1] > 20 * 10);  // (a landing that never came)
+		if (SAFE.isEmpty()) {
+			return;
+		}
+		for (Iterator<Map.Entry<UUID, int[]>> it = SAFE.entrySet().iterator(); it.hasNext(); ) {
+			Map.Entry<UUID, int[]> e = it.next();
+			ServerPlayer player = server.getPlayerList().getPlayer(e.getKey());
+			int[] t = e.getValue();
+			if (player == null || ++t[1] > MAX_TICKS) {
+				it.remove();
+				continue;
+			}
+			t[0] = player.onGround() ? t[0] + 1 : 0;
+			if (t[0] >= GROUNDED_TICKS) {
+				it.remove(); // landed softly (no fall damage call): nothing left to save them from
+			}
+		}
+	}
+}
diff --git a/fabric/src/main/java/dev/skycraft/world/MarioLives.java b/fabric/src/main/java/dev/skycraft/world/MarioLives.java
new file mode 100644
index 0000000..4450cc8
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/world/MarioLives.java
@@ -0,0 +1,90 @@
+package dev.skycraft.world;
+
+import dev.skycraft.SkyCraft;
+import dev.skycraft.combat.SkyCombat;
+import dev.skycraft.link.Proto;
+import dev.skycraft.link.SkyLink;
+import dev.skycraft.net.SkyNet;
+import net.fabricmc.fabric.api.entity.event.v1.ServerLivingEntityEvents;
+import net.fabricmc.fabric.api.networking.v1.ServerPlayNetworking;
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.effect.MobEffectInstance;
+import net.minecraft.world.effect.MobEffects;
+
+/**
+ * MarioCraft: Steve dies the way Mario does. Running out of hearts costs one of Mario's lives
+ * (SM64 takes him out of the course, as it would Mario) and his hearts come back full, with his
+ * inventory kept. No Minecraft death screen and no respawn: the respawn froze Minecraft's server
+ * for a minute (every command typed meanwhile only ran afterwards), and where Steve goes next is
+ * SM64's to say anyway.
+ */
+public final class MarioLives {
+	private MarioLives() {
+	}
+
+	public static void init() {
+		ServerLivingEntityEvents.ALLOW_DEATH.register((entity, source, amount) -> {
+			if (!(entity instanceof ServerPlayer player) || !SkyLink.active() || player.isSpectator()) {
+				return true;
+			}
+			if (source.is(net.minecraft.world.damagesource.DamageTypes.GENERIC_KILL)) {
+				return true;  // /kill still kills (falling out of the world is a lost life: SM64 puts him back)
+			}
+			long now = player.level().getGameTime();
+			Long last = LAST_LOSS.get(player.getUUID());
+			if (last != null && now - last < 100) {
+				// Still finishing him off (the void hits every tick): one life for it, he's only healed.
+				player.setHealth(player.getMaxHealth());
+				return false;
+			}
+			LAST_LOSS.put(player.getUUID(), now);
+			loseLife(player, SkyCombat.attackerFormId(source));
+			// Said like Minecraft's death messages, in everyone's chat: what SM64 says got him, or
+			// Minecraft's own message (a zombie, a cactus, a fall) when it wasn't SM64.
+			String cause = CAUSES.getOrDefault(player.getUUID(), "");
+			if (cause.isEmpty() && source.is(net.minecraft.world.damagesource.DamageTypes.FELL_OUT_OF_WORLD)) {
+				cause = "fell out of the Mushroom Kingdom";
+			}
+			Component message = cause.isEmpty() ? source.getLocalizedDeathMessage(player)
+				: Component.literal(player.getPlainTextName() + " " + cause);
+			var server = player.level().getServer();
+			if (server != null) {
+				server.getPlayerList().broadcastSystemMessage(message, false);
+			}
+			SkyCraft.LOG.info("MarioCraft: {} lost a life ({})", player.getPlainTextName(), message.getString());
+			return false;
+		});
+	}
+
+	private static final java.util.Map<java.util.UUID, Long> LAST_LOSS = new java.util.HashMap<>();
+
+	/** How SM64's hit being applied right now would kill this player (SkyCombat.hurtPlayer), or "". Server thread. */
+	private static final java.util.Map<java.util.UUID, String> CAUSES = new java.util.HashMap<>();
+
+	public static void cause(ServerPlayer player, String cause) {
+		if (cause == null || cause.isEmpty()) {
+			CAUSES.remove(player.getUUID());
+		} else {
+			CAUSES.put(player.getUUID(), cause);
+		}
+	}
+
+	private static void loseLife(ServerPlayer player, int attacker) {
+		// Tell their SM64: the host's through the link, a guest's through their Minecraft.
+		if (SkyNet.isHost(player)) {
+			SkyLink.pushEvent(Proto.EV_PLAYER_DIED, attacker, 0, 0, 0, 0, 0);
+		} else if (ServerPlayNetworking.canSend(player, SkyNet.Died.TYPE)) {
+			ServerPlayNetworking.send(player, new SkyNet.Died(attacker));
+		}
+		player.setHealth(player.getMaxHealth());
+		player.getFoodData().setFoodLevel(20);
+		player.clearFire();
+		player.setAirSupply(player.getMaxAirSupply());
+		player.resetFallDistance();
+		// A few seconds of safety while SM64 takes him out (whatever finished him may still be there).
+		player.addEffect(new MobEffectInstance(MobEffects.RESISTANCE, 100, 4, true, false));
+		player.addEffect(new MobEffectInstance(MobEffects.FIRE_RESISTANCE, 100, 0, true, false));
+		MarioFalls.markSafe(player);
+	}
+}
diff --git a/fabric/src/main/java/dev/skycraft/world/MarioMobs.java b/fabric/src/main/java/dev/skycraft/world/MarioMobs.java
new file mode 100644
index 0000000..74f3975
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/world/MarioMobs.java
@@ -0,0 +1,122 @@
+package dev.skycraft.world;
+
+import dev.skycraft.SkyCraft;
+import dev.skycraft.link.SkyLink;
+import java.util.List;
+import net.fabricmc.fabric.api.event.lifecycle.v1.ServerTickEvents;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.util.RandomSource;
+import net.minecraft.world.entity.EntitySpawnReason;
+import net.minecraft.world.entity.EntityType;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.animal.Animal;
+import net.minecraft.world.entity.monster.Monster;
+import net.minecraft.world.phys.AABB;
+
+/**
+ * MarioCraft: Minecraft's mobs in Mario's levels.
+ *
+ * Minecraft's own spawning only puts mobs on Minecraft blocks, and Mario's levels aren't made of
+ * blocks (their shape comes from SM64, see SkyCollision). So this spawns them itself: every couple
+ * of seconds, if there are fewer than a handful around Mario, one more appears on SM64's ground
+ * somewhere 14-30 blocks away. Monsters and animals both, like a Minecraft night.
+ */
+public final class MarioMobs {
+	private static final int MAX_MONSTERS = 6;
+	private static final int MAX_ANIMALS = 4;
+	private static final double COUNT_RANGE = 48.0;
+	private static final int EVERY_TICKS = 40;
+
+	// By name, looked up in Minecraft's registry (stays valid however Minecraft organises its classes).
+	private static final String[] MONSTERS = { "zombie", "zombie", "skeleton", "creeper", "spider" };
+	private static final String[] ANIMALS = { "cow", "pig", "sheep", "chicken" };
+
+	private static final java.util.Map<String, EntityType<?>> TYPES = new java.util.HashMap<>();
+
+	/** A mob type by its Minecraft name ("zombie"), from Minecraft's registry of entity types. */
+	private static EntityType<?> typeNamed(String name) {
+		if (TYPES.isEmpty()) {
+			for (EntityType<?> type : BuiltInRegistries.ENTITY_TYPE) {
+				var id = BuiltInRegistries.ENTITY_TYPE.getKey(type);
+				if (id != null && "minecraft".equals(id.getNamespace())) {
+					TYPES.put(id.getPath(), type);
+				}
+			}
+		}
+		return TYPES.get(name);
+	}
+
+	private static int ticks;
+	private static boolean logged;
+
+	private MarioMobs() {
+	}
+
+	public static void init() {
+		ServerTickEvents.END_SERVER_TICK.register(MarioMobs::serverTick);
+	}
+
+	private static void serverTick(MinecraftServer server) {
+		if (++ticks % EVERY_TICKS != 0 || !SkyLink.active() || !SkyCollision.active()) {
+			return;
+		}
+		List<ServerPlayer> players = server.getPlayerList().getPlayers();
+		if (players.isEmpty()) {
+			return;
+		}
+		ServerPlayer player = players.getFirst();
+		ServerLevel level = player.level();
+		AABB around = player.getBoundingBox().inflate(COUNT_RANGE);
+		int monsters = level.getEntitiesOfClass(Monster.class, around).size();
+		int animals = level.getEntitiesOfClass(Animal.class, around).size();
+		RandomSource random = level.getRandom();
+		if (monsters < MAX_MONSTERS) {
+			trySpawn(level, player, MONSTERS[random.nextInt(MONSTERS.length)], random);
+		}
+		if (animals < MAX_ANIMALS && random.nextInt(3) == 0) {
+			trySpawn(level, player, ANIMALS[random.nextInt(ANIMALS.length)], random);
+		}
+	}
+
+	private static void trySpawn(ServerLevel level, ServerPlayer player, String name, RandomSource random) {
+		EntityType<?> type = typeNamed(name);
+		if (type == null) {
+			return;
+		}
+		double angle = random.nextDouble() * Math.PI * 2.0;
+		double distance = 14.0 + random.nextDouble() * 16.0;
+		int x = (int) Math.floor(player.getX() + Math.cos(angle) * distance);
+		int z = (int) Math.floor(player.getZ() + Math.sin(angle) * distance);
+		int top = (int) Math.floor(player.getY()) + 12;
+		// Highest SM64 ground (or Minecraft block) in this column, near Mario's height, with room
+		// above it for the mob.
+		for (int y = top; y > top - 32; y--) {
+			BlockPos ground = new BlockPos(x, y, z);
+			boolean solid = SkyCollision.hasGeometry(ground) || !level.getBlockState(ground).isAir();
+			if (!solid) {
+				continue;
+			}
+			BlockPos feet = ground.above();
+			if (SkyCollision.hasGeometry(feet) || SkyCollision.hasGeometry(feet.above())
+				|| !level.getBlockState(feet).isAir() || !level.getBlockState(feet.above()).isAir()) {
+				return; // inside a wall or under a ceiling: try another spot next time
+			}
+			if (!(type.create(level, EntitySpawnReason.NATURAL) instanceof Mob mob)) {
+				return;
+			}
+			// Just above the ground; it drops onto SM64's surface.
+			double groundTop = y + Math.max(SkyCollision.groundTop(ground), 0.0F);
+			mob.snapTo(x + 0.5, groundTop + 0.05, z + 0.5, random.nextFloat() * 360.0F, 0.0F);
+			mob.finalizeSpawn(level, level.getCurrentDifficultyAt(feet), EntitySpawnReason.NATURAL, null);
+			if (level.addFreshEntity(mob) && !logged) {
+				logged = true;
+				SkyCraft.LOG.info("MarioCraft: mobs are spawning in Mario's level (first: {})", name);
+			}
+			return;
+		}
+	}
+}
