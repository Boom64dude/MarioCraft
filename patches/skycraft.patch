diff --git a/fabric/src/client/java/dev/skycraft/client/GuestActorsClient.java b/fabric/src/client/java/dev/skycraft/client/GuestActorsClient.java
new file mode 100644
index 0000000..69a3568
--- /dev/null
+++ b/fabric/src/client/java/dev/skycraft/client/GuestActorsClient.java
@@ -0,0 +1,62 @@
+package dev.skycraft.client;
+
+import dev.skycraft.link.Proto;
+import dev.skycraft.link.SkyLink;
+import dev.skycraft.net.SkyNet;
+import java.util.ArrayList;
+import java.util.List;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.minecraft.client.Minecraft;
+
+/**
+ * MarioCraft multiplayer, a guest's side of fighting: their own SM64's enemies (the actor table it
+ * writes, in whatever level they're in) go to the host's server every other tick, which makes
+ * stand-ins for them (SkyCombat); hits on those, and explosions, come back here and go to SM64 as
+ * if the hit had happened on this machine.
+ */
+public final class GuestActorsClient {
+	private static final double RANGE = 32.0;
+	private static final List<SkyLink.Actor> ACTORS = new ArrayList<>();
+	private static int ticks;
+	private static boolean sentAny;
+
+	private GuestActorsClient() {
+	}
+
+	public static void register() {
+		ClientPlayNetworking.registerGlobalReceiver(SkyNet.HitActor.TYPE, (payload, context) -> {
+			if (SkyLink.active()) {
+				SkyLink.pushEvent(Proto.EV_HIT_ACTOR, payload.formId(), payload.damage(), payload.pushX(), payload.pushZ(), payload.push(), payload.flags(),
+					payload.weapon());
+			}
+		});
+		ClientPlayNetworking.registerGlobalReceiver(SkyNet.Explosion.TYPE, (payload, context) -> {
+			if (SkyLink.active()) {
+				SkyLink.pushEvent(Proto.EV_EXPLOSION, 0, payload.x(), payload.y(), payload.z(), payload.radius(), 0);
+			}
+		});
+	}
+
+	/** Every client tick. */
+	public static void tick(Minecraft minecraft) {
+		if (++ticks % 2 != 0 || minecraft.player == null || minecraft.getSingleplayerServer() != null || !SkyLink.active()
+			|| !ClientPlayNetworking.canSend(SkyNet.GuestActors.TYPE) || !SkyLink.readActors(ACTORS)) {
+			return;
+		}
+		List<SkyNet.GuestActor> near = new ArrayList<>();
+		for (SkyLink.Actor a : ACTORS) {
+			if (a.dead() || minecraft.player.distanceToSqr(a.x(), a.y(), a.z()) > RANGE * RANGE) {
+				continue;
+			}
+			near.add(new SkyNet.GuestActor(a.formId(), a.flags(), a.x(), a.y(), a.z(), a.yaw(), a.width(), a.height(), a.name()));
+			if (near.size() == 64) {
+				break;
+			}
+		}
+		if (near.isEmpty() && !sentAny) {
+			return;
+		}
+		sentAny = !near.isEmpty();
+		ClientPlayNetworking.send(new SkyNet.GuestActors(near));
+	}
+}
diff --git a/fabric/src/client/java/dev/skycraft/client/GuestShapeClient.java b/fabric/src/client/java/dev/skycraft/client/GuestShapeClient.java
new file mode 100644
index 0000000..7ae2084
--- /dev/null
+++ b/fabric/src/client/java/dev/skycraft/client/GuestShapeClient.java
@@ -0,0 +1,67 @@
+package dev.skycraft.client;
+
+import dev.skycraft.link.SkyLink;
+import dev.skycraft.net.SkyNet;
+import dev.skycraft.world.SkyCollision;
+import java.util.Arrays;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.minecraft.client.Minecraft;
+
+/**
+ * MarioCraft multiplayer, a guest's level shape for the host's server: the server only has the
+ * host's SM64 level, so near a guest in another level items and mobs fell through the ground.
+ * Every collision message the guest's SM64 sends goes up too (SkyNet.GuestShape), a few per tick,
+ * and all of them again on joining.
+ */
+public final class GuestShapeClient {
+	/** At most this much a tick (about 1 MB a second, only while a level is loading): it goes over the internet. */
+	private static final int BYTES_PER_TICK = 48 * 1024;
+	private static final int PER_TICK = 40;
+	private static boolean wasGuest;
+	private static int msgId;
+	private static byte[] sending;
+	private static int sendingPart;
+
+	private GuestShapeClient() {
+	}
+
+	/** Every client tick. */
+	public static void tick(Minecraft minecraft) {
+		boolean guest = minecraft.player != null && minecraft.getSingleplayerServer() == null && SkyLink.active()
+			&& ClientPlayNetworking.canSend(SkyNet.GuestShape.TYPE);
+		SkyCollision.uploading = guest;
+		if (guest && !wasGuest) {
+			SkyCollision.requeueAllForUpload();
+			sending = null;
+		}
+		wasGuest = guest;
+		if (!guest) {
+			sending = null;
+			return;
+		}
+		int sent = 0;
+		for (int n = 0; n < PER_TICK && sent < BYTES_PER_TICK; n++) {
+			if (sending == null) {
+				sending = SkyCollision.pollUpload();
+				sendingPart = 0;
+				msgId++;
+				if (sending == null) {
+					return;
+				}
+			}
+			int size = SkyNet.GuestShape.PART_BYTES;
+			int total = (sending.length + size - 1) / size;
+			if (total > 256) {
+				sending = null;  // (bigger than any region SM64 sends)
+				continue;
+			}
+			int from = sendingPart * size;
+			byte[] part = Arrays.copyOfRange(sending, from, Math.min(sending.length, from + size));
+			ClientPlayNetworking.send(new SkyNet.GuestShape(msgId, sendingPart, total, part));
+			sent += part.length;
+			if (++sendingPart == total) {
+				sending = null;
+			}
+		}
+	}
+}
