+/**
+ * MarioCraft: sliding down a slide (Princess's Secret Slide, the penguin race, Tall Tall Mountain's
+ * slide) Steve sits, as Mario slides on his backside: drawn the way Minecraft draws a rider. In F5,
+ * and in the body SM64 is sent.
+ */
+@Mixin(AvatarRenderer.class)
+public abstract class AvatarSittingMixin {
+	@Inject(method = "extractRenderState(Lnet/minecraft/world/entity/Avatar;Lnet/minecraft/client/renderer/entity/state/AvatarRenderState;F)V",
+		at = @At("TAIL"))
+	private void skycraft$sitOnSlides(Avatar entity, AvatarRenderState state, float partialTick, CallbackInfo ci) {
+		if (entity == Minecraft.getInstance().player && SkyLink.active() && SkyClient.sky().sliding()) {
+			state.isPassenger = true;
+		}
+	}
+}
