@@ -0,0 +1,38 @@
+package dev.skycraft.mixin;
+
+import dev.skycraft.link.SkyLink;
+import dev.skycraft.world.MarioFalls;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.damagesource.DamageSource;
+import net.minecraft.world.entity.player.Player;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.ModifyVariable;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
+
+/**
+ * MarioCraft: Minecraft's fall damage as usual, except for the landing after SM64 put the player
+ * somewhere or let go of them (MarioFalls): loading into a level must not hurt. And the extra
+ * height of one of Mario's jumps doesn't count.
+ */
+@Mixin(Player.class)
+public abstract class PlayerFallMixin {
+	@Inject(method = "causeFallDamage", at = @At("HEAD"), cancellable = true)
+	private void skycraft$safeLanding(double fallDistance, float multiplier, DamageSource source, CallbackInfoReturnable<Boolean> cir) {
+		if ((Object) this instanceof ServerPlayer player && SkyLink.active() && MarioFalls.takeSafe(player)) {
+			player.resetFallDistance();
+			cir.setReturnValue(false);
+		}
+	}
+
+	@ModifyVariable(method = "causeFallDamage", at = @At("HEAD"), argsOnly = true)
+	private double skycraft$marioJump(double fallDistance) {
+		if ((Object) this instanceof ServerPlayer player && SkyLink.active()) {
+			// Mario never dies of a fall (the worst costs him 3 of his 8 wedges), and some stars are
+			// down long drops: Minecraft's fall damage, but never more than 6 hearts at once.
+			return Math.min(MarioFalls.takeJumpBonus(player, fallDistance), 15.0);
+		}
+		return fallDistance;
+	}
+}
