+			}
+			for (var p : server.getPlayerList().getPlayers()) {
+				if (dev.skycraft.net.SkyNet.isHost(p) || p.distanceToSqr(center) > 96.0 * 96.0
+					|| (host != null && host.distanceToSqr(center) < 96.0 * 96.0)) {
+					continue;
+				}
+				net.fabricmc.fabric.api.networking.v1.ServerPlayNetworking.send(p,
+					new dev.skycraft.net.SkyNet.Explosion((float) center.x, (float) center.y, (float) center.z, self.radius()));
+			}
