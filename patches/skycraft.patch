 		ServerExplosion self = (ServerExplosion) (Object) this;
 		var center = self.center();
 		SkyLink.pushEvent(Proto.EV_EXPLOSION, 0, (float) center.x, (float) center.y, (float) center.z, self.radius(), 0);
+		// MarioCraft: guests' SM64 enemies too, for guests in another level than the host (in the
+		// same one, the host's SM64 already hit them, and SM64-coop shares that).
+		var server = self.level().getServer();
+		if (server != null) {
+			net.minecraft.server.level.ServerPlayer host = null;
+			for (var p : server.getPlayerList().getPlayers()) {
+				if (dev.skycraft.net.SkyNet.isHost(p)) {
