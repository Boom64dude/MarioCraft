+void mc_actors_events(uint32_t worldId);                       // Minecraft's hits, explosions, deaths
+uint32_t mc_actor_form_id(const struct Object *o);             // an object's stand-in id (0: none)
+bool mc_actors_take_steve_died(void);
+int mc_actors_status(char *out, int size);
+
+// mc_steve.c: Steve's name, face (HUD) and texts, every game frame
