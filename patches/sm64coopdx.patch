diff --git a/src/pc/mariocraft/mc_actors.c b/src/pc/mariocraft/mc_actors.c
new file mode 100644
index 000000000..b6d04ec0e
--- /dev/null
+++ b/src/pc/mariocraft/mc_actors.c
@@ -0,0 +1,736 @@
+// MarioCraft: fighting SM64's enemies with Minecraft weapons.
+//
+// SkyCraft's Minecraft mod mirrors every "actor" it's told about as an invisible stand-in entity
+// (SkyCombat / SkyrimActorEntity). Minecraft's own combat then works on it as on any mob: the
+// crosshair finds it, swords and axes hit it, falling hits are critical hits, sweeps, knockback,
+// enchantments and the attack cooldown all count, arrows stick. Each hit comes back to us through
+// the event ring, and here it becomes what Mario's own attacks do to that enemy:
+//
+//   - a normal hit is a punch (a Goomba is knocked out, a Bob-omb is kicked away, a crate breaks,
+//     a Bully is shoved),
+//   - a critical hit is a ground pound (the strongest attack Mario has), with a burst of stars,
+//   - an axe (or a critical hit) knocks a wooden post into the ground, like Mario's ground pound:
+//     three of them free the Chain Chomp,
+//   - a Minecraft explosion (TNT, a creeper) near enemies hits them all.
+//
+// When an enemy hurts Steve, its stand-in is named as the attacker, so Minecraft knocks Steve
+// back away from it like any mob hit.
+
+#include "mariocraft_internal.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+#ifdef _WIN32
+#include <windows.h>
+#define MC_BARRIER() MemoryBarrier()
+#else
+#define MC_BARRIER() __sync_synchronize()
+#endif
+
+#include "sm64.h"
+#include "behavior_data.h"
+#include "behavior_table.h"
+#include "object_fields.h"
+#include "game/object_list_processor.h"
+#include "game/object_helpers.h"
+#include "game/interaction.h"
+#include "game/level_update.h"
+#include "game/mario.h"
+#include "audio/external.h"
+#include "engine/math_util.h"
+#include "object_constants.h"
+#include "game/obj_behaviors.h"
+#include "game/behavior_actions.h"
+#include "game/spawn_sound.h"
+#include "pc/network/network.h"
+
+// interaction.c (not in its header): what Mario's attacks do to an object.
+extern u32 attack_object(struct MarioState *m, struct Object *o, s32 interaction);
+
+#define OFF_ACTOR_TABLE 0x12000ull
+#define OFF_EVENT_RING  0x17000ull
+#define MAX_ACTORS      256
+#define EVENT_ENTRIES   512
+#define EVENT_BYTES     32
+
+#define ACTOR_HOSTILE   (1u << 0)
+
+#define EV_HIT_ACTOR    1
+#define EV_PLAYER_DIED  2
+#define EV_EXPLOSION    3
+
+#define HIT_CRITICAL    (1u << 0)
+#define HIT_PROJECTILE  (1u << 1)
+#define HIT_SMASH       (1u << 4)  // a mace's smash attack (swung while falling)
+#define WEAPON_AXE      2
+#define WEAPON_MACE     6
+
+// Minecraft's hurt flash: an object Steve (or a mob on his side) hit is drawn red for half a second
+// (rendering_graph_node.c asks mariocraft_hurt_flash about each object it draws).
+#define FLASH_FRAMES    15
+static uint8_t sFlash[OBJECT_POOL_CAPACITY];
+
+// Bosses: hits towards their next life, and frames before the next one counts (boss_hit).
+static uint8_t sBossHits[OBJECT_POOL_CAPACITY];
+static uint8_t sMaceWait[OBJECT_POOL_CAPACITY];
+
+uint8_t mariocraft_hurt_flash(const struct Object *o) {
+    if (o < gObjectPool || o >= gObjectPool + OBJECT_POOL_CAPACITY) {
+        return 0;
+    }
+    return sFlash[o - gObjectPool] > 0 ? 150 : 0;
+}
+
+static void flash(const struct Object *o) {
+    if (o >= gObjectPool && o < gObjectPool + OBJECT_POOL_CAPACITY) {
+        sFlash[o - gObjectPool] = FLASH_FRAMES;
+    }
+}
+
+#pragma pack(push, 1)
+struct ActorRecord {
+    uint32_t formId;
+    uint32_t flags;
+    float x, y, z;       // feet, Minecraft coordinates
+    float yaw;           // Minecraft degrees
+    float width, height; // blocks
+    float healthFrac;
+    uint16_t level;
+    uint16_t pad;
+    char name[24];
+};
+#pragma pack(pop)
+_Static_assert(sizeof(struct ActorRecord) == 64, "ActorRecord layout");
+
+// What each form id (an object's slot in SM64's object pool, plus one) was when we listed it,
+// so a hit never lands on a different object that took over the slot since.
+static const BehaviorScript *sListedBehavior[OBJECT_POOL_CAPACITY + 1];
+
+static bool sSteveDied = false;
+static int sHits = 0, sCrits = 0;  // for the status line
+static char sLastHit[48] = "";
+
+static bool is_behavior(const struct Object *o, enum BehaviorId id) {
+    return o != NULL && get_id_from_behavior(o->behavior) == id;
+}
+
+uint32_t mc_actor_form_id(const struct Object *o) {
+    if (o == NULL || o < gObjectPool || o >= gObjectPool + OBJECT_POOL_CAPACITY) {
+        return 0;
+    }
+    // Bowser's body hurts Mario through a helper object; Bowser himself is the one Steve sees.
+    if (is_behavior(o, id_bhvBowserBodyAnchor) && o->parentObj != NULL) {
+        o = o->parentObj;
+    }
+    return (uint32_t) (o - gObjectPool) + 1;
+}
+
+static struct Object *object_for(uint32_t formId) {
+    if (formId == 0 || formId > OBJECT_POOL_CAPACITY) {
+        return NULL;
+    }
+    struct Object *o = &gObjectPool[formId - 1];
+    if (o->activeFlags == ACTIVE_FLAG_DEACTIVATED || o->behavior != sListedBehavior[formId]) {
+        return NULL;
+    }
+    return o;
+}
+
+// The kinds of things Mario can attack (and so Steve can hit).
+#define ATTACKABLE (INTERACT_BOUNCE_TOP | INTERACT_BOUNCE_TOP2 | INTERACT_KOOPA | INTERACT_HIT_FROM_BELOW | INTERACT_BREAKABLE \
+                    | INTERACT_BULLY | INTERACT_SPINY_WALKING | INTERACT_GRABBABLE)
+
+static bool is_wooden_post(const struct Object *o) {
+    return get_id_from_behavior(o->behavior) == id_bhvWoodenPost;
+}
+
+// Whomps are only solid ground to SM64 (no hitbox: Mario hurts them by ground pounding their
+// backs). They get a stand-in all the same, for Steve's weapons (boss_hit).
+static bool is_whomp(const struct Object *o) {
+    enum BehaviorId id = get_id_from_behavior(o->behavior);
+    return id == id_bhvSmallWhomp || id == id_bhvWhompKingBoss;
+}
+
+// Things Mario picks up and throws: King Bob-omb, Chuckya, Bowser (by the tail), crates. Not
+// the ones he carries gently (Mips, Ukiki, the baby penguin) or can't lift (Heave-Ho).
+static bool is_throwable(const struct Object *o) {
+    return (o->oInteractType & INTERACT_GRABBABLE) && (o->oFlags & OBJ_FLAG_HOLDABLE)
+        && !(o->oInteractionSubtype & (INT_SUBTYPE_NOT_GRABBABLE | INT_SUBTYPE_HOLDABLE_NPC | INT_SUBTYPE_KICKABLE));
+}
+
+// Should this object get a stand-in Steve can hit?
+static bool mirrored(struct Object *o, struct MarioState *m, uint32_t *flags) {
+    if (o->activeFlags == ACTIVE_FLAG_DEACTIVATED || !(o->activeFlags & ACTIVE_FLAG_ACTIVE) || o == m->marioObj) {
+        return false;
+    }
+    if (o->oInteractType & INTERACT_PLAYER) {
+        return false;
+    }
+    if (!(o->header.gfx.node.flags & GRAPH_RENDER_ACTIVE) || (o->header.gfx.node.flags & GRAPH_RENDER_INVISIBLE)) {
+        return false;
+    }
+    bool post = is_wooden_post(o);
+    bool hostile = (o->oInteractType & (ATTACKABLE | INTERACT_DAMAGE)) != 0 || is_whomp(o);
+    // People and signs (Bob-omb Buddies, Toads, signposts): Steve talks to them with a right
+    // click; their stand-in stops that click placing a block behind them instead.
+    bool talks = (o->oInteractType & INTERACT_TEXT) && (o->oInteractionSubtype & (INT_SUBTYPE_NPC | INT_SUBTYPE_SIGN));
+    if (!post && !hostile && !talks) {
+        return false;
+    }
+    // Things being carried or thrown right now, and grabbables Steve can't do anything with.
+    if (o->oHeldState != HELD_FREE) {
+        return false;
+    }
+    if ((o->oInteractType & INTERACT_GRABBABLE) && !(o->oInteractionSubtype & INT_SUBTYPE_KICKABLE)
+        && !(o->oInteractType & (ATTACKABLE & ~INTERACT_GRABBABLE)) && !is_throwable(o)) {
+        return false;
+    }
+    // Bowser's body is Bowser: one stand-in for both (mc_actor_form_id).
+    if (is_behavior(o, id_bhvBowserBodyAnchor)) {
+        return false;
+    }
+    float dx = o->oPosX - m->pos[0], dy = o->oPosY - m->pos[1], dz = o->oPosZ - m->pos[2];
+    if (dx * dx + dy * dy + dz * dz > 4800.0f * 4800.0f) {
+        return false;
+    }
+    *flags = ((o->oInteractType & (ATTACKABLE | INTERACT_DAMAGE)) || is_whomp(o)) ? ACTOR_HOSTILE : 0;
+    return true;
+}
+
+// ---- the actor table (written every game frame) -----------------------------------------------
+
+void mc_actors_write(uint32_t worldId, struct MarioState *m) {
+    if (gMcShm == NULL || m == NULL || m->marioObj == NULL) {
+        return;
+    }
+    uint8_t *table = gMcShm + OFF_ACTOR_TABLE;
+    volatile uint32_t *seq = (volatile uint32_t *) table;
+    uint32_t s = *seq;
+    *seq = s | 1;  // odd: writing
+    MC_BARRIER();
+    struct ActorRecord *out = (struct ActorRecord *) (table + 0x40);
+    uint32_t count = 0;
+    double originX = mc_origin_x(worldId);
+    for (int i = 0; i < OBJECT_POOL_CAPACITY && count < MAX_ACTORS; i++) {
+        struct Object *o = &gObjectPool[i];
+        uint32_t flags = 0;
+        if (!mirrored(o, m, &flags)) {
+            continue;
+        }
+        struct ActorRecord r;
+        memset(&r, 0, sizeof(r));
+        r.formId = (uint32_t) i + 1;
+        r.flags = flags;
+        float radius = fmaxf(o->hitboxRadius, o->hurtboxRadius);
+        float height = fmaxf(o->hitboxHeight, o->hurtboxHeight);
+        float feet = o->oPosY - o->hitboxDownOffset;
+        if (is_wooden_post(o)) {
+            radius = 45.0f;
+            height = 160.0f;
+            feet = o->oPosY;
+        } else if (is_whomp(o)) {
+            float s = fmaxf(o->header.gfx.scale[0], 1.0f);  // (King Whomp is a Whomp twice the size)
+            radius = 120.0f * s;
+            height = 420.0f * s;
+            feet = o->oPosY;
+        }
+        r.x = (float) (originX + o->oPosX / UNITS_PER_BLOCK);
+        r.y = (float) sm64_to_mc_y(worldId, feet);
+        r.z = (float) (o->oPosZ / UNITS_PER_BLOCK);
+        r.yaw = -(float) o->oFaceAngleYaw * (360.0f / 65536.0f);
+        r.width = fmaxf(0.4f, radius * 2.0f / (float) UNITS_PER_BLOCK);
+        r.height = fmaxf(0.4f, height / (float) UNITS_PER_BLOCK);
+        r.healthFrac = 1.0f;
+        r.level = 1;
+        mc_enemy_name(o, r.name, sizeof(r.name));  // (Minecraft's name for its stand-in)
+        out[count++] = r;
+        if (sListedBehavior[r.formId] != o->behavior) {
+            sBossHits[i] = 0;  // (a new object in this slot: nothing carried over)
+            sMaceWait[i] = 0;
+        }
+        sListedBehavior[r.formId] = o->behavior;
+    }
+    *(volatile uint32_t *) (table + 4) = count;
+    MC_BARRIER();
+    *seq = (s | 1) + 1;  // even: done
+}
+
+// ---- hits from Minecraft --------------------------------------------------------------------
+
+static void burst(struct Object *o, bool crit) {
+    struct MarioState *m = &gMarioStates[0];
+    if (crit) {
+        // Minecraft's critical hit: a ring of little stars flying out of the enemy.
+        struct Object *spawner = spawn_object(o, MODEL_NONE, bhvHorStarParticleSpawner);
+        if (spawner != NULL) {
+            spawner->oPosY += fmaxf(o->hitboxHeight, 60.0f) * 0.5f + 20.0f;
+        }
+        // (Minecraft plays the hit sounds: the attack's own, and the enemy's hurt sound.)
+    } else {
+        // A normal hit: SM64's punch sparks, on the side Steve hit it from.
+        struct Object *spawner = spawn_object(o, MODEL_NONE, bhvTriangleParticleSpawner);
+        if (spawner != NULL) {
+            s16 toSteve = atan2s(m->pos[2] - o->oPosZ, m->pos[0] - o->oPosX);
+            spawner->oMoveAngleYaw = toSteve;
+            spawner->oFaceAngleYaw = toSteve;
+            spawner->oPosY += fmaxf(o->hitboxHeight, 60.0f) * 0.5f - 60.0f;
+        }
+    }
+}
+
+// An axe (or a critical hit) on a wooden post: Mario's ground pound on it.
+static void pound_post(struct Object *o) {
+    if (o->oWoodenPostMarioPounding) {
+        return;  // still going down from the last one
+    }
+    play_sound(SOUND_GENERAL_POUND_WOOD_POST, o->header.gfx.cameraToObject);
+    o->oWoodenPostSpeedY = -70.0f;
+    o->oWoodenPostMarioPounding = TRUE;
+}
+
+// Is Steve behind it (outside the 120 degrees in front of it)?
+static bool steve_behind(const struct Object *o) {
+    struct MarioState *m = &gMarioStates[0];
+    s16 toSteve = atan2s(m->pos[2] - o->oPosZ, m->pos[0] - o->oPosX);
+    s16 d = (s16) (toSteve - o->oFaceAngleYaw);
+    return d > 0x2AAA || d < -0x2AAA;
+}
+
+// Steve's hit on something Mario would pick up and throw: it's thrown the way Steve faces, as if
+// Mario had thrown it (it lands, breaks, explodes, King Bob-omb loses a life...). Ones that grab
+// Mario only from the front must be hit from behind, or with a critical hit.
+// Returns false (and says why on the status line) when it can't be thrown right now.
+// A boss holding Steve (King Bob-omb, Chuckya) hit hard (a mace, a critical hit): he lets go of
+// Steve the way SM64 lets Mario wriggle free (its own grab-escape counter), and is thrown as soon
+// as he can be, within a second and a half.
+static struct Object *sPendingThrow = NULL;
+static int sPendingFrames = 0;
+static bool sPendingMace = false;  // it was a mace: once he lets go, the mace's hit (boss_hit)
+static bool boss_hit(struct Object *o, bool full, int power);
+
+static bool holding_steve(const struct Object *o) {
+    return (is_behavior(o, id_bhvKingBobomb) && o->oAction == 3) || (is_behavior(o, id_bhvChuckya) && o->oAction == 1);
+}
+
+static bool throw_object(struct Object *o, bool crit);
+
+static void pending_throw_frame(void) {
+    if (sPendingThrow == NULL) {
+        return;
+    }
+    struct Object *o = sPendingThrow;
+    if (--sPendingFrames <= 0 || o->activeFlags == ACTIVE_FLAG_DEACTIVATED) {
+        sPendingThrow = NULL;
+        return;
+    }
+    if (holding_steve(o)) {
+        if (is_behavior(o, id_bhvKingBobomb)) {
+            o->oKingBobombUnkFC = 11;  // (act 3: more than 10 is "Mario wriggled free")
+        } else {
+            o->oChuckyaUnk100 = 11;
+        }
+        return;
+    }
+    if (sPendingMace) {
+        sPendingMace = false;
+        sPendingThrow = NULL;
+        boss_hit(o, true, 0);
+        return;
+    }
+    if (throw_object(o, true)) {
+        sPendingThrow = NULL;
+        snprintf(sLastHit, sizeof(sLastHit), "freed and THROWN %d", get_id_from_behavior(o->behavior));
+    }
+}
+
+static bool throw_object(struct Object *o, bool crit) {
+    struct MarioState *m = &gMarioStates[0];
+    bool bowser = is_behavior(o, id_bhvBowser);
+    if (crit && holding_steve(o)) {
+        sPendingThrow = o;
+        sPendingFrames = 45;
+        snprintf(sLastHit, sizeof(sLastHit), "let go of Steve");
+        return true;
+    }
+    if (o->oHeldState != HELD_FREE || !(o->oFlags & OBJ_FLAG_HOLDABLE)) {
+        return false;
+    }
+    if (bowser) {
+        // Not while he's flying, appearing, talking or beaten; not while he's vanished (BitFS).
+        s32 a = o->oAction;
+        if (a == 1 || a == 4 || a == 5 || a == 6 || a == 19 || a == 20 || o->oOpacity < 100) {
+            snprintf(sLastHit, sizeof(sLastHit), "Bowser: not now");
+            return false;
+        }
+    } else if (is_behavior(o, id_bhvKingBobomb)) {
+        if (o->oAction != 1 && o->oAction != 2) {
+            snprintf(sLastHit, sizeof(sLastHit), "King Bob-omb: not now");
+            return false;
+        }
+    } else if (is_behavior(o, id_bhvChuckya)) {
+        if (o->oAction != 0) {
+            return false;
+        }
+    }
+    bool grabsMario = bowser || (o->oInteractionSubtype & INT_SUBTYPE_GRABS_MARIO);
+    if (grabsMario && !crit && !steve_behind(o)) {
+        play_sound(SOUND_ACTION_BONK, o->header.gfx.cameraToObject);
+        snprintf(sLastHit, sizeof(sLastHit), "get behind it (or crit)");
+        return false;
+    }
+    o->parentObj = m->marioObj;
+    o->heldByPlayerIndex = 0;
+    o->oMoveAngleYaw = m->faceAngle[1];
+    if (bowser) {
+        // How hard Mario's spin would have flung him: a critical hit is a full-speed spin.
+        o->oBowserHeldAnglePitch = 0;
+        o->oBowserHeldAngleVelYaw = crit ? 0x1000 : 0xC00;
+    }
+    o->oHeldState = HELD_THROWN;
+    play_sound(SOUND_OBJ_UNKNOWN4, o->header.gfx.cameraToObject);  // a heave
+    return true;
+}
+
+// ---- the mace on bosses ------------------------------------------------------------------------
+// Mario beats each boss his own way (throw King Bob-omb, ground pound King Whomp's back, punch
+// Eyerok's eyes, jump on Wiggler...). A mace hit counts as that, from any side and at any moment
+// the boss could be hurt at all: one hit, one of the boss's lives, with SM64's own reaction (and a
+// second and a half before the next one counts, as SM64 gives Mario).
+#define MACE_BOSS_WAIT 45
+
+static void knock_back(struct Object *o, float forward, float up) {
+    struct MarioState *m = &gMarioStates[0];
+    o->oMoveAngleYaw = atan2s(o->oPosZ - m->pos[2], o->oPosX - m->pos[0]);
+    o->oForwardVel = forward;
+    o->oVelY = up;
+}
+
+// Other weapons (a sword, an axe, a fist) wear a boss down: this many hits for each of its lives
+// (a critical hit counts twice). Bowser isn't here: he's thrown into his bombs (throw_object).
+static int boss_hits_per_life(const struct Object *o) {
+    switch (get_id_from_behavior(o->behavior)) {
+        case id_bhvKingBobomb:          return 4;
+        case id_bhvWhompKingBoss:       return 4;
+        case id_bhvSmallWhomp:          return 3;
+        case id_bhvEyerokHand:          return 3;
+        case id_bhvWigglerHead:         return 3;
+        case id_bhvMrI:                 return 3;
+        case id_bhvBigBully:            return 6;
+        case id_bhvBigBullyWithMinions: return 6;
+        case id_bhvBigChillBully:       return 6;
+        default:                        return 0;  // not a boss
+    }
+}
+
+static int boss_damage_now(struct Object *o);
+
+// A boss hit by Steve. True if it was a boss (whatever came of the hit); false: hit it the normal
+// way. `full`: a mace, a life at once; otherwise `power` hits towards the next life.
+static bool boss_hit(struct Object *o, bool full, int power) {
+    int need = boss_hits_per_life(o);
+    if (need == 0) {
+        return false;
+    }
+    int slot = (int) (o - gObjectPool);
+    if (sMaceWait[slot] > 0) {
+        snprintf(sLastHit, sizeof(sLastHit), "boss: just hit");
+        return true;
+    }
+    if (!full) {
+        int hits = sBossHits[slot] + power;
+        sBossHits[slot] = (uint8_t) (hits > need ? need : hits);
+        if (hits < need) {
+            snprintf(sLastHit, sizeof(sLastHit), "boss %d/%d", hits, need);
+            return true;  // (Minecraft plays the hit; the life goes on the last one)
+        }
+    }
+    // SM64's helpers (sounds, particles) act on "the object being updated": this one, for now.
+    struct Object *was = gCurrentObject;
+    gCurrentObject = o;
+    int result = boss_damage_now(o);
+    gCurrentObject = was;
+    if (result == 1) {
+        sBossHits[slot] = 0;
+    }
+    return true;
+}
+
+// 1: the boss lost a life; 2: it can't be hurt right now.
+static int boss_damage_now(struct Object *o) {
+    int slot = (int) (o - gObjectPool);
+    bool kingBobomb = is_behavior(o, id_bhvKingBobomb);
+    bool whomp = is_behavior(o, id_bhvSmallWhomp), kingWhomp = is_behavior(o, id_bhvWhompKingBoss);
+    bool eyerok = is_behavior(o, id_bhvEyerokHand), wiggler = is_behavior(o, id_bhvWigglerHead);
+    bool mrI = is_behavior(o, id_bhvMrI);
+    bool bigBully = is_behavior(o, id_bhvBigBully) || is_behavior(o, id_bhvBigBullyWithMinions) || is_behavior(o, id_bhvBigChillBully);
+    bool hurt = false;
+    if (bigBully) {
+        s32 a = o->oAction;
+        if (a != BULLY_ACT_INACTIVE && a != BULLY_ACT_ACTIVATE_AND_FALL && a != BULLY_ACT_LAVA_DEATH && a != BULLY_ACT_DEATH_PLANE_DEATH) {
+            // Beaten: it melts away as if shoved into the lava, and leaves its star.
+            o->oBullyLastNetworkPlayerIndex = gNetworkPlayers[0].globalIndex;
+            o->oAction = BULLY_ACT_LAVA_DEATH;
+            hurt = true;
+        }
+    } else if (kingBobomb) {
+        // 0: hasn't started the fight; 4: being thrown; 7, 8: beaten.
+        s32 a = o->oAction;
+        if (a == 3) {
+            return false;  // holding Steve: let go first (throw_object's way)
+        }
+        if (a != 0 && a != 4 && a != 7 && a != 8 && o->oHealth > 0 && o->oHeldState == HELD_FREE) {
+            o->oHealth--;
+            cur_obj_play_sound_2(SOUND_OBJ_KING_BOBOMB);
+            knock_back(o, 25.0f, 45.0f);  // sent flying back, then gets up (or is beaten)
+            o->oAction = o->oHealth > 0 ? 6 : 7;
+            hurt = true;
+        }
+    } else if (kingWhomp) {
+        s32 a = o->oAction;
+        if (a != 0 && a != 8 && a != 9 && o->oHealth > 0) {
+            o->oHealth--;
+            cur_obj_play_sound_2(SOUND_OBJ2_WHOMP_SOUND_SHORT);
+            cur_obj_play_sound_2(SOUND_OBJ_KING_WHOMP_DEATH);
+            spawn_mist_particles_variable(0, 0, 100.0f);
+            spawn_triangle_break_particles(20, 138, 3.0f, 4);
+            if (o->oHealth == 0) {
+                o->oAction = 8;
+            }
+            hurt = true;
+        }
+    } else if (whomp) {
+        if (o->oAction != 8 && o->oAction != 9) {
+            o->oNumLootCoins = 5;
+            obj_spawn_loot_yellow_coins(o, 5, 20.0f);
+            o->oAction = 8;  // smashed, as by Mario's ground pound on its back
+            hurt = true;
+        }
+    } else if (eyerok) {
+        s32 a = o->oAction;
+        if (a >= EYEROK_HAND_ACT_IDLE && a <= EYEROK_HAND_ACT_DOUBLE_POUND && o->parentObj != NULL) {
+            // What a punch in the eye does (eyerok_hand_check_attacked).
+            cur_obj_play_sound_2(SOUND_OBJ2_EYEROK_SOUND_SHORT);
+            if (--o->oHealth >= 2) {
+                o->oAction = EYEROK_HAND_ACT_ATTACKED;
+                o->oVelY = 30.0f;
+            } else {
+                o->parentObj->oEyerokBossNumHands -= 1;
+                o->oAction = EYEROK_HAND_ACT_DIE;
+                o->oVelY = 50.0f;
+            }
+            o->oForwardVel *= 0.2f;
+            o->oMoveAngleYaw = o->oFaceAngleYaw + 0x8000;
+            o->oMoveFlags = 0;
+            o->oGravity = -4.0f;
+            o->oAnimState = 3;
+            hurt = true;
+        }
+    } else if (wiggler) {
+        if ((o->oAction == WIGGLER_ACT_WALK || o->oAction == WIGGLER_ACT_KNOCKBACK) && o->header.gfx.scale[0] != 1.0f) {
+            // As if jumped on (wiggler_jumped_on_attack_handler).
+            cur_obj_play_sound_2(SOUND_OBJ_WIGGLER_ATTACKED);
+            o->oAction = WIGGLER_ACT_JUMPED_ON;
+            o->oForwardVel = o->oVelY = 0.0f;
+            o->oWigglerSquishSpeed = 0.4f;
+            hurt = true;
+        }
+    } else if (mrI) {
+        if (o->oAction != 3) {
+            o->oAction = 3;  // spun around until he pops, as when Mario circles him
+            hurt = true;
+        }
+    }
+    if (hurt) {
+        sMaceWait[slot] = MACE_BOSS_WAIT;
+        if (o->oSyncID != 0) {
+            network_send_object(o);  // (everyone playing sees it)
+        }
+        snprintf(sLastHit, sizeof(sLastHit), "BOSS %d lost a life, %d left", get_id_from_behavior(o->behavior), o->oHealth);
+    } else {
+        play_sound(SOUND_ACTION_BONK, o->header.gfx.cameraToObject);
+        snprintf(sLastHit, sizeof(sLastHit), "boss: can't be hurt now");
+    }
+    return hurt ? 1 : 2;
+}
+
+static void hit_object(struct Object *o, float damage, float pushX, float pushZ, float push, uint32_t flags, uint32_t weapon) {
+    struct MarioState *m = &gMarioStates[0];
+    // A mace is the heaviest thing Steve swings: every hit lands like Mario's ground pound on any
+    // enemy (Goombas, Koopas, Bob-ombs, Bullies, Boos, bosses), and the bosses Mario has to grab from
+    // behind (King Bob-omb, Chuckya, Bowser) are flung from any side. Its smash attack (swung while
+    // falling) also knocks every enemy around back (Minecraft hits those with its knockback).
+    bool mace = weapon == WEAPON_MACE;
+    bool smash = mace && (flags & HIT_SMASH) != 0;
+    bool crit = (flags & HIT_CRITICAL) != 0 || mace;
+    (void) damage;
+    (void) pushX;
+    (void) pushZ;
+    flash(o);
+    if (smash) {
+        push = fmaxf(push, 2.0f);
+    }
+    // Bosses: a mace takes a life a hit; other weapons wear them down (boss_hit). One holding
+    // Steve lets go of him first (throw_object's way).
+    bool holding = holding_steve(o);
+    if (mace && holding) {
+        sPendingMace = true;
+    }
+    if (!holding && boss_hit(o, mace, (flags & HIT_CRITICAL) ? 2 : 1)) {
+        if (strncmp(sLastHit, "boss:", 5) != 0) {
+            burst(o, crit);
+            sHits++;
+            if (crit) {
+                sCrits++;
+            }
+        }
+        bool shove = (o->oInteractType & INTERACT_BULLY) && o->oAction != BULLY_ACT_LAVA_DEATH;
+        if (!shove) {
+            return;
+        }
+        // (a Big Bully is still shoved back by every hit, as Minecraft's knockback)
+        o->oMoveAngleYaw = atan2s(o->oPosZ - m->pos[2], o->oPosX - m->pos[0]);
+        o->oForwardVel = 3392.0f / fmaxf(o->hitboxRadius, 1.0f) * (crit ? 1.6f : 1.0f) * fmaxf(1.0f, push * 2.0f);
+        attack_object(m, o, INT_PUNCH);
+        return;
+    }
+    if (is_throwable(o)) {
+        if (throw_object(o, crit)) {
+            burst(o, crit);
+            sHits++;
+            if (crit) {
+                sCrits++;
+            }
+            snprintf(sLastHit, sizeof(sLastHit), "THROWN %d", get_id_from_behavior(o->behavior));
+        }
+        return;
+    }
+    if (is_wooden_post(o)) {
+        if (weapon == WEAPON_AXE || crit) {
+            pound_post(o);
+            snprintf(sLastHit, sizeof(sLastHit), "post %.0f", o->oWoodenPostOffsetY);
+        } else {
+            play_sound(SOUND_ACTION_BONK, o->header.gfx.cameraToObject);
+            snprintf(sLastHit, sizeof(sLastHit), "post: use an axe");
+        }
+        return;
+    }
+    if (o->oIntangibleTimer != 0) {
+        return;  // can't be hurt right now (just hit, or not ready)
+    }
+    u32 type = o->oInteractType;
+    u32 how = crit ? INT_GROUND_POUND : INT_PUNCH;
+    if (type & INTERACT_TEXT) {
+        snprintf(sLastHit, sizeof(sLastHit), "friendly: right-click to talk");
+        return;  // friends: nothing happens (right-click them to talk)
+    }
+    if (type & INTERACT_BULLY) {
+        // Shoved away from Steve, harder the harder he hits (Minecraft's knockback).
+        o->oMoveAngleYaw = atan2s(o->oPosZ - m->pos[2], o->oPosX - m->pos[0]);
+        o->oForwardVel = 3392.0f / fmaxf(o->hitboxRadius, 1.0f) * (crit ? 1.6f : 1.0f) * fmaxf(1.0f, push * 2.0f);
+        attack_object(m, o, INT_PUNCH);
+    } else if (type & INTERACT_GRABBABLE) {
+        if (!(o->oInteractionSubtype & INT_SUBTYPE_KICKABLE)) {
+            return;  // a boss to throw, not to hit
+        }
+        attack_object(m, o, INT_KICK);  // a Bob-omb: sent flying the way Steve looks
+    } else if (type & INTERACT_SPINY_WALKING) {
+        o->oInteractStatus = INT_STATUS_INTERACTED | INT_STATUS_WAS_ATTACKED | ATTACK_PUNCH;
+    } else if (type & (INTERACT_BOUNCE_TOP | INTERACT_BOUNCE_TOP2 | INTERACT_KOOPA | INTERACT_HIT_FROM_BELOW | INTERACT_BREAKABLE)) {
+        attack_object(m, o, how);
+    } else {
+        play_sound(SOUND_ACTION_BONK, o->header.gfx.cameraToObject);  // SM64 says Mario can't hurt this
+        snprintf(sLastHit, sizeof(sLastHit), "can't be hurt");
+        return;
+    }
+    burst(o, crit);
+    sHits++;
+    if (crit) {
+        sCrits++;
+    }
+    snprintf(sLastHit, sizeof(sLastHit), "%s %d", crit ? "CRIT" : "hit", get_id_from_behavior(o->behavior));
+}
+
+static void explosion(uint32_t worldId, float cx, float cy, float cz, float radius) {
+    struct MarioState *m = &gMarioStates[0];
+    double originX = mc_origin_x(worldId);
+    float x = (float) ((cx - originX) * UNITS_PER_BLOCK), y = (float) mc_to_sm64_y(worldId, cy), z = cz * (float) UNITS_PER_BLOCK;
+    float r = fmaxf(radius, 1.0f) * 1.5f * (float) UNITS_PER_BLOCK;
+    for (int i = 0; i < OBJECT_POOL_CAPACITY; i++) {
+        struct Object *o = &gObjectPool[i];
+        uint32_t flags = 0;
+        if (!mirrored(o, m, &flags) || is_wooden_post(o) || (is_throwable(o) && (o->oInteractionSubtype & INT_SUBTYPE_GRABS_MARIO))
+            || is_behavior(o, id_bhvBowser) || is_whomp(o)) {
+            continue;  // (bosses Mario has to throw aren't blown away by TNT)
+        }
+        float dx = o->oPosX - x, dy = o->oPosY - y, dz = o->oPosZ - z;
+        if (dx * dx + dy * dy + dz * dz > r * r) {
+            continue;
+        }
+        if ((o->oInteractType & INTERACT_GRABBABLE) && (o->oInteractionSubtype & INT_SUBTYPE_KICKABLE)) {
+            o->oInteractStatus = INT_STATUS_INTERACTED | INT_STATUS_TOUCHED_BOB_OMB;  // a Bob-omb goes off
+            continue;
+        }
+        hit_object(o, 20.0f, 0, 0, 1.0f, HIT_CRITICAL, 0);
+    }
+}
+
+void mc_actors_events(uint32_t worldId) {
+    if (gMcShm == NULL) {
+        return;
+    }
+    uint8_t *ring = gMcShm + OFF_EVENT_RING;
+    volatile uint64_t *head = (volatile uint64_t *) ring;
+    volatile uint64_t *tail = (volatile uint64_t *) (ring + 0x40);
+    uint64_t h = *head;
+    MC_BARRIER();
+    uint64_t t = *tail;
+    if (h - t > EVENT_ENTRIES) {
+        t = h - EVENT_ENTRIES;  // fell far behind: skip what was overwritten
+    }
+    for (; t < h; t++) {
+        const uint8_t *e = ring + 0x80 + (t % EVENT_ENTRIES) * EVENT_BYTES;
+        uint32_t type, formId, flags, weapon;
+        float a, b, c, d;
+        memcpy(&type, e, 4);
+        memcpy(&formId, e + 4, 4);
+        memcpy(&a, e + 8, 4);
+        memcpy(&b, e + 12, 4);
+        memcpy(&c, e + 16, 4);
+        memcpy(&d, e + 20, 4);
+        memcpy(&flags, e + 24, 4);
+        memcpy(&weapon, e + 28, 4);
+        if (type == EV_HIT_ACTOR) {
+            struct Object *o = object_for(formId);
+            if (o != NULL) {
+                hit_object(o, a, b, c, d, flags, weapon);
+            }
+        } else if (type == EV_EXPLOSION) {
+            explosion(worldId, a, b, c, d);
+        } else if (type == EV_PLAYER_DIED) {
+            sSteveDied = true;
+        }
+    }
+    MC_BARRIER();
+    *tail = t;
+    pending_throw_frame();
+    for (int i = 0; i < OBJECT_POOL_CAPACITY; i++) {
+        if (sFlash[i] > 0) {
+            sFlash[i]--;
+        }
+        if (sMaceWait[i] > 0) {
+            sMaceWait[i]--;
+        }
+    }
+}
+
+bool mc_actors_take_steve_died(void) {
+    bool died = sSteveDied;
+    sSteveDied = false;
+    return died;
+}
+
+int mc_actors_status(char *out, int size) {
+    return snprintf(out, (size_t) size, "   hits %d crits %d %s", sHits, sCrits, sLastHit);
+}
diff --git a/src/pc/mariocraft/mc_collision.c b/src/pc/mariocraft/mc_collision.c
new file mode 100644
index 000000000..16131aada
--- /dev/null
+++ b/src/pc/mariocraft/mc_collision.c
@@ -0,0 +1,866 @@
+// MarioCraft: sends the shape of Mario's level to Minecraft.
+//
+// Minecraft needs to know where SM64's ground and walls are so that its blocks, items and mobs
+// rest on them, and so you can place blocks against them. SkyCraft's Minecraft mod already
+// knows how to take a world's shape (SkyCollision.java); this file is the SM64 version of what
+// SkyCraft's Skyrim plugin does in skse/src/Collision.cpp:
+//
+//   1. take every static collision triangle of the current area,
+//   2. sort them into 8x8x8-block regions,
+//   3. per region, send the exact triangles (COL_TRIS) and an 1/8-block voxel version of them
+//      (COL_REGION: one 8x8x8 bit mask per block), through the collision ring.
+//
+// The voxeliser is a port of Collision::Voxelize (Akenine-Moller triangle/box overlap test).
+
+#include "mariocraft_internal.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#include <windows.h>
+#define MC_BARRIER() MemoryBarrier()
+#else
+#define MC_BARRIER() __sync_synchronize()
+#endif
+
+#include "sm64.h"
+#include "game/memory.h"
+#include "engine/surface_load.h"
+#include "surface_terrains.h"
+#include "game/area.h"
+
+#define G (MC_REGION_SIZE * 8)  // voxels per region edge (64)
+
+// Surfaces steeper than this (|normal.y| below kSteepMax) become whole-block cliffs in
+// Minecraft, so mobs can't stroll up walls one 1/8 step at a time. Same numbers as SkyCraft.
+static const float kSteepMin = 0.1f;
+static const float kSteepMax = 0.643f;
+
+#pragma pack(push, 1)
+struct ColMsgHeader { uint32_t type, payloadBytes; };
+struct ColRegion { int32_t minX, minY, minZ, maxX, maxY, maxZ; uint32_t epoch, count; };
+struct ColTri { float v[9]; uint32_t flags; };
+struct ColBlock { int32_t x, y, z; uint32_t pad; uint64_t bits[8]; };
+#pragma pack(pop)
+
+_Static_assert(sizeof(struct ColRegion) == 32, "ColRegion layout");
+_Static_assert(sizeof(struct ColTri) == 40, "ColTri layout");
+_Static_assert(sizeof(struct ColBlock) == 80, "ColBlock layout");
+
+// ---- outgoing message queue --------------------------------------------------------------
+
+struct QueuedMsg {
+    uint32_t type;
+    uint32_t bytes;
+    uint8_t *data;
+};
+
+static struct QueuedMsg *sQueue = NULL;
+static size_t sQueueCount = 0, sQueueCap = 0, sQueueNext = 0;
+
+static void queue_clear(void) {
+    for (size_t i = 0; i < sQueueCount; i++) {
+        free(sQueue[i].data);
+    }
+    sQueueCount = 0;
+    sQueueNext = 0;
+}
+
+static void queue_push(uint32_t type, const void *a, uint32_t aBytes, const void *b, uint32_t bBytes) {
+    if (sQueueCount == sQueueCap) {
+        size_t cap = sQueueCap ? sQueueCap * 2 : 256;
+        struct QueuedMsg *grown = realloc(sQueue, cap * sizeof(*sQueue));
+        if (grown == NULL) {
+            return;
+        }
+        sQueue = grown;
+        sQueueCap = cap;
+    }
+    uint8_t *data = malloc((size_t) aBytes + bBytes + 1);
+    if (data == NULL) {
+        return;
+    }
+    if (aBytes) { memcpy(data, a, aBytes); }
+    if (bBytes) { memcpy(data + aBytes, b, bBytes); }
+    sQueue[sQueueCount].type = type;
+    sQueue[sQueueCount].bytes = aBytes + bBytes;
+    sQueue[sQueueCount].data = data;
+    sQueueCount++;
+}
+
+// Writes one message into the ring. False if Minecraft hasn't made room for it yet.
+static bool ring_write(uint32_t type, const uint8_t *payload, uint32_t bytes) {
+    uint8_t *ring = gMcShm + OFF_COLLISION_RING;
+    volatile uint64_t *head = (volatile uint64_t *) (ring + CR_HEAD);
+    volatile uint64_t *tail = (volatile uint64_t *) (ring + CR_TAIL);
+    uint8_t *data = ring + CR_DATA;
+
+    uint64_t msg = ((uint64_t) 8 + bytes + 7) & ~7ull;
+    if (msg > CR_DATA_BYTES / 2) {
+        return true;  // can never fit; drop it rather than block forever
+    }
+    uint64_t h = *head;
+    uint64_t pos = h % CR_DATA_BYTES;
+    uint64_t skip = (pos + msg > CR_DATA_BYTES) ? CR_DATA_BYTES - pos : 0;
+    if (h + skip + msg - *tail > CR_DATA_BYTES) {
+        return false;  // ring full: Minecraft is behind (or not running yet)
+    }
+    if (skip) {
+        // Not enough room before the end: a pad message sends the reader back to the start.
+        struct ColMsgHeader pad = { COL_PAD, 0 };
+        memcpy(data + pos, &pad, sizeof(pad));
+        h += skip;
+        pos = 0;
+    }
+    struct ColMsgHeader hdr = { type, bytes };
+    memcpy(data + pos, &hdr, sizeof(hdr));
+    if (bytes) {
+        memcpy(data + pos + 8, payload, bytes);
+    }
+    MC_BARRIER();
+    *head = h + msg;
+    return true;
+}
+
+void mc_collision_pump(void) {
+    if (gMcShm == NULL) {
+        return;
+    }
+    while (sQueueNext < sQueueCount) {
+        struct QueuedMsg *m = &sQueue[sQueueNext];
+        if (!ring_write(m->type, m->data, m->bytes)) {
+            return;  // try again next frame
+        }
+        free(m->data);
+        m->data = NULL;
+        sQueueNext++;
+    }
+    if (sQueueCount > 0) {
+        queue_clear();
+    }
+}
+
+void mc_collision_reset(void) {
+    queue_clear();
+}
+
+// ---- triangle / box overlap (Akenine-Moller SAT), voxel units ------------------------------
+
+static inline void v_sub(const float *a, const float *b, float *o) { o[0] = a[0] - b[0]; o[1] = a[1] - b[1]; o[2] = a[2] - b[2]; }
+static inline void v_cross(const float *a, const float *b, float *o) {
+    o[0] = a[1] * b[2] - a[2] * b[1];
+    o[1] = a[2] * b[0] - a[0] * b[2];
+    o[2] = a[0] * b[1] - a[1] * b[0];
+}
+static inline float v_dot(const float *a, const float *b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; }
+static inline float min3(float a, float b, float c) { return fminf(a, fminf(b, c)); }
+static inline float max3(float a, float b, float c) { return fmaxf(a, fmaxf(b, c)); }
+
+static bool axis_test(const float *v0, const float *v1, const float *v2, const float *axis, float h) {
+    float p0 = v_dot(v0, axis), p1 = v_dot(v1, axis), p2 = v_dot(v2, axis);
+    float mn = min3(p0, p1, p2), mx = max3(p0, p1, p2);
+    float r = h * (fabsf(axis[0]) + fabsf(axis[1]) + fabsf(axis[2]));
+    return !(mn > r || mx < -r);
+}
+
+// Box centred at c with half-size h. Triangle a/b/c with unit normal n.
+static bool tri_box_overlap(const float *c, float h, const float *ta, const float *tb, const float *tc, const float *n) {
+    float v0[3], v1[3], v2[3];
+    v_sub(ta, c, v0);
+    v_sub(tb, c, v1);
+    v_sub(tc, c, v2);
+    for (int i = 0; i < 3; i++) {
+        if (min3(v0[i], v1[i], v2[i]) > h || max3(v0[i], v1[i], v2[i]) < -h) {
+            return false;
+        }
+    }
+    float d = v_dot(n, v0);
+    float r = h * (fabsf(n[0]) + fabsf(n[1]) + fabsf(n[2]));
+    if (fabsf(d) > r) {
+        return false;
+    }
+    float e[3][3];
+    v_sub(v1, v0, e[0]);
+    v_sub(v2, v1, e[1]);
+    v_sub(v0, v2, e[2]);
+    static const float kAxes[3][3] = { { 1, 0, 0 }, { 0, 1, 0 }, { 0, 0, 1 } };
+    for (int i = 0; i < 3; i++) {
+        for (int j = 0; j < 3; j++) {
+            float axis[3];
+            v_cross(e[i], kAxes[j], axis);
+            if (!axis_test(v0, v1, v2, axis, h)) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+// ---- export -------------------------------------------------------------------------------
+
+// ColTri flags (protocol): diggable surfaces (bits 8-15: the material they dig into), and the
+// "ghost" of a surface as it was before holes were dug out of it.
+#define TRI_DIGGABLE      (1u << 1)
+#define TRI_GHOST         (1u << 2)
+#define TRI_WALKABLE      (1u << 4)  // MarioCraft: Steve walks up it, however steep (Proto.TRI_WALKABLE)
+#define TRI_MATERIAL_SHIFT 8
+enum { DIG_GRASS = 1, DIG_DIRT = 2, DIG_STONE = 3, DIG_COBBLE = 4, DIG_SNOW = 5, DIG_ICE = 6, DIG_SAND = 7, DIG_PLANKS = 13,
+       DIG_BRICKS = 22, DIG_RED_WOOL = 23 };
+
+static char sMaterialSummary[160];
+const char *mc_collision_material_summary(void) { return sMaterialSummary; }
+
+// One SM64 triangle in Minecraft block coordinates, relative to the area's origin (small numbers,
+// so float precision stays fine; the origin is added back when sending).
+struct LocalTri {
+    float v[9];
+    uint32_t flags;
+};
+
+static inline int floor_div(int a, int b) { return (a >= 0) ? a / b : -((-a + b - 1) / b); }
+
+static bool skip_surface(const struct Surface *s);
+bool mc_surface_skipped(const struct Surface *s) { return skip_surface(s); }
+
+static bool skip_surface(const struct Surface *s) {
+    if (s->flags & SURFACE_FLAG_INTANGIBLE) {
+        return true;
+    }
+    switch (s->type) {
+        case SURFACE_INTANGIBLE:
+        case SURFACE_CAMERA_BOUNDARY:
+        case SURFACE_DEATH_PLANE:
+        case SURFACE_VANISH_CAP_WALLS:
+            return true;
+        default:
+            return false;
+    }
+}
+
+// What a piece of Mario's level is made of, as the Minecraft block it digs into: from the level's
+// terrain type (the one SM64 picks footstep sounds by) and whether it's ground or wall.
+// What a surface digs into. `seen`: the material judged from what's drawn there (mc_material.c),
+// 0 if unknown; SM64's own surface and terrain types decide otherwise.
+static uint32_t surface_flags(const struct Surface *s, u16 terrainType, int seen) {
+    if (s->type == SURFACE_BURNING || (s->type >= SURFACE_PAINTING_WOBBLE_A6 && s->type <= SURFACE_PAINTING_WARP_FC)) {
+        return 0;  // lava and paintings stay as they are
+    }
+    if (s->type == SURFACE_DEATH_PLANE || s->type == SURFACE_VERTICAL_WIND
+        || (s->type >= SURFACE_INSTANT_WARP_1B && s->type <= SURFACE_INSTANT_WARP_1E)
+        || s->type == SURFACE_WARP) {
+        return 0;  // the level's own floor-of-death and warps
+    }
+    bool ground = s->normal.y > 0.5f;
+    int mat;
+    if (seen > 0 && !(s->type == SURFACE_VERY_SLIPPERY || s->type == SURFACE_ICE)) {
+        mat = seen;
+    } else if (s->type == SURFACE_VERY_SLIPPERY || s->type == SURFACE_ICE) {
+        mat = DIG_ICE;
+    } else if (s->type == SURFACE_HARD || s->type == SURFACE_HARD_SLIPPERY || s->type == SURFACE_HARD_VERY_SLIPPERY
+               || s->type == SURFACE_HARD_NOT_SLIPPERY) {
+        mat = DIG_STONE;
+    } else {
+        switch (terrainType & TERRAIN_MASK) {
+            case TERRAIN_GRASS:  mat = ground ? DIG_GRASS : DIG_DIRT; break;
+            case TERRAIN_SNOW:   mat = ground ? DIG_SNOW : DIG_STONE; break;
+            case TERRAIN_SAND:   mat = DIG_SAND; break;
+            case TERRAIN_SPOOKY: mat = DIG_PLANKS; break;
+            case TERRAIN_SLIDE:  mat = ground ? DIG_SNOW : DIG_ICE; break;
+            case TERRAIN_STONE:
+            case TERRAIN_WATER:
+            default:             mat = DIG_STONE; break;
+        }
+    }
+    return TRI_DIGGABLE | ((uint32_t) mat << TRI_MATERIAL_SHIFT);
+}
+
+// SM64's staircases are steep ramps that Mario walks straight up: they're "not slippery". Minecraft
+// only walks up slopes of up to 45 degrees, so Steve had to jump up every step of them. Floors
+// SM64 lets Mario walk up without sliding are walkable for Steve too (up to about 63 degrees;
+// steeper than that is a wall whatever SM64 calls it).
+static bool walkable_for_mario(const struct Surface *s, u16 terrainType) {
+    if (s->normal.y < 0.45f) {
+        return false;
+    }
+    switch (s->type) {
+        case SURFACE_NOT_SLIPPERY:
+        case SURFACE_HARD_NOT_SLIPPERY:
+        case SURFACE_SWITCH:
+            return true;
+        case SURFACE_DEFAULT:
+        case SURFACE_HARD:
+            // Ordinary ground: Mario runs up it (and only slides down once he stops) up to here.
+            return s->normal.y >= 0.5f && (terrainType & TERRAIN_MASK) != TERRAIN_SLIDE;
+        default:
+            return false;
+    }
+}
+
+bool mc_surface_walkable(const struct Surface *s, uint16_t terrainType) { return walkable_for_mario(s, terrainType); }
+
+// ---- lining Minecraft's block grid up with the floor (see mariocraft_internal.h) -----------
+#define ORIGIN_Y_SLOTS 4096
+static int8_t sOriginYUnits[ORIGIN_Y_SLOTS];
+static bool sOriginYKnown[ORIGIN_Y_SLOTS];
+
+int mc_origin_y_units(uint32_t worldId) {
+    return (worldId < ORIGIN_Y_SLOTS && sOriginYKnown[worldId]) ? sOriginYUnits[worldId] : 0;
+}
+
+// The height (mod 100) with the most flat floor in the area, by area. Called when SM64 has just
+// loaded the area (its static collision is the area's own). Never changes once worked out, so
+// that what Minecraft already has there (placed blocks, holes) stays put.
+void mc_origin_y_compute(uint32_t worldId) {
+    if (worldId >= ORIGIN_Y_SLOTS || sOriginYKnown[worldId]) {
+        return;
+    }
+    struct GrowingArray *pool = surface_get_static_pool();
+    if (pool == NULL || pool->count == 0) {
+        return;
+    }
+    static double weight[100];
+    memset(weight, 0, sizeof(weight));
+    growing_array_for_each_(pool, struct Surface, s) {
+        if (s == NULL || skip_surface(s) || s->normal.y < 0.99f) {
+            continue;
+        }
+        if (s->type == SURFACE_BURNING || s->type == SURFACE_WARP
+            || (s->type >= SURFACE_INSTANT_WARP_1B && s->type <= SURFACE_INSTANT_WARP_1E)) {
+            continue;  // lava and warp floors: nobody builds there
+        }
+        double ax = s->vertex2[0] - s->vertex1[0], az = s->vertex2[2] - s->vertex1[2];
+        double bx = s->vertex3[0] - s->vertex1[0], bz = s->vertex3[2] - s->vertex1[2];
+        double area = fabs(ax * bz - az * bx) * 0.5;
+        int y = (int) lround((s->vertex1[1] + s->vertex2[1] + s->vertex3[1]) / 3.0);
+        weight[((y % 100) + 100) % 100] += area;
+    }
+    int best = 0;
+    for (int b = 1; b < 100; b++) {
+        if (weight[b] > weight[best]) {
+            best = b;
+        }
+    }
+    sOriginYUnits[worldId] = (int8_t) best;
+    sOriginYKnown[worldId] = true;
+    printf("[MarioCraft] area %u: block grid lined up with floors at height %d (mod 100)\n", (unsigned) worldId, best);
+}
+
+static uint64_t sSolid[G * G];
+static uint64_t sSteep[G * G];
+
+// ---- the area's triangles, kept after export so regions can be sent again (holes dug) ------
+static struct LocalTri *sTris = NULL;
+static int sNumTris = 0;
+static int sRmin[3], sNx = 0, sNy = 0, sNz = 0;
+static int *sCellCount = NULL, **sCellTris = NULL, *sCellCap = NULL;
+static double sOriginX = 0;
+static uint32_t sEpoch = 0;
+static bool sHaveArea = false;
+
+static void forget_area(void) {
+    if (sCellTris != NULL) {
+        for (size_t c = 0; c < (size_t) sNx * sNy * sNz; c++) {
+            free(sCellTris[c]);
+        }
+    }
+    free(sCellTris); free(sCellCount); free(sCellCap); free(sTris);
+    sCellTris = NULL; sCellCount = NULL; sCellCap = NULL; sTris = NULL;
+    sNumTris = 0;
+    sNx = sNy = sNz = 0;
+    sHaveArea = false;
+}
+
+// ---- cutting dug holes out of triangles (like SkyCraft's Clip::Subtract) -------------------
+#define MAX_POLY 24
+#define MAX_PIECES 128
+struct Poly {
+    int n;
+    float p[MAX_POLY][3];
+};
+
+// Splits poly by the plane p[axis] = d: `outside` gets the part where sign * (p - d) > 0.
+static void split_poly(const struct Poly *in, int axis, float d, float sign, struct Poly *outside, struct Poly *inside) {
+    outside->n = inside->n = 0;
+    for (int i = 0; i < in->n; i++) {
+        const float *a = in->p[i], *b = in->p[(i + 1) % in->n];
+        float da = sign * (a[axis] - d), db = sign * (b[axis] - d);
+        if (da > 0) { if (outside->n < MAX_POLY) memcpy(outside->p[outside->n++], a, 12); }
+        else        { if (inside->n < MAX_POLY) memcpy(inside->p[inside->n++], a, 12); }
+        if ((da > 0) != (db > 0)) {
+            float t = da / (da - db), q[3];
+            for (int k = 0; k < 3; k++) q[k] = a[k] + (b[k] - a[k]) * t;
+            if (outside->n < MAX_POLY) memcpy(outside->p[outside->n++], q, 12);
+            if (inside->n < MAX_POLY) memcpy(inside->p[inside->n++], q, 12);
+        }
+    }
+}
+
+// pieces <- pieces minus the box [lo, hi]
+static int subtract_box(struct Poly *pieces, int count, const float *lo, const float *hi) {
+    static struct Poly next[MAX_PIECES];
+    int out = 0;
+    for (int i = 0; i < count; i++) {
+        struct Poly cur = pieces[i];
+        bool overlaps = true;
+        for (int k = 0; k < 3 && overlaps; k++) {
+            float mn = cur.p[0][k], mx = cur.p[0][k];
+            for (int j = 1; j < cur.n; j++) { mn = fminf(mn, cur.p[j][k]); mx = fmaxf(mx, cur.p[j][k]); }
+            overlaps = mx > lo[k] && mn < hi[k];
+        }
+        if (!overlaps) {
+            if (out < MAX_PIECES) next[out++] = cur;
+            continue;
+        }
+        for (int face = 0; face < 6 && cur.n >= 3; face++) {
+            int axis = face / 2;
+            struct Poly outside, inside;
+            if (face & 1) split_poly(&cur, axis, hi[axis], 1.0f, &outside, &inside);
+            else          split_poly(&cur, axis, lo[axis], -1.0f, &outside, &inside);
+            if (outside.n >= 3 && out < MAX_PIECES) next[out++] = outside;
+            cur = inside;
+        }
+        // what's left is inside the box: dug away
+    }
+    memcpy(pieces, next, sizeof(struct Poly) * (size_t) out);
+    return out;
+}
+
+// A small step into a triangle's solid side (against its normal; SM64 surfaces face out).
+static void tri_back(const float *v, float dist, float *out) {
+    float e1[3] = { v[3] - v[0], v[4] - v[1], v[5] - v[2] };
+    float e2[3] = { v[6] - v[0], v[7] - v[1], v[8] - v[2] };
+    float n[3] = { e1[1] * e2[2] - e1[2] * e2[1], e1[2] * e2[0] - e1[0] * e2[2], e1[0] * e2[1] - e1[1] * e2[0] };
+    float len = sqrtf(n[0] * n[0] + n[1] * n[1] + n[2] * n[2]);
+    for (int k = 0; k < 3; k++) {
+        out[k] = len > 1e-12f ? -n[k] / len * dist : 0.0f;
+    }
+}
+
+// Dug cells (Minecraft blocks, absolute) overlapping a box in local block coordinates.
+static int dug_cells_near(const float *lo, const float *hi, int (*cells)[3], int max) {
+    int x0 = (int) floorf(lo[0]), x1 = (int) floorf(hi[0]);
+    int y0 = (int) floorf(lo[1]), y1 = (int) floorf(hi[1]);
+    int z0 = (int) floorf(lo[2]), z1 = (int) floorf(hi[2]);
+    int base = (int) sOriginX, n = 0;
+    if ((int64_t) (x1 - x0 + 1) * (y1 - y0 + 1) * (z1 - z0 + 1) > 20000) {
+        return 0;  // a huge triangle: only look where holes exist (see mc_dig_cells_in_box)
+    }
+    for (int y = y0; y <= y1; y++) {
+        for (int z = z0; z <= z1; z++) {
+            for (int x = x0; x <= x1; x++) {
+                if (mc_dig_is_dug(base + x, y, z) && n < max) {
+                    cells[n][0] = x; cells[n][1] = y; cells[n][2] = z;
+                    n++;
+                }
+            }
+        }
+    }
+    return n;
+}
+
+static void voxelize_region(const struct LocalTri *tris, const int *idx, int n, int rx, int ry, int rz,
+                            double originX, uint32_t epoch, int *outBlocks) {
+    memset(sSolid, 0, sizeof(sSolid));
+    memset(sSteep, 0, sizeof(sSteep));
+    const float ox = (float) (rx * MC_REGION_SIZE), oy = (float) (ry * MC_REGION_SIZE), oz = (float) (rz * MC_REGION_SIZE);
+
+    for (int t = 0; t < n; t++) {
+        const float *tv = tris[idx[t]].v;
+        float a[3], b[3], c[3];
+        // SM64 coordinates are whole numbers, so surfaces often sit exactly on a voxel boundary.
+        // Nudge each surface a hair into its solid side (behind it) so it lands in one voxel, the
+        // one inside the ground or wall, not in zero or two of them.
+        float back[3];
+        tri_back(tv, 0.001f, back);
+        for (int k = 0; k < 3; k++) {
+            a[k] = (tv[k] - (k == 0 ? ox : k == 1 ? oy : oz)) * 8.0f + back[k];
+            b[k] = (tv[3 + k] - (k == 0 ? ox : k == 1 ? oy : oz)) * 8.0f + back[k];
+            c[k] = (tv[6 + k] - (k == 0 ? ox : k == 1 ? oy : oz)) * 8.0f + back[k];
+        }
+        float lo[3], hi[3];
+        for (int i = 0; i < 3; i++) {
+            lo[i] = min3(a[i], b[i], c[i]);
+            hi[i] = max3(a[i], b[i], c[i]);
+        }
+        if (hi[0] < 0 || hi[1] < 0 || hi[2] < 0 || lo[0] > G || lo[1] > G || lo[2] > G) {
+            continue;
+        }
+        float e1[3], e2[3], nrm[3];
+        v_sub(b, a, e1);
+        v_sub(c, a, e2);
+        v_cross(e1, e2, nrm);
+        float len = sqrtf(v_dot(nrm, nrm));
+        if (len < 1e-9f) {
+            continue;
+        }
+        nrm[0] /= len; nrm[1] /= len; nrm[2] /= len;
+        float ny = fabsf(nrm[1]);
+        bool flat = ny >= kSteepMax || ny < kSteepMin;
+        uint64_t *grid = flat ? sSolid : sSteep;
+
+        int dom = 0;
+        if (fabsf(nrm[1]) > fabsf(nrm[dom])) dom = 1;
+        if (fabsf(nrm[2]) > fabsf(nrm[dom])) dom = 2;
+        int u = (dom + 1) % 3, v = (dom + 2) % 3;
+        float d = v_dot(nrm, a);
+        float r = 0.5f * (fabsf(nrm[0]) + fabsf(nrm[1]) + fabsf(nrm[2]));
+#define CLAMP_LO(f) (int) fminf(fmaxf(floorf(f), 0.0f), (float) (G - 1))
+#define CLAMP_HI(f) (int) fminf(fmaxf(ceilf(f) - 1.0f, 0.0f), (float) (G - 1))
+        int iu0 = CLAMP_LO(lo[u]), iu1 = CLAMP_HI(hi[u]), iv0 = CLAMP_LO(lo[v]), iv1 = CLAMP_HI(hi[v]);
+        int id0 = CLAMP_LO(lo[dom] - 0.5f), id1 = CLAMP_HI(hi[dom] + 0.5f);
+        for (int iu = iu0; iu <= iu1; iu++) {
+            for (int iv = iv0; iv <= iv1; iv++) {
+                float cu = iu + 0.5f, cv = iv + 0.5f;
+                float s0 = (d - r - nrm[u] * cu - nrm[v] * cv) / nrm[dom];
+                float s1 = (d + r - nrm[u] * cu - nrm[v] * cv) / nrm[dom];
+                int a0 = (int) floorf(fminf(s0, s1) - 0.5f);
+                int a1 = (int) ceilf(fmaxf(s0, s1) - 0.5f);
+                if (a0 < id0) a0 = id0;
+                if (a1 > id1) a1 = id1;
+                for (int id = a0; id <= a1; id++) {
+                    float cen[3];
+                    cen[dom] = id + 0.5f;
+                    cen[u] = cu;
+                    cen[v] = cv;
+                    if (tri_box_overlap(cen, 0.5f, a, b, c, nrm)) {
+                        int p[3];
+                        p[dom] = id; p[u] = iu; p[v] = iv;
+                        grid[p[1] * G + p[2]] |= 1ull << p[0];
+                    }
+                }
+            }
+        }
+#undef CLAMP_LO
+#undef CLAMP_HI
+    }
+
+    // Steep surfaces: fill each block column between their lowest and highest voxel, so the
+    // steps between neighbouring blocks are taller than Minecraft's 0.6-block step-up.
+    for (int by = 0; by < MC_REGION_SIZE; by++) {
+        for (int bz = 0; bz < MC_REGION_SIZE; bz++) {
+            for (int bx = 0; bx < MC_REGION_SIZE; bx++) {
+                uint64_t xmask = 0xFFull << (bx * 8);
+                int minY = 99, maxY = -1;
+                for (int y = by * 8; y < by * 8 + 8; y++) {
+                    for (int z = bz * 8; z < bz * 8 + 8; z++) {
+                        if (sSteep[y * G + z] & xmask) {
+                            if (y < minY) minY = y;
+                            if (y > maxY) maxY = y;
+                        }
+                    }
+                }
+                for (int y = minY; y <= maxY; y++) {
+                    for (int z = bz * 8; z < bz * 8 + 8; z++) {
+                        sSolid[y * G + z] |= xmask;
+                    }
+                }
+            }
+        }
+    }
+
+    // Dug blocks: the ground in them is gone.
+    int baseX = (int) originX;  // originX is a whole number of blocks
+    if (mc_dig_any()) {
+        for (int by = 0; by < MC_REGION_SIZE; by++) {
+            for (int bz = 0; bz < MC_REGION_SIZE; bz++) {
+                for (int bx = 0; bx < MC_REGION_SIZE; bx++) {
+                    if (!mc_dig_is_dug(baseX + rx * MC_REGION_SIZE + bx, ry * MC_REGION_SIZE + by, rz * MC_REGION_SIZE + bz)) {
+                        continue;
+                    }
+                    uint64_t keep = ~(0xFFull << (bx * 8));
+                    for (int y = by * 8; y < by * 8 + 8; y++) {
+                        for (int z = bz * 8; z < bz * 8 + 8; z++) {
+                            sSolid[y * G + z] &= keep;
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    // Pack each non-empty block: bits[y] bit (z * 8 + x).
+    static struct ColBlock blocks[MC_REGION_SIZE * MC_REGION_SIZE * MC_REGION_SIZE];
+    int count = 0;
+    for (int by = 0; by < MC_REGION_SIZE; by++) {
+        for (int bz = 0; bz < MC_REGION_SIZE; bz++) {
+            for (int bx = 0; bx < MC_REGION_SIZE; bx++) {
+                struct ColBlock blk;
+                memset(&blk, 0, sizeof(blk));
+                bool any = false;
+                for (int sy = 0; sy < 8; sy++) {
+                    uint64_t layer = 0;
+                    for (int sz = 0; sz < 8; sz++) {
+                        uint64_t row = (sSolid[(by * 8 + sy) * G + (bz * 8 + sz)] >> (bx * 8)) & 0xFF;
+                        layer |= row << (sz * 8);
+                    }
+                    blk.bits[sy] = layer;
+                    any |= layer != 0;
+                }
+                if (any) {
+                    blk.x = baseX + rx * MC_REGION_SIZE + bx;
+                    blk.y = ry * MC_REGION_SIZE + by;
+                    blk.z = rz * MC_REGION_SIZE + bz;
+                    blocks[count++] = blk;
+                }
+            }
+        }
+    }
+
+    struct ColRegion hdr;
+    hdr.minX = baseX + rx * MC_REGION_SIZE;
+    hdr.minY = ry * MC_REGION_SIZE;
+    hdr.minZ = rz * MC_REGION_SIZE;
+    hdr.maxX = hdr.minX + MC_REGION_SIZE - 1;
+    hdr.maxY = hdr.minY + MC_REGION_SIZE - 1;
+    hdr.maxZ = hdr.minZ + MC_REGION_SIZE - 1;
+    hdr.epoch = epoch;
+
+    // Exact triangles first (Minecraft expects them before the region's voxels). Where holes
+    // were dug, the surface as it was goes as a "ghost" (what's behind it is solid ground), and
+    // the surface itself with the holes cut out.
+    int cap = n * 2 + 16, numOut = 0;
+    struct ColTri *out = malloc(sizeof(struct ColTri) * (size_t) cap);
+    static struct Poly pieces[MAX_PIECES];
+    static int cells[512][3];
+    if (out != NULL) {
+        for (int t = 0; t < n; t++) {
+            const struct LocalTri *lt = &tris[idx[t]];
+            int numCells = 0;
+            // A surface belongs to the blocks just behind it (inside the ground or wall): one
+            // lying exactly on a block boundary is cut when the block behind it is dug.
+            float back[3];
+            tri_back(lt->v, 0.002f, back);
+            if ((lt->flags & TRI_DIGGABLE) && mc_dig_any()) {
+                float lo[3], hi[3];
+                for (int k = 0; k < 3; k++) {
+                    lo[k] = min3(lt->v[k], lt->v[3 + k], lt->v[6 + k]) - 0.01f;
+                    hi[k] = max3(lt->v[k], lt->v[3 + k], lt->v[6 + k]) + 0.01f;
+                }
+                numCells = dug_cells_near(lo, hi, cells, 512);
+            }
+            int numPieces = 1;
+            pieces[0].n = 3;
+            for (int k = 0; k < 9; k++) pieces[0].p[k / 3][k % 3] = lt->v[k] + back[k % 3];
+            for (int c = 0; c < numCells && numPieces > 0; c++) {
+                float blo[3] = { (float) cells[c][0], (float) cells[c][1], (float) cells[c][2] };
+                float bhi[3] = { blo[0] + 1.0f, blo[1] + 1.0f, blo[2] + 1.0f };
+                numPieces = subtract_box(pieces, numPieces, blo, bhi);
+            }
+            int needed = 1 + (numCells > 0 ? numPieces * MAX_POLY : 0);
+            if (numOut + needed > cap) {
+                cap = (numOut + needed) * 2;
+                struct ColTri *grown = realloc(out, sizeof(struct ColTri) * (size_t) cap);
+                if (grown == NULL) break;
+                out = grown;
+            }
+            if (numCells == 0) {
+                for (int k = 0; k < 9; k++) out[numOut].v[k] = (k % 3 == 0) ? (float) (lt->v[k] + originX) : lt->v[k];
+                out[numOut++].flags = lt->flags;
+                continue;
+            }
+            for (int k = 0; k < 9; k++) out[numOut].v[k] = (k % 3 == 0) ? (float) (lt->v[k] + originX) : lt->v[k];
+            out[numOut++].flags = lt->flags | TRI_GHOST;
+            for (int pc = 0; pc < numPieces; pc++) {
+                for (int j = 1; j + 1 < pieces[pc].n; j++) {
+                    const float *q[3] = { pieces[pc].p[0], pieces[pc].p[j], pieces[pc].p[j + 1] };
+                    for (int k = 0; k < 9; k++) {
+                        float local = q[k / 3][k % 3] - back[k % 3];
+                        out[numOut].v[k] = (k % 3 == 0) ? (float) (local + originX) : local;
+                    }
+                    out[numOut++].flags = lt->flags;
+                }
+            }
+        }
+        hdr.count = (uint32_t) numOut;
+        queue_push(COL_TRIS, &hdr, sizeof(hdr), out, (uint32_t) (sizeof(struct ColTri) * (size_t) numOut));
+        free(out);
+    }
+    hdr.count = (uint32_t) count;
+    queue_push(COL_REGION, &hdr, sizeof(hdr), blocks, (uint32_t) (sizeof(struct ColBlock) * (size_t) count));
+    *outBlocks += count;
+}
+
+static void send_empty_region(int rx, int ry, int rz) {
+    struct ColRegion empty;
+    empty.minX = (int) sOriginX + rx * MC_REGION_SIZE;
+    empty.minY = ry * MC_REGION_SIZE;
+    empty.minZ = rz * MC_REGION_SIZE;
+    empty.maxX = empty.minX + MC_REGION_SIZE - 1;
+    empty.maxY = empty.minY + MC_REGION_SIZE - 1;
+    empty.maxZ = empty.minZ + MC_REGION_SIZE - 1;
+    empty.epoch = sEpoch;
+    empty.count = 0;
+    queue_push(COL_REGION, &empty, sizeof(empty), NULL, 0);
+}
+
+void mc_collision_export(uint32_t worldId, uint32_t epoch) {
+    struct GrowingArray *pool = surface_get_static_pool();
+    if (pool == NULL || pool->count == 0) {
+        return;
+    }
+    forget_area();
+    mc_origin_y_compute(worldId);
+    double originX = mc_origin_x(worldId);
+    double shiftY = mc_origin_y_units(worldId);
+    sOriginX = originX;
+    sEpoch = epoch;
+    u16 terrainType = gCurrentArea != NULL ? gCurrentArea->terrainType : TERRAIN_STONE;
+
+    // 1. Triangles in Minecraft blocks (relative to the area origin), with what they're made of.
+    struct LocalTri *tris = malloc(sizeof(struct LocalTri) * pool->count);
+    if (tris == NULL) {
+        return;
+    }
+    int numTris = 0;
+    int seenCount[128] = { 0 };
+    mc_material_scan();  // what the level looks like: sand paths, stone walls, wooden floors...
+    growing_array_for_each_(pool, struct Surface, s) {
+        if (s == NULL || skip_surface(s)) {
+            continue;
+        }
+        const s16 *vs[3] = { s->vertex1, s->vertex2, s->vertex3 };
+        for (int k = 0; k < 3; k++) {
+            tris[numTris].v[k * 3 + 0] = (float) (vs[k][0] / UNITS_PER_BLOCK);
+            tris[numTris].v[k * 3 + 1] = (float) ((vs[k][1] - shiftY) / UNITS_PER_BLOCK);
+            tris[numTris].v[k * 3 + 2] = (float) (vs[k][2] / UNITS_PER_BLOCK);
+        }
+        float sv[9], sn[3] = { s->normal.x, s->normal.y, s->normal.z };
+        for (int k = 0; k < 9; k++) {
+            sv[k] = (float) vs[k / 3][k % 3];
+        }
+        int seen = mc_material_for(sv, sn, terrainType);
+        tris[numTris].flags = surface_flags(s, terrainType, seen);
+        if (walkable_for_mario(s, terrainType)) {
+            tris[numTris].flags |= TRI_WALKABLE;
+        }
+        if (seen > 0 && seen < 128) {
+            seenCount[seen]++;
+        }
+        numTris++;
+    }
+    if (numTris == 0) {
+        free(tris);
+        return;
+    }
+
+    // 2. Which regions each triangle touches (within half a block, like SkyCraft).
+    int rmin[3] = { 1 << 30, 1 << 30, 1 << 30 }, rmax[3] = { -(1 << 30), -(1 << 30), -(1 << 30) };
+    for (int t = 0; t < numTris; t++) {
+        for (int k = 0; k < 3; k++) {
+            float lo = min3(tris[t].v[k], tris[t].v[3 + k], tris[t].v[6 + k]) - 0.5f;
+            float hi = max3(tris[t].v[k], tris[t].v[3 + k], tris[t].v[6 + k]) + 0.5f;
+            int r0 = floor_div((int) floorf(lo), MC_REGION_SIZE), r1 = floor_div((int) floorf(hi), MC_REGION_SIZE);
+            if (r0 < rmin[k]) rmin[k] = r0;
+            if (r1 > rmax[k]) rmax[k] = r1;
+        }
+    }
+    // One empty region of margin all round: Minecraft only lets Steve go once it knows the regions
+    // around him, empty ones included.
+    for (int k = 0; k < 3; k++) {
+        rmin[k]--;
+        rmax[k]++;
+    }
+    int nx = rmax[0] - rmin[0] + 1, ny = rmax[1] - rmin[1] + 1, nz = rmax[2] - rmin[2] + 1;
+    size_t cells = (size_t) nx * ny * nz;
+    int *cellCount = calloc(cells, sizeof(int));
+    int **cellTris = calloc(cells, sizeof(int *));
+    int *cellCap = calloc(cells, sizeof(int));
+    if (cellCount == NULL || cellTris == NULL || cellCap == NULL) {
+        free(cellCount); free(cellTris); free(cellCap); free(tris);
+        return;
+    }
+    for (int t = 0; t < numTris; t++) {
+        int r0[3], r1[3];
+        for (int k = 0; k < 3; k++) {
+            float lo = min3(tris[t].v[k], tris[t].v[3 + k], tris[t].v[6 + k]) - 0.5f;
+            float hi = max3(tris[t].v[k], tris[t].v[3 + k], tris[t].v[6 + k]) + 0.5f;
+            r0[k] = floor_div((int) floorf(lo), MC_REGION_SIZE) - rmin[k];
+            r1[k] = floor_div((int) floorf(hi), MC_REGION_SIZE) - rmin[k];
+        }
+        for (int x = r0[0]; x <= r1[0]; x++) {
+            for (int y = r0[1]; y <= r1[1]; y++) {
+                for (int z = r0[2]; z <= r1[2]; z++) {
+                    size_t c = ((size_t) y * nz + z) * nx + x;
+                    if (cellCount[c] == cellCap[c]) {
+                        int cap = cellCap[c] ? cellCap[c] * 2 : 16;
+                        int *grown = realloc(cellTris[c], sizeof(int) * (size_t) cap);
+                        if (grown == NULL) {
+                            continue;
+                        }
+                        cellTris[c] = grown;
+                        cellCap[c] = cap;
+                    }
+                    cellTris[c][cellCount[c]++] = t;
+                }
+            }
+        }
+    }
+    sTris = tris; sNumTris = numTris;
+    memcpy(sRmin, rmin, sizeof(sRmin));
+    sNx = nx; sNy = ny; sNz = nz;
+    sCellCount = cellCount; sCellTris = cellTris; sCellCap = cellCap;
+    sHaveArea = true;
+
+    // 3. Start over in Minecraft, then one region at a time.
+    queue_clear();
+    queue_push(COL_CLEAR, &epoch, sizeof(epoch), NULL, 0);
+    int regions = 0, blocks = 0;
+    for (int y = 0; y < ny; y++) {
+        for (int z = 0; z < nz; z++) {
+            for (int x = 0; x < nx; x++) {
+                size_t c = ((size_t) y * nz + z) * nx + x;
+                if (cellCount[c] == 0) {
+                    send_empty_region(x + rmin[0], y + rmin[1], z + rmin[2]);
+                    continue;
+                }
+                voxelize_region(tris, cellTris[c], cellCount[c], x + rmin[0], y + rmin[1], z + rmin[2], originX, epoch, &blocks);
+                regions++;
+            }
+        }
+    }
+    printf("[MarioCraft] level shape: %d triangles -> %d regions, %d blocks of collision\n", numTris, regions, blocks);
+    snprintf(sMaterialSummary, sizeof(sMaterialSummary), "looks: grass %d dirt %d stone %d sand %d snow %d ice %d wood %d brick %d wool %d (of %d)",
+             seenCount[DIG_GRASS], seenCount[DIG_DIRT], seenCount[DIG_STONE], seenCount[DIG_SAND], seenCount[DIG_SNOW],
+             seenCount[DIG_ICE], seenCount[DIG_PLANKS], seenCount[DIG_BRICKS], seenCount[DIG_RED_WOOL], numTris);
+    printf("[MarioCraft] %s\n", sMaterialSummary);
+    mc_collision_pump();
+}
+
+// Holes were dug (or filled) in Minecraft blocks [x0..x1] x [y0..y1] x [z0..z1] (absolute):
+// send the regions there again, with the holes cut out.
+void mc_collision_refresh_box(int x0, int y0, int z0, int x1, int y1, int z1) {
+    if (!sHaveArea) {
+        return;
+    }
+    int base = (int) sOriginX;
+    // Triangles are sent with every region they come within half a block of: one block of margin.
+    int r0[3] = { floor_div(x0 - 1 - base, MC_REGION_SIZE), floor_div(y0 - 1, MC_REGION_SIZE), floor_div(z0 - 1, MC_REGION_SIZE) };
+    int r1[3] = { floor_div(x1 + 1 - base, MC_REGION_SIZE), floor_div(y1 + 1, MC_REGION_SIZE), floor_div(z1 + 1, MC_REGION_SIZE) };
+    // Only the regions the area actually has.
+    int lo[3] = { sRmin[0], sRmin[1], sRmin[2] }, hi[3] = { sRmin[0] + sNx - 1, sRmin[1] + sNy - 1, sRmin[2] + sNz - 1 };
+    for (int k = 0; k < 3; k++) {
+        if (r0[k] < lo[k]) r0[k] = lo[k];
+        if (r1[k] > hi[k]) r1[k] = hi[k];
+        if (r0[k] > r1[k]) return;
+    }
+    int blocks = 0;
+    for (int ry = r0[1]; ry <= r1[1]; ry++) {
+        for (int rz = r0[2]; rz <= r1[2]; rz++) {
+            for (int rx = r0[0]; rx <= r1[0]; rx++) {
+                int x = rx - sRmin[0], y = ry - sRmin[1], z = rz - sRmin[2];
+                if (x < 0 || y < 0 || z < 0 || x >= sNx || y >= sNy || z >= sNz) {
+                    continue;
+                }
+                size_t c = ((size_t) y * sNz + z) * sNx + x;
+                if (sCellCount[c] == 0) {
+                    continue;
+                }
+                voxelize_region(sTris, sCellTris[c], sCellCount[c], rx, ry, rz, sOriginX, sEpoch, &blocks);
+            }
+        }
+    }
+    mc_collision_pump();
+}
diff --git a/src/pc/mariocraft/mc_dig.c b/src/pc/mariocraft/mc_dig.c
new file mode 100644
index 000000000..00b6311b2
--- /dev/null
+++ b/src/pc/mariocraft/mc_dig.c
@@ -0,0 +1,710 @@
+// MarioCraft: holes dug into Mario's level.
+//
+// Steve mines SM64's ground like any Minecraft block: SkyCraft's Minecraft mod (SkyDig) works
+// out what each bit of ground is made of (grass, then dirt, then stone with ores...), drops it,
+// and remembers which cells were dug out. It tells us through REN_DUG messages (one bitset per
+// 16x16x16 section). This file:
+//
+//   1. keeps the set of dug cells,
+//   2. sends Minecraft the level's collision again around new holes, with them cut out
+//      (mc_collision.c), so Steve and mobs can walk into them,
+//   3. cuts the holes out of the level's own display lists, so you see into them. Minecraft
+//      draws the inside walls of a hole itself (dirt, stone...) as part of its block meshes.
+
+#include "mariocraft_internal.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "sm64.h"
+#include "game/area.h"
+#include "game/memory.h"
+#include "engine/graph_node.h"
+
+// ---- the dug cells ---------------------------------------------------------------------------
+
+static inline uint64_t cell_key(int x, int y, int z) {
+    return ((uint64_t) (x & 0x3FFFFF) << 42) | ((uint64_t) (y & 0x1FFFFF) << 21) | (uint64_t) (z & 0x1FFFFF);
+}
+
+// Open-addressing set of cell keys (0 = empty slot; key 0 can't happen for real patches).
+static uint64_t *sSet = NULL;
+static size_t sSetCap = 0, sSetCount = 0;
+
+static size_t slot_of(uint64_t key, size_t cap) {
+    return (size_t) ((key * 0x9E3779B97F4A7C15ull) >> 20) & (cap - 1);
+}
+
+static void set_grow(void);
+
+static void set_add(uint64_t key) {
+    if ((sSetCount + 1) * 2 > sSetCap) {
+        set_grow();
+    }
+    if (sSet == NULL || sSetCount + 1 >= sSetCap) {
+        return;  // (only if memory ran out)
+    }
+    size_t i = slot_of(key, sSetCap);
+    while (sSet[i] != 0 && sSet[i] != key) {
+        i = (i + 1) & (sSetCap - 1);
+    }
+    if (sSet[i] == 0) {
+        sSet[i] = key;
+        sSetCount++;
+    }
+}
+
+static void set_grow(void) {
+    size_t cap = sSetCap ? sSetCap * 2 : 4096;
+    uint64_t *grown = calloc(cap, sizeof(uint64_t));
+    if (grown == NULL) {
+        return;  // out of memory: keep the set as it is (set_add still finds a free slot below half full)
+    }
+    uint64_t *old = sSet;
+    size_t oldCap = sSetCap;
+    sSet = grown;
+    sSetCap = cap;
+    sSetCount = 0;
+    for (size_t i = 0; i < oldCap; i++) {
+        if (old[i] != 0) {
+            set_add(old[i]);
+        }
+    }
+    free(old);
+}
+
+static bool set_has(uint64_t key) {
+    if (sSetCount == 0) {
+        return false;
+    }
+    size_t i = slot_of(key, sSetCap);
+    while (sSet[i] != 0) {
+        if (sSet[i] == key) {
+            return true;
+        }
+        i = (i + 1) & (sSetCap - 1);
+    }
+    return false;
+}
+
+static void set_remove(uint64_t key) {
+    if (sSetCount == 0) {
+        return;
+    }
+    size_t i = slot_of(key, sSetCap);
+    while (sSet[i] != 0 && sSet[i] != key) {
+        i = (i + 1) & (sSetCap - 1);
+    }
+    if (sSet[i] == 0) {
+        return;
+    }
+    // Remove and re-insert the rest of the cluster (keeps probing correct).
+    sSet[i] = 0;
+    sSetCount--;
+    size_t j = (i + 1) & (sSetCap - 1);
+    while (sSet[j] != 0) {
+        uint64_t k = sSet[j];
+        sSet[j] = 0;
+        sSetCount--;
+        set_add(k);
+        j = (j + 1) & (sSetCap - 1);
+    }
+}
+
+bool mc_dig_any(void) {
+    return sSetCount > 0;
+}
+
+bool mc_dig_is_dug(int x, int y, int z) {
+    return set_has(cell_key(x, y, z));
+}
+
+// Each section's bitset as last received, so a section that changes can be updated exactly.
+struct DugSection {
+    int sx, sy, sz;
+    uint64_t bits[64];  // bit x + 16z + 256y
+};
+static struct DugSection *sSections = NULL;
+static int sNumSections = 0, sCapSections = 0;
+
+// Changed areas waiting to be applied (Minecraft block boxes).
+struct Box { int x0, y0, z0, x1, y1, z1; };
+static struct Box sPending[256];
+static int sNumPending = 0;
+static bool sAllPending = false;
+static bool sVisualsDirty = false;
+
+void mc_dig_read(const uint8_t *p, uint32_t bytes) {
+    if (bytes < 24) {
+        return;
+    }
+    int32_t sx, sy, sz;
+    uint32_t count;
+    memcpy(&sx, p, 4);
+    memcpy(&sy, p + 4, 4);
+    memcpy(&sz, p + 8, 4);
+    memcpy(&count, p + 12, 4);
+    uint64_t bits[64];
+    memset(bits, 0, sizeof(bits));
+    if (count > 0 && bytes >= 24 + 512) {
+        memcpy(bits, p + 24, 512);
+    }
+
+    struct DugSection *sec = NULL;
+    for (int i = 0; i < sNumSections; i++) {
+        if (sSections[i].sx == sx && sSections[i].sy == sy && sSections[i].sz == sz) {
+            sec = &sSections[i];
+            break;
+        }
+    }
+    if (sec == NULL) {
+        if (count == 0) {
+            return;
+        }
+        if (sNumSections == sCapSections) {
+            int cap = sCapSections ? sCapSections * 2 : 64;
+            struct DugSection *grown = realloc(sSections, sizeof(*sSections) * (size_t) cap);
+            if (grown == NULL) {
+                return;
+            }
+            sSections = grown;
+            sCapSections = cap;
+        }
+        sec = &sSections[sNumSections++];
+        memset(sec, 0, sizeof(*sec));
+        sec->sx = sx;
+        sec->sy = sy;
+        sec->sz = sz;
+    }
+    if (memcmp(sec->bits, bits, sizeof(bits)) == 0) {
+        return;
+    }
+    for (int bit = 0; bit < 4096; bit++) {
+        bool was = (sec->bits[bit >> 6] >> (bit & 63)) & 1, now = (bits[bit >> 6] >> (bit & 63)) & 1;
+        if (was == now) {
+            continue;
+        }
+        int x = sx * 16 + (bit & 15), z = sz * 16 + ((bit >> 4) & 15), y = sy * 16 + (bit >> 8);
+        if (now) set_add(cell_key(x, y, z));
+        else     set_remove(cell_key(x, y, z));
+    }
+    memcpy(sec->bits, bits, sizeof(bits));
+    if (sNumPending < 256) {
+        struct Box b = { sx * 16, sy * 16, sz * 16, sx * 16 + 15, sy * 16 + 15, sz * 16 + 15 };
+        sPending[sNumPending++] = b;
+    } else {
+        sAllPending = true;
+    }
+    sVisualsDirty = true;
+}
+
+// ---- holes in the level's display lists -------------------------------------------------------
+
+// A level geometry node, and the display list it had before we cut holes into it. Entries are
+// kept for every area of the loaded level (SM64 keeps all of a level's areas alive while you go
+// between them), and dropped once their area is gone.
+struct LevelDl {
+    struct GraphNodeRoot *root;  // the area it belongs to
+    struct GraphNodeDisplayList *node;
+    Gfx *original;
+    Gfx *cut;        // our version (NULL: none)
+    Vtx **vtxBlocks; // the vertex arrays it uses
+    int numVtxBlocks;
+};
+static struct LevelDl *sDls = NULL;
+static int sCutTris = 0, sCutDls = 0;  // shown on the status line
+static int sNumDls = 0, sCapDls = 0;
+
+static void free_cut(struct LevelDl *d) {
+    free(d->cut);
+    for (int i = 0; i < d->numVtxBlocks; i++) {
+        free(d->vtxBlocks[i]);
+    }
+    free(d->vtxBlocks);
+    d->cut = NULL;
+    d->vtxBlocks = NULL;
+    d->numVtxBlocks = 0;
+}
+
+static bool root_alive(struct GraphNodeRoot *root) {
+    for (int i = 0; i < MAX_AREAS; i++) {
+        if (gAreaData[i].root == root) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Forgets entries whose area was unloaded (their nodes are gone: only our own memory is freed),
+// or whose node no longer shows what we gave it (SM64 made a new one at the same address).
+static void prune_dls(void) {
+    int out = 0;
+    for (int i = 0; i < sNumDls; i++) {
+        struct LevelDl *d = &sDls[i];
+        bool alive = d->root != NULL && root_alive(d->root);
+        if (alive) {
+            Gfx *expect = d->cut != NULL ? d->cut : d->original;
+            alive = d->node->displayList == expect;
+        }
+        if (!alive) {
+            free_cut(d);
+            continue;
+        }
+        sDls[out++] = *d;
+    }
+    sNumDls = out;
+}
+
+static bool have_root(struct GraphNodeRoot *root) {
+    for (int i = 0; i < sNumDls; i++) {
+        if (sDls[i].root == root) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Collects the level's own display list nodes: not objects, nor anything moved by a transform.
+static void collect_dls(struct GraphNodeRoot *root, struct GraphNode *first, int depth) {
+    if (first == NULL || depth > 64) {
+        return;
+    }
+    struct GraphNode *n = first;
+    do {
+        switch (n->type) {
+            case GRAPH_NODE_TYPE_OBJECT_PARENT:
+            case GRAPH_NODE_TYPE_OBJECT:
+            case GRAPH_NODE_TYPE_TRANSLATION_ROTATION:
+            case GRAPH_NODE_TYPE_TRANSLATION:
+            case GRAPH_NODE_TYPE_ROTATION:
+            case GRAPH_NODE_TYPE_SCALE:
+            case GRAPH_NODE_TYPE_SCALE_XYZ:
+            case GRAPH_NODE_TYPE_BILLBOARD:
+            case GRAPH_NODE_TYPE_ANIMATED_PART:
+            case GRAPH_NODE_TYPE_HELD_OBJ:
+            case GRAPH_NODE_TYPE_GENERATED_LIST:
+            case GRAPH_NODE_TYPE_BACKGROUND:
+                break;  // not plain level geometry
+            case GRAPH_NODE_TYPE_DISPLAY_LIST: {
+                struct GraphNodeDisplayList *dn = (struct GraphNodeDisplayList *) n;
+                if (dn->displayList != NULL) {
+                    if (sNumDls == sCapDls) {
+                        int cap = sCapDls ? sCapDls * 2 : 64;
+                        struct LevelDl *grown = realloc(sDls, sizeof(*sDls) * (size_t) cap);
+                        if (grown == NULL) {
+                            return;
+                        }
+                        sDls = grown;
+                        sCapDls = cap;
+                    }
+                    struct LevelDl *d = &sDls[sNumDls++];
+                    memset(d, 0, sizeof(*d));
+                    d->root = root;
+                    d->node = dn;
+                    d->original = dn->displayList;
+                }
+                collect_dls(root, n->children, depth + 1);
+                break;
+            }
+            default:
+                collect_dls(root, n->children, depth + 1);
+                break;
+        }
+        n = n->next;
+    } while (n != first && n != NULL);
+}
+
+static struct GraphNodeRoot *sLastRoot = NULL;
+
+void mc_dig_area_changed(void) {
+    sVisualsDirty = true;  // (collision: the area's export already leaves the holes out)
+}
+
+// Dug cells as SM64 boxes, for the current patch only.
+static float (*sBoxes)[6] = NULL;
+static int sNumBoxes = 0, sCapBoxes = 0;
+
+static void gather_boxes(uint32_t worldId) {
+    sNumBoxes = 0;
+    double originX = mc_origin_x(worldId);
+    int shiftY = mc_origin_y_units(worldId);
+    int lo = (int) (originX - LEVEL_SPACING / 2), hi = (int) (originX + LEVEL_SPACING / 2);
+    for (int i = 0; i < sNumSections; i++) {
+        struct DugSection *sec = &sSections[i];
+        if (sec->sx * 16 + 15 < lo || sec->sx * 16 > hi) {
+            continue;
+        }
+        for (int bit = 0; bit < 4096; bit++) {
+            if (!((sec->bits[bit >> 6] >> (bit & 63)) & 1)) {
+                continue;
+            }
+            if (sNumBoxes == sCapBoxes) {
+                int cap = sCapBoxes ? sCapBoxes * 2 : 256;
+                float (*grown)[6] = realloc(sBoxes, sizeof(float[6]) * (size_t) cap);
+                if (grown == NULL) {
+                    return;
+                }
+                sBoxes = grown;
+                sCapBoxes = cap;
+            }
+            int x = sec->sx * 16 + (bit & 15), z = sec->sz * 16 + ((bit >> 4) & 15), y = sec->sy * 16 + (bit >> 8);
+            float *b = sBoxes[sNumBoxes++];
+            b[0] = (float) ((x - originX) * UNITS_PER_BLOCK);
+            b[1] = (float) (y * UNITS_PER_BLOCK + shiftY);
+            b[2] = (float) (z * UNITS_PER_BLOCK);
+            b[3] = b[0] + (float) UNITS_PER_BLOCK;
+            b[4] = b[1] + (float) UNITS_PER_BLOCK;
+            b[5] = b[2] + (float) UNITS_PER_BLOCK;
+        }
+    }
+}
+
+// --- polygon clipping (SM64 units), carrying each corner's weights in the original triangle ---
+#define CP_MAX 24
+#define CP_PIECES 96
+struct CPoly {
+    int n;
+    float p[CP_MAX][3];
+    float w[CP_MAX][3];  // barycentric weights of the original triangle's corners
+};
+
+static void cp_split(const struct CPoly *in, int axis, float d, float sign, struct CPoly *outside, struct CPoly *inside) {
+    outside->n = inside->n = 0;
+    for (int i = 0; i < in->n; i++) {
+        int j = (i + 1) % in->n;
+        float da = sign * (in->p[i][axis] - d), db = sign * (in->p[j][axis] - d);
+        struct CPoly *dst = da > 0 ? outside : inside;
+        if (dst->n < CP_MAX) {
+            memcpy(dst->p[dst->n], in->p[i], 12);
+            memcpy(dst->w[dst->n], in->w[i], 12);
+            dst->n++;
+        }
+        if ((da > 0) != (db > 0)) {
+            float t = da / (da - db);
+            float q[3], qw[3];
+            for (int k = 0; k < 3; k++) {
+                q[k] = in->p[i][k] + (in->p[j][k] - in->p[i][k]) * t;
+                qw[k] = in->w[i][k] + (in->w[j][k] - in->w[i][k]) * t;
+            }
+            if (outside->n < CP_MAX) { memcpy(outside->p[outside->n], q, 12); memcpy(outside->w[outside->n], qw, 12); outside->n++; }
+            if (inside->n < CP_MAX) { memcpy(inside->p[inside->n], q, 12); memcpy(inside->w[inside->n], qw, 12); inside->n++; }
+        }
+    }
+}
+
+static int cp_subtract(struct CPoly *pieces, int count, const float *box) {
+    static struct CPoly next[CP_PIECES];
+    int out = 0;
+    for (int i = 0; i < count; i++) {
+        struct CPoly cur = pieces[i];
+        bool overlaps = true;
+        for (int k = 0; k < 3 && overlaps; k++) {
+            float mn = cur.p[0][k], mx = cur.p[0][k];
+            for (int j = 1; j < cur.n; j++) { mn = fminf(mn, cur.p[j][k]); mx = fmaxf(mx, cur.p[j][k]); }
+            overlaps = mx > box[k] + 0.01f && mn < box[3 + k] - 0.01f;
+        }
+        if (!overlaps) {
+            if (out < CP_PIECES) next[out++] = cur;
+            continue;
+        }
+        for (int face = 0; face < 6 && cur.n >= 3; face++) {
+            int axis = face / 2;
+            struct CPoly outside, inside;
+            if (face & 1) cp_split(&cur, axis, box[3 + axis], 1.0f, &outside, &inside);
+            else          cp_split(&cur, axis, box[axis], -1.0f, &outside, &inside);
+            if (outside.n >= 3 && out < CP_PIECES) next[out++] = outside;
+            cur = inside;
+        }
+    }
+    memcpy(pieces, next, sizeof(struct CPoly) * (size_t) out);
+    return out;
+}
+
+// --- rebuilding one display list -----------------------------------------------------------
+struct Builder {
+    Gfx *gfx;
+    int numGfx, capGfx;
+    Vtx **blocks;
+    int numBlocks, capBlocks;
+    Vtx pending[30];
+    int numPending;
+    bool changed;
+};
+
+static void b_gfx(struct Builder *b, Gfx g) {
+    if (b->numGfx == b->capGfx) {
+        int cap = b->capGfx ? b->capGfx * 2 : 256;
+        Gfx *grown = realloc(b->gfx, sizeof(Gfx) * (size_t) cap);
+        if (grown == NULL) {
+            return;
+        }
+        b->gfx = grown;
+        b->capGfx = cap;
+    }
+    b->gfx[b->numGfx++] = g;
+}
+
+static void b_flush(struct Builder *b) {
+    if (b->numPending == 0) {
+        return;
+    }
+    Vtx *block = malloc(sizeof(Vtx) * (size_t) b->numPending);
+    if (block == NULL) {
+        b->numPending = 0;
+        return;
+    }
+    memcpy(block, b->pending, sizeof(Vtx) * (size_t) b->numPending);
+    if (b->numBlocks == b->capBlocks) {
+        int cap = b->capBlocks ? b->capBlocks * 2 : 64;
+        Vtx **grown = realloc(b->blocks, sizeof(Vtx *) * (size_t) cap);
+        if (grown == NULL) {
+            free(block);
+            b->numPending = 0;
+            return;
+        }
+        b->blocks = grown;
+        b->capBlocks = cap;
+    }
+    b->blocks[b->numBlocks++] = block;
+    Gfx g;
+    gSPVertex(&g, block, b->numPending, 0);
+    b_gfx(b, g);
+    for (int i = 0; i + 2 < b->numPending; i += 3) {
+        gSP1Triangle(&g, i, i + 1, i + 2, 0);
+        b_gfx(b, g);
+    }
+    b->numPending = 0;
+}
+
+static void b_tri(struct Builder *b, const Vtx *a, const Vtx *c1, const Vtx *c2) {
+    if (b->numPending + 3 > 30) {
+        b_flush(b);
+    }
+    b->pending[b->numPending++] = *a;
+    b->pending[b->numPending++] = *c1;
+    b->pending[b->numPending++] = *c2;
+}
+
+static Vtx mix_vtx(const Vtx *v[3], const float *w, const float *pos) {
+    Vtx out = *v[0];
+    out.v.ob[0] = pos[0];
+    out.v.ob[1] = pos[1];
+    out.v.ob[2] = pos[2];
+    for (int k = 0; k < 2; k++) {
+        out.v.tc[k] = (s16) lroundf(w[0] * v[0]->v.tc[k] + w[1] * v[1]->v.tc[k] + w[2] * v[2]->v.tc[k]);
+    }
+    for (int k = 0; k < 4; k++) {
+        float c = w[0] * v[0]->v.cn[k] + w[1] * v[1]->v.cn[k] + w[2] * v[2]->v.cn[k];
+        out.v.cn[k] = (u8) fminf(255.0f, fmaxf(0.0f, c + 0.5f));
+    }
+    return out;
+}
+
+// How far a surface counts as being behind itself: SM64 surfaces often lie exactly on a block
+// boundary, and then belong to the block behind them (inside the ground), not the one in front.
+#define BEHIND 0.5f
+
+static void cut_triangle(struct Builder *b, const Vtx *v0, const Vtx *v1, const Vtx *v2) {
+    const Vtx *v[3] = { v0, v1, v2 };
+    // The side the surface faces (SM64 winds its visible faces counter-clockwise).
+    float e1[3], e2[3], n[3];
+    for (int k = 0; k < 3; k++) {
+        e1[k] = v1->v.ob[k] - v0->v.ob[k];
+        e2[k] = v2->v.ob[k] - v0->v.ob[k];
+    }
+    n[0] = e1[1] * e2[2] - e1[2] * e2[1];
+    n[1] = e1[2] * e2[0] - e1[0] * e2[2];
+    n[2] = e1[0] * e2[1] - e1[1] * e2[0];
+    float len = sqrtf(n[0] * n[0] + n[1] * n[1] + n[2] * n[2]);
+    if (len < 1e-6f) {
+        b_tri(b, v0, v1, v2);
+        return;
+    }
+    float shift[3] = { -n[0] / len * BEHIND, -n[1] / len * BEHIND, -n[2] / len * BEHIND };
+    float lo[3], hi[3];
+    for (int k = 0; k < 3; k++) {
+        lo[k] = fminf(v0->v.ob[k], fminf(v1->v.ob[k], v2->v.ob[k])) + shift[k];
+        hi[k] = fmaxf(v0->v.ob[k], fmaxf(v1->v.ob[k], v2->v.ob[k])) + shift[k];
+    }
+    static struct CPoly pieces[CP_PIECES];
+    int numPieces = -1;
+    for (int i = 0; i < sNumBoxes; i++) {
+        const float *box = sBoxes[i];
+        if (hi[0] <= box[0] || lo[0] >= box[3] || hi[1] <= box[1] || lo[1] >= box[4] || hi[2] <= box[2] || lo[2] >= box[5]) {
+            continue;
+        }
+        if (numPieces < 0) {
+            numPieces = 1;
+            pieces[0].n = 3;
+            for (int c = 0; c < 3; c++) {
+                for (int k = 0; k < 3; k++) {
+                    pieces[0].p[c][k] = v[c]->v.ob[k] + shift[k];
+                    pieces[0].w[c][k] = (c == k) ? 1.0f : 0.0f;
+                }
+            }
+        }
+        numPieces = cp_subtract(pieces, numPieces, box);
+        if (numPieces == 0) {
+            break;
+        }
+    }
+    if (numPieces < 0) {
+        b_tri(b, v0, v1, v2);  // no hole near it
+        return;
+    }
+    b->changed = true;
+    sCutTris++;
+    for (int pc = 0; pc < numPieces; pc++) {
+        for (int j = 1; j + 1 < pieces[pc].n; j++) {
+            int idx[3] = { 0, j, j + 1 };
+            Vtx out[3];
+            for (int c = 0; c < 3; c++) {
+                float pos[3];
+                for (int k = 0; k < 3; k++) {
+                    pos[k] = pieces[pc].p[idx[c]][k] - shift[k];
+                }
+                out[c] = mix_vtx(v, pieces[pc].w[idx[c]], pos);
+            }
+            b_tri(b, &out[0], &out[1], &out[2]);
+        }
+    }
+}
+
+#define CMD_OP(g) ((uint8_t) ((g)->words.w0 >> 24))
+#define W0(g, pos, width) (((g)->words.w0 >> (pos)) & ((1u << (width)) - 1))
+
+static Vtx sSlots[64];
+
+static void walk_dl(struct Builder *b, const Gfx *dl, int depth) {
+    if (dl == NULL || depth > 16) {
+        return;
+    }
+    for (int guard = 0; guard < 200000; guard++, dl++) {
+        uint8_t op = CMD_OP(dl);
+        if (op == (uint8_t) G_VTX) {
+            int n = (int) W0(dl, 12, 8), v0 = (int) W0(dl, 1, 7) - n;
+            const Vtx *src = segmented_to_virtual((const void *) dl->words.w1);
+            if (v0 >= 0 && n > 0 && v0 + n <= 64 && src != NULL) {
+                memcpy(&sSlots[v0], src, sizeof(Vtx) * (size_t) n);
+            }
+        } else if (op == (uint8_t) G_TRI1) {
+            cut_triangle(b, &sSlots[W0(dl, 16, 8) / 2 & 63], &sSlots[W0(dl, 8, 8) / 2 & 63], &sSlots[W0(dl, 0, 8) / 2 & 63]);
+        } else if (op == (uint8_t) G_TRI2) {
+            cut_triangle(b, &sSlots[W0(dl, 16, 8) / 2 & 63], &sSlots[W0(dl, 8, 8) / 2 & 63], &sSlots[W0(dl, 0, 8) / 2 & 63]);
+            uint32_t w1 = (uint32_t) dl->words.w1;
+            cut_triangle(b, &sSlots[((w1 >> 16) & 0xFF) / 2 & 63], &sSlots[((w1 >> 8) & 0xFF) / 2 & 63], &sSlots[(w1 & 0xFF) / 2 & 63]);
+        } else if (op == (uint8_t) G_DL) {
+            const Gfx *sub = segmented_to_virtual((const void *) dl->words.w1);
+            if (W0(dl, 16, 1) == 0) {
+                walk_dl(b, sub, depth + 1);  // call
+            } else {
+                walk_dl(b, sub, depth + 1);  // branch: never returns here
+                return;
+            }
+        } else if (op == (uint8_t) G_ENDDL) {
+            return;
+        } else {
+            b_flush(b);  // state changes apply to what comes after them
+            b_gfx(b, *dl);
+        }
+    }
+}
+
+static void rebuild_dl(struct LevelDl *d) {
+    struct Builder b;
+    memset(&b, 0, sizeof(b));
+    memset(sSlots, 0, sizeof(sSlots));
+    walk_dl(&b, segmented_to_virtual(d->original), 0);
+    b_flush(&b);
+    Gfx end;
+    gSPEndDisplayList(&end);
+    b_gfx(&b, end);
+
+    Gfx *oldCut = d->cut;
+    Vtx **oldBlocks = d->vtxBlocks;
+    int oldNumBlocks = d->numVtxBlocks;
+    if (b.changed) {
+        d->cut = b.gfx;
+        d->vtxBlocks = b.blocks;
+        d->numVtxBlocks = b.numBlocks;
+        d->node->displayList = d->cut;
+    } else {
+        // No holes in this one (any more): the original again.
+        for (int i = 0; i < b.numBlocks; i++) free(b.blocks[i]);
+        free(b.blocks);
+        free(b.gfx);
+        d->cut = NULL;
+        d->vtxBlocks = NULL;
+        d->numVtxBlocks = 0;
+        d->node->displayList = d->original;
+    }
+    // The previous version may still be in this frame's lists: free it only now that the node
+    // points elsewhere (display lists are built fresh every frame from the nodes).
+    free(oldCut);
+    for (int i = 0; i < oldNumBlocks; i++) free(oldBlocks[i]);
+    free(oldBlocks);
+}
+
+static void rebuild_visuals(uint32_t worldId) {
+    if (gCurrentArea == NULL || gCurrentArea->root == NULL) {
+        return;
+    }
+    struct GraphNodeRoot *root = gCurrentArea->root;
+    sLastRoot = root;
+    prune_dls();
+    if (!have_root(root)) {
+        collect_dls(root, &root->node, 0);
+    }
+    gather_boxes(worldId);
+    sCutTris = 0;
+    sCutDls = 0;
+    for (int i = 0; i < sNumDls; i++) {
+        if (sDls[i].root != root || (sNumBoxes == 0 && sDls[i].cut == NULL)) {
+            continue;  // another area / nothing dug, nothing to undo
+        }
+        rebuild_dl(&sDls[i]);
+        if (sDls[i].cut != NULL) {
+            sCutDls++;
+        }
+    }
+}
+
+// For the status line: what's been dug, and how much of the level has holes cut in it.
+int mc_dig_status(char *out, int size) {
+    int areaDls = 0;
+    for (int i = 0; i < sNumDls; i++) {
+        if (sDls[i].root == sLastRoot) {
+            areaDls++;
+        }
+    }
+    return snprintf(out, (size_t) size, "dug %d  here %d  cut %d tris in %d/%d parts", (int) sSetCount, sNumBoxes, sCutTris, sCutDls, areaDls);
+}
+
+// Called every game frame: apply holes that changed in the area Steve's in.
+void mc_dig_update(uint32_t worldId) {
+    double originX = mc_origin_x(worldId);
+    int lo = (int) (originX - LEVEL_SPACING / 2), hi = (int) (originX + LEVEL_SPACING / 2);
+    if (sAllPending) {
+        mc_collision_refresh_box(lo, -1100, -32768, hi, 1100, 32767);
+    } else {
+        for (int i = 0; i < sNumPending; i++) {
+            struct Box *b = &sPending[i];
+            if (b->x1 < lo || b->x0 > hi) {
+                continue;  // another level's holes
+            }
+            mc_collision_refresh_box(b->x0, b->y0, b->z0, b->x1, b->y1, b->z1);
+        }
+    }
+    sNumPending = 0;
+    sAllPending = false;
+    // SM64 rebuilt the area (a death, a warp back in): cut the holes into the new one too.
+    if (sNumSections > 0 && gCurrentArea != NULL && gCurrentArea->root != sLastRoot) {
+        sVisualsDirty = true;
+    }
+    if (sVisualsDirty) {
+        sVisualsDirty = false;
+        rebuild_visuals(worldId);
+    }
+}
diff --git a/src/pc/mariocraft/mc_lobby.c b/src/pc/mariocraft/mc_lobby.c
new file mode 100644
index 000000000..e9858a549
--- /dev/null
+++ b/src/pc/mariocraft/mc_lobby.c
@@ -0,0 +1,244 @@
+// MarioCraft multiplayer: everyone's Minecraft in one world.
+//
+// Each player has their own hidden Minecraft. When they play SM64 together, the host's Minecraft
+// opens its world to friends (Minecraft's "Open to LAN", which the bundled e4mc turns into an
+// internet address), the host's SM64 sends that address to everyone, and their Minecrafts join it.
+// Then Minecraft shares what Minecraft knows how to share: placed and broken blocks, dropped items,
+// mobs, chests, and each other. Other players' Steves are drawn by Minecraft (with their skins and
+// armour), so their Mario stand-ins are hidden (mario.c asks mariocraft_hide_remote).
+//
+// The two halves meet in the lobby block of the shared memory (Proto.OFF_LOBBY on Minecraft's side):
+//   SM64 -> Minecraft: what it should do (stay put, be in its own world, host, join an address)
+//   Minecraft -> SM64: what it's doing (own world, hosting at a link, in a friend's world), players
+
+#include "mariocraft.h"
+
+#ifdef _WIN32
+
+#include <windows.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include <stdio.h>
+
+#include "sm64.h"
+#include "game/level_update.h"
+#include "pc/network/network.h"
+#include "pc/network/network_player.h"
+#include "pc/djui/djui_chat_message.h"
+
+#include "mariocraft_internal.h"
+
+#define OFF_LOBBY        0x11800ull  // in the gap between the input ring and the actor table
+#define LB_WANT_SEQ      0x000u
+#define LB_WANT          0x004u
+#define LB_WANT_ADDR     0x008u
+#define LB_STATE_SEQ     0x200u
+#define LB_STATE         0x204u
+#define LB_PLAYERS       0x208u
+#define LB_LINK          0x210u
+#define LB_TEXT_BYTES    256u
+
+enum { WANT_NOTHING = 0, WANT_OWN_WORLD = 1, WANT_HOST = 2, WANT_JOIN = 3 };
+enum { MCW_NONE = 0, MCW_OWN = 1, MCW_HOSTING = 2, MCW_FRIEND = 3 };
+
+// The packet's flags.
+#define PF_STEVE   (1u << 0)  // playing as Steve (MarioCraft's Minecraft is connected)
+#define PF_SHARED  (1u << 1)  // their Minecraft is in the session's shared world
+#define PF_FACE    (1u << 2)  // their skin's face follows (64 RGBA8 pixels)
+
+#define TICKS_PER_SEND   30   // game frames between status packets (once a second)
+#define REMOTE_FRESH     100  // a player's status counts for this many frames after it arrived
+
+static uint32_t sWantSeq = 0;
+static uint32_t sWant = WANT_NOTHING;
+static char sWantAddr[LB_TEXT_BYTES];
+
+static uint32_t sMcWorld = MCW_NONE;   // what Minecraft last said
+static uint32_t sMcPlayers = 0;
+static char sMcLink[LB_TEXT_BYTES];
+
+static char sHostLink[LB_TEXT_BYTES];   // client: where the host's Minecraft world is
+static uint32_t sTimer = 0;
+static enum NetworkType sLastNetworkType = NT_NONE;
+static uint32_t sAnnouncedWorld = MCW_NONE;
+
+static struct {
+    u8 flags;
+    uint32_t heard;  // sTimer when their last status arrived
+} sRemote[MAX_PLAYERS];
+
+static void chat(const char *text) {
+    djui_chat_message_create(text);
+}
+
+static void write_want(uint32_t want, const char *addr) {
+    if (gMcShm == NULL) {
+        return;
+    }
+    if (addr == NULL) {
+        addr = "";
+    }
+    if (want == sWant && strcmp(addr, sWantAddr) == 0) {
+        return;
+    }
+    sWant = want;
+    snprintf(sWantAddr, sizeof(sWantAddr), "%s", addr);
+    uint8_t *b = gMcShm + OFF_LOBBY;
+    volatile uint32_t *seq = (volatile uint32_t *) (b + LB_WANT_SEQ);
+    sWantSeq += 2;
+    *seq = sWantSeq - 1;  // odd: writing
+    MemoryBarrier();
+    memcpy(b + LB_WANT, &want, 4);
+    memset(b + LB_WANT_ADDR, 0, LB_TEXT_BYTES);
+    memcpy(b + LB_WANT_ADDR, sWantAddr, strlen(sWantAddr));
+    MemoryBarrier();
+    *seq = sWantSeq;
+}
+
+static void read_state(void) {
+    if (gMcShm == NULL) {
+        return;
+    }
+    const uint8_t *b = gMcShm + OFF_LOBBY;
+    for (int tries = 0; tries < 4; tries++) {
+        uint32_t s0, s1, world, players;
+        char link[LB_TEXT_BYTES];
+        memcpy(&s0, b + LB_STATE_SEQ, 4);
+        if (s0 & 1) {
+            continue;
+        }
+        MemoryBarrier();
+        memcpy(&world, b + LB_STATE, 4);
+        memcpy(&players, b + LB_PLAYERS, 4);
+        memcpy(link, b + LB_LINK, LB_TEXT_BYTES);
+        MemoryBarrier();
+        memcpy(&s1, b + LB_STATE_SEQ, 4);
+        if (s0 == s1) {
+            link[LB_TEXT_BYTES - 1] = '\0';
+            sMcWorld = world;
+            sMcPlayers = players;
+            memcpy(sMcLink, link, sizeof(sMcLink));
+            return;
+        }
+    }
+}
+
+void mariocraft_lobby_received(u8 globalIndex, u8 flags, const char *link, const uint32_t *face) {
+    struct NetworkPlayer *np = network_player_from_global_index(globalIndex);
+    if (np == NULL || np->localIndex >= MAX_PLAYERS) {
+        return;
+    }
+    sRemote[np->localIndex].flags = flags;
+    sRemote[np->localIndex].heard = sTimer;
+    if (face != NULL && (flags & PF_FACE)) {
+        mariocraft_remote_face(np->localIndex, face);
+    }
+    if (gNetworkType == NT_CLIENT && globalIndex == 0 && link != NULL && link[0] != '\0'
+        && strcmp(link, sHostLink) != 0) {
+        snprintf(sHostLink, sizeof(sHostLink), "%s", link);
+        printf("[MarioCraft] the host's Minecraft world is at %s\n", sHostLink);
+    }
+}
+
+static bool shared_world(void) {
+    return gNetworkType != NT_NONE && (sMcWorld == MCW_HOSTING || sMcWorld == MCW_FRIEND);
+}
+
+// This friend is playing as Steve (in any world): their face is their skin's (mc_steve.c).
+bool mariocraft_remote_steve(int localIndex) {
+    if (localIndex <= 0 || localIndex >= MAX_PLAYERS || !gNetworkPlayers[localIndex].connected) {
+        return false;
+    }
+    return (sRemote[localIndex].flags & PF_STEVE) != 0 && sTimer - sRemote[localIndex].heard < REMOTE_FRESH;
+}
+
+bool mariocraft_hide_remote(struct MarioState *m) {
+    if (m == NULL || m->playerIndex == 0 || m->playerIndex >= MAX_PLAYERS || !shared_world()) {
+        return false;
+    }
+    const struct NetworkPlayer *np = &gNetworkPlayers[m->playerIndex];
+    if (!np->connected) {
+        return false;
+    }
+    u8 want = PF_STEVE | PF_SHARED;
+    return (sRemote[m->playerIndex].flags & want) == want
+        && sTimer - sRemote[m->playerIndex].heard < REMOTE_FRESH;
+}
+
+void mc_lobby_update(bool steveActive) {
+    sTimer++;
+    read_state();
+
+    // Left a session: forget the last one's host and players.
+    if (gNetworkType != sLastNetworkType) {
+        if (sLastNetworkType == NT_CLIENT) {
+            sHostLink[0] = '\0';
+        }
+        memset(sRemote, 0, sizeof(sRemote));
+        sLastNetworkType = gNetworkType;
+    }
+
+    // What Minecraft should be doing.
+    switch (gNetworkType) {
+        case NT_SERVER:
+            // Only once someone has joined: until then the world stays off the internet.
+            if (network_player_connected_count() > 1 || sMcWorld == MCW_HOSTING) {
+                write_want(WANT_HOST, NULL);
+            } else {
+                write_want(WANT_NOTHING, NULL);
+            }
+            break;
+        case NT_CLIENT:
+            if (sHostLink[0] != '\0') {
+                write_want(WANT_JOIN, sHostLink);
+            } else {
+                write_want(WANT_NOTHING, NULL);  // until the host says where its world is
+            }
+            break;
+        default:
+            write_want(WANT_OWN_WORLD, NULL);    // (Minecraft only leaves worlds the lobby joined)
+            break;
+    }
+
+    // Say so in chat once, when the shared world starts working.
+    uint32_t world = shared_world() ? sMcWorld : MCW_NONE;
+    if (world != sAnnouncedWorld) {
+        sAnnouncedWorld = world;
+        if (world == MCW_HOSTING) {
+            chat("\\#a0ffa0\\MarioCraft: your Minecraft world is open to this game's players.");
+        } else if (world == MCW_FRIEND) {
+            chat("\\#a0ffa0\\MarioCraft: your Minecraft joined the host's world.");
+        }
+    }
+
+    // Tell everyone how we're playing (and, as the host, where the world is).
+    if (gNetworkType != NT_NONE && sTimer % TICKS_PER_SEND == 0) {
+        u8 flags = (steveActive ? PF_STEVE : 0) | (shared_world() ? PF_SHARED : 0);
+        const char *link = (gNetworkType == NT_SERVER && sMcWorld == MCW_HOSTING) ? sMcLink : NULL;
+        uint32_t face[64];
+        bool hasFace = steveActive && mariocraft_local_face(face);
+        if (hasFace) {
+            flags |= PF_FACE;
+        }
+        network_send_mariocraft(flags, link, hasFace ? face : NULL);
+    }
+}
+
+int mc_lobby_status(char *out, int size) {
+    static const char *names[] = { "-", "own", "hosting", "friend's" };
+    const char *name = sMcWorld < 4 ? names[sMcWorld] : "?";
+    return snprintf(out, (size_t) size, "   MCworld:%s players:%u", name, (unsigned) sMcPlayers);
+}
+
+#else
+
+#include <stdbool.h>
+#include "types.h"
+struct MarioState;
+#include <stdint.h>
+void mariocraft_lobby_received(u8 globalIndex, u8 flags, const char *link, const uint32_t *face) { (void) globalIndex; (void) flags; (void) link; (void) face; }
+bool mariocraft_hide_remote(struct MarioState *m) { (void) m; return false; }
+bool mariocraft_remote_steve(int localIndex) { (void) localIndex; return false; }
+
+#endif
