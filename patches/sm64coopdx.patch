+
+extern const char *dynos_builtin_tex_name(const void *data);  // data/dynos_c.cpp
+
+// The material a texture is known to be (0: not one of the named ones). Cached by address.
+static int named_material(const uint8_t *addr) {
+    static struct { const uint8_t *addr; int material; } cache[512];
+    static int cached = 0;
+    if (addr == NULL) {
+        return 0;
+    }
+    for (int i = 0; i < cached; i++) {
+        if (cache[i].addr == addr) {
+            return cache[i].material;
+        }
+    }
+    int material = 0;
+    const char *name = dynos_builtin_tex_name(addr);
+    if (name != NULL) {
+        for (size_t i = 0; i < sizeof(sNamed) / sizeof(sNamed[0]); i++) {
+            if (strcmp(name, sNamed[i].name) == 0) {
+                material = sNamed[i].material;
+                break;
+            }
+        }
+    }
+    if (cached < 512) {
+        cache[cached].addr = addr;
+        cache[cached].material = material;
+        cached++;
+    }
+    return material;
+}
+
+// ---- the level's visible triangles ----------------------------------------------------------
+
+struct VisTri {
+    float v[9];   // SM64 units
+    float n[3];   // unit normal (the side it's seen from)
+    float rgb[3]; // how it looks (0..255)
+    float penalty; // decals and see-through layers lose ties with the solid surface under them
+    int mat;      // the material its texture is known to be (sNamed), 0 if it's judged by colour
+};
+static struct VisTri *sVis = NULL;
+static int sNumVis = 0, sCapVis = 0;
+
+// Spatial bins over the visible triangles (by bounding box), BIN units each way.
+#define BIN 256.0f
+#define BIN_BUCKETS 8192
+struct Bin { int *idx; int n, cap; };
+static struct Bin sBins[BIN_BUCKETS];
+static int sNumTex;
+
+static unsigned bin_hash(int x, int y, int z) {
+    return ((unsigned) x * 73856093u ^ (unsigned) y * 19349663u ^ (unsigned) z * 83492791u) % BIN_BUCKETS;
+}
+
+static void bin_add(int x, int y, int z, int t) {
+    struct Bin *b = &sBins[bin_hash(x, y, z)];
+    if (b->n == b->cap) {
+        int cap = b->cap ? b->cap * 2 : 16;
+        int *grown = realloc(b->idx, sizeof(int) * (size_t) cap);
+        if (grown == NULL) {
+            return;
+        }
+        b->idx = grown;
+        b->cap = cap;
+    }
+    b->idx[b->n++] = t;
+}
+
+static void forget(void) {
+    sNumVis = 0;
+    sNumTex = 0;  // (declared below)
+    for (int i = 0; i < BIN_BUCKETS; i++) {
+        sBins[i].n = 0;
+    }
+}
+
+// ---- texture colours -------------------------------------------------------------------------
+
+struct TexColor { const uint8_t *addr; int fmt, siz, w, h; const uint8_t *tlut; float rgb[3]; bool ok; };
+static struct TexColor sTexCache[512];
+
+static void rgba16(const uint8_t *p, float *out, float *alpha) {
+    uint16_t c = (uint16_t) ((p[0] << 8) | p[1]);
+    out[0] = ((c >> 11) & 31) * (255.0f / 31.0f);
+    out[1] = ((c >> 6) & 31) * (255.0f / 31.0f);
+    out[2] = ((c >> 1) & 31) * (255.0f / 31.0f);
+    *alpha = (c & 1) ? 1.0f : 0.0f;
+}
+
+// Average colour of a texture (weighted by its alpha). False if it can't be read.
+static bool texture_color(const uint8_t *addr, int fmt, int siz, int w, int h, const uint8_t *tlut, float *rgb) {
+    for (int i = 0; i < sNumTex; i++) {
+        struct TexColor *t = &sTexCache[i];
+        if (t->addr == addr && t->fmt == fmt && t->siz == siz && t->w == w && t->h == h && t->tlut == tlut) {
+            memcpy(rgb, t->rgb, sizeof(t->rgb));
+            return t->ok;
+        }
+    }
+    double sum[3] = { 0, 0, 0 }, weight = 0;
+    int texels = w * h;
+    if (addr != NULL && texels > 0 && texels <= 128 * 128) {
+        for (int i = 0; i < texels; i++) {
+            float c[3] = { 0, 0, 0 }, a = 1.0f;
+            switch (fmt) {
+                case G_IM_FMT_RGBA:
+                    if (siz == G_IM_SIZ_16b) {
+                        rgba16(addr + i * 2, c, &a);
+                    } else if (siz == G_IM_SIZ_32b) {
+                        c[0] = addr[i * 4]; c[1] = addr[i * 4 + 1]; c[2] = addr[i * 4 + 2]; a = addr[i * 4 + 3] / 255.0f;
+                    } else {
+                        a = 0;
+                    }
+                    break;
+                case G_IM_FMT_IA:
+                    if (siz == G_IM_SIZ_16b) {
+                        c[0] = c[1] = c[2] = addr[i * 2]; a = addr[i * 2 + 1] / 255.0f;
+                    } else if (siz == G_IM_SIZ_8b) {
+                        c[0] = c[1] = c[2] = (addr[i] >> 4) * 17.0f; a = (addr[i] & 15) / 15.0f;
+                    } else if (siz == G_IM_SIZ_4b) {
+                        uint8_t nib = (i & 1) ? (addr[i / 2] & 15) : (addr[i / 2] >> 4);
+                        c[0] = c[1] = c[2] = (nib >> 1) * (255.0f / 7.0f); a = (nib & 1) ? 1.0f : 0.0f;
+                    } else {
+                        a = 0;
+                    }
+                    break;
+                case G_IM_FMT_I:
+                    if (siz == G_IM_SIZ_8b) {
+                        c[0] = c[1] = c[2] = addr[i];
+                    } else if (siz == G_IM_SIZ_4b) {
+                        uint8_t nib = (i & 1) ? (addr[i / 2] & 15) : (addr[i / 2] >> 4);
+                        c[0] = c[1] = c[2] = nib * 17.0f;
+                    } else {
+                        a = 0;
+                    }
+                    break;
+                case G_IM_FMT_CI:
+                    if (tlut == NULL) {
+                        a = 0;
+                    } else if (siz == G_IM_SIZ_8b) {
+                        rgba16(tlut + addr[i] * 2, c, &a);
+                    } else if (siz == G_IM_SIZ_4b) {
+                        uint8_t nib = (i & 1) ? (addr[i / 2] & 15) : (addr[i / 2] >> 4);
+                        rgba16(tlut + nib * 2, c, &a);
+                    } else {
+                        a = 0;
+                    }
+                    break;
+                default:
+                    a = 0;
+                    break;
+            }
+            sum[0] += c[0] * a;
+            sum[1] += c[1] * a;
+            sum[2] += c[2] * a;
+            weight += a;
+        }
+    }
+    bool ok = weight > texels * 0.1;
+    for (int k = 0; k < 3; k++) {
+        rgb[k] = ok ? (float) (sum[k] / weight) : 255.0f;
+    }
+    if (sNumTex < (int) (sizeof(sTexCache) / sizeof(sTexCache[0]))) {
+        struct TexColor *t = &sTexCache[sNumTex++];
+        t->addr = addr; t->fmt = fmt; t->siz = siz; t->w = w; t->h = h; t->tlut = tlut; t->ok = ok;
+        memcpy(t->rgb, rgb, sizeof(t->rgb));
+    }
+    return ok;
+}
+
+// ---- walking the level's display lists ------------------------------------------------------
+
+#define OP(g) ((uint8_t) ((g)->words.w0 >> 24))
+#define W0(g, pos, width) ((uint32_t) (((g)->words.w0 >> (pos)) & ((1u << (width)) - 1)))
+#define W1(g, pos, width) ((uint32_t) (((g)->words.w1 >> (pos)) & ((1u << (width)) - 1)))
+
+struct DlState {
+    Vtx slots[64];
+    float penalty;
+    uint32_t geometryMode;
+    bool textured, shaded;
+    const uint8_t *timg; int timgSiz;          // G_SETTIMG
+    const uint8_t *loaded; int loadedBytes;    // what was last loaded into texture memory
+    const uint8_t *tlut;
+    int fmt, siz, w, h;                        // the render tile
+};
+
+static int bytes_for(int siz, int texels) {
+    switch (siz) {
+        case G_IM_SIZ_4b: return (texels + 1) / 2;
+        case G_IM_SIZ_8b: return texels;
+        case G_IM_SIZ_16b: return texels * 2;
+        default: return texels * 4;
+    }
+}
+
+static void add_tri(struct DlState *st, const Vtx *a, const Vtx *b, const Vtx *c) {
+    const Vtx *v[3] = { a, b, c };
+    struct VisTri t;
+    for (int i = 0; i < 3; i++) {
+        for (int k = 0; k < 3; k++) {
+            t.v[i * 3 + k] = v[i]->v.ob[k];
+        }
+    }
+    float e1[3], e2[3];
+    for (int k = 0; k < 3; k++) {
+        e1[k] = t.v[3 + k] - t.v[k];
+        e2[k] = t.v[6 + k] - t.v[k];
+    }
+    t.n[0] = e1[1] * e2[2] - e1[2] * e2[1];
+    t.n[1] = e1[2] * e2[0] - e1[0] * e2[2];
+    t.n[2] = e1[0] * e2[1] - e1[1] * e2[0];
+    float len = sqrtf(t.n[0] * t.n[0] + t.n[1] * t.n[1] + t.n[2] * t.n[2]);
+    if (len < 1e-3f) {
+        return;
+    }
+    for (int k = 0; k < 3; k++) {
+        t.n[k] /= len;
+    }
+    float tex[3] = { 255, 255, 255 }, shade[3] = { 255, 255, 255 };
+    bool haveTex = false;
+    if (st->textured && st->loaded != NULL && st->w > 0 && st->h > 0) {
+        int texels = st->w * st->h;
+        // Never read past what was loaded (the texture's own array).
+        while (texels > 1 && bytes_for(st->siz, texels) > st->loadedBytes) {
+            texels /= 2;
+        }
+        int w = st->w, h = texels / (st->w > 0 ? st->w : 1);
+        if (h < 1) { w = texels; h = 1; }
+        haveTex = texture_color(st->loaded, st->fmt, st->siz, w, h, st->fmt == G_IM_FMT_CI ? st->tlut : NULL, tex);
+    }
+    if (st->shaded && !(st->geometryMode & G_LIGHTING)) {
+        for (int k = 0; k < 3; k++) {
+            shade[k] = (a->v.cn[k] + b->v.cn[k] + c->v.cn[k]) / 3.0f;
+        }
+    }
+    t.mat = st->textured ? named_material(st->loaded) : 0;
+    if (!haveTex && t.mat == 0 && !(st->shaded && !(st->geometryMode & G_LIGHTING))) {
+        return;  // no idea what it is
+    }
+    for (int k = 0; k < 3; k++) {
+        t.rgb[k] = tex[k] * shade[k] / 255.0f;
+    }
+    t.penalty = st->penalty;
+    if (sNumVis == sCapVis) {
+        int cap = sCapVis ? sCapVis * 2 : 4096;
+        struct VisTri *grown = realloc(sVis, sizeof(*sVis) * (size_t) cap);
+        if (grown == NULL) {
+            return;
+        }
+        sVis = grown;
+        sCapVis = cap;
+    }
+    int idx = sNumVis++;
+    sVis[idx] = t;
+    float lo[3], hi[3];
+    for (int k = 0; k < 3; k++) {
+        lo[k] = fminf(t.v[k], fminf(t.v[3 + k], t.v[6 + k]));
+        hi[k] = fmaxf(t.v[k], fmaxf(t.v[3 + k], t.v[6 + k]));
+    }
+    int b0[3], b1[3];
+    for (int k = 0; k < 3; k++) {
+        b0[k] = (int) floorf(lo[k] / BIN);
+        b1[k] = (int) floorf(hi[k] / BIN);
+    }
+    if ((int64_t) (b1[0] - b0[0] + 1) * (b1[1] - b0[1] + 1) * (b1[2] - b0[2] + 1) > 4096) {
+        return;  // enormous (a sky dome?): not ground anyway
+    }
+    for (int x = b0[0]; x <= b1[0]; x++) {
+        for (int y = b0[1]; y <= b1[1]; y++) {
+            for (int z = b0[2]; z <= b1[2]; z++) {
+                bin_add(x, y, z, idx);
+            }
+        }
+    }
+}
+
+static bool cc_uses(uint32_t a, uint32_t b, uint32_t c, uint32_t d, uint32_t what) {
+    return a == what || b == what || c == what || d == what;
+}
+
+static void walk(struct DlState *st, const Gfx *dl, int depth) {
+    if (dl == NULL || depth > 16) {
+        return;
+    }
+    for (int guard = 0; guard < 200000; guard++, dl++) {
+        uint8_t op = OP(dl);
+        if (op == (uint8_t) G_VTX) {
+            int n = (int) W0(dl, 12, 8), v0 = (int) W0(dl, 1, 7) - n;
+            const Vtx *src = segmented_to_virtual((const void *) dl->words.w1);
+            if (v0 >= 0 && n > 0 && v0 + n <= 64 && src != NULL) {
+                memcpy(&st->slots[v0], src, sizeof(Vtx) * (size_t) n);
+            }
+        } else if (op == (uint8_t) G_TRI1) {
+            add_tri(st, &st->slots[(W0(dl, 16, 8) / 2) & 63], &st->slots[(W0(dl, 8, 8) / 2) & 63], &st->slots[(W0(dl, 0, 8) / 2) & 63]);
+        } else if (op == (uint8_t) G_TRI2) {
+            add_tri(st, &st->slots[(W0(dl, 16, 8) / 2) & 63], &st->slots[(W0(dl, 8, 8) / 2) & 63], &st->slots[(W0(dl, 0, 8) / 2) & 63]);
+            add_tri(st, &st->slots[(W1(dl, 16, 8) / 2) & 63], &st->slots[(W1(dl, 8, 8) / 2) & 63], &st->slots[(W1(dl, 0, 8) / 2) & 63]);
+        } else if (op == (uint8_t) G_DL) {
+            const Gfx *sub = segmented_to_virtual((const void *) dl->words.w1);
+            walk(st, sub, depth + 1);
+            if (W0(dl, 16, 1) != 0) {
+                return;  // a branch: never comes back
+            }
+        } else if (op == (uint8_t) G_ENDDL) {
+            return;
+        } else if (op == (uint8_t) G_GEOMETRYMODE) {
+            st->geometryMode = (st->geometryMode & W0(dl, 0, 24)) | (uint32_t) dl->words.w1;
+        } else if (op == (uint8_t) G_SETCOMBINE) {
+            // First cycle's colour inputs: (a - b) * c + d
+            uint32_t a = W0(dl, 20, 4), b = W1(dl, 28, 4), c = W0(dl, 15, 5), d = W1(dl, 15, 3);
+            st->textured = cc_uses(a, b, c, d, G_CCMUX_TEXEL0) || c == G_CCMUX_TEXEL0_ALPHA;
+            st->shaded = cc_uses(a, b, c, d, G_CCMUX_SHADE);
+        } else if (op == (uint8_t) G_SETTIMG) {
+            st->timg = segmented_to_virtual((const void *) dl->words.w1);
+            st->timgSiz = (int) W0(dl, 19, 2);
+        } else if (op == (uint8_t) G_LOADBLOCK) {
+            st->loaded = st->timg;
+            st->loadedBytes = bytes_for(st->timgSiz, (int) W1(dl, 12, 12) + 1);
+        } else if (op == (uint8_t) G_LOADTILE) {
+            int w = (int) ((W1(dl, 12, 12) >> 2) - (W0(dl, 12, 12) >> 2) + 1);
+            int h = (int) ((W1(dl, 0, 12) >> 2) - (W0(dl, 0, 12) >> 2) + 1);
+            st->loaded = st->timg;
+            st->loadedBytes = bytes_for(st->timgSiz, w * h);
+        } else if (op == (uint8_t) G_LOADTLUT) {
+            st->tlut = st->timg;
+        } else if (op == (uint8_t) G_SETTILE) {
+            if (W1(dl, 24, 3) == G_TX_RENDERTILE) {
+                st->fmt = (int) W0(dl, 21, 3);
+                st->siz = (int) W0(dl, 19, 2);
+            }
+        } else if (op == (uint8_t) G_SETTILESIZE) {
+            if (W1(dl, 24, 3) == G_TX_RENDERTILE) {
+                st->w = (int) ((W1(dl, 12, 12) >> 2) - (W0(dl, 12, 12) >> 2) + 1);
+                st->h = (int) ((W1(dl, 0, 12) >> 2) - (W0(dl, 0, 12) >> 2) + 1);
+            }
+        }
+    }
+}
+
+static void walk_nodes(struct DlState *st, struct GraphNode *first, int depth) {
+    if (first == NULL || depth > 64) {
+        return;
+    }
+    struct GraphNode *n = first;
+    do {
+        switch (n->type) {
+            case GRAPH_NODE_TYPE_OBJECT_PARENT:
+            case GRAPH_NODE_TYPE_OBJECT:
+            case GRAPH_NODE_TYPE_TRANSLATION_ROTATION:
+            case GRAPH_NODE_TYPE_TRANSLATION:
+            case GRAPH_NODE_TYPE_ROTATION:
+            case GRAPH_NODE_TYPE_SCALE:
+            case GRAPH_NODE_TYPE_SCALE_XYZ:
+            case GRAPH_NODE_TYPE_BILLBOARD:
+            case GRAPH_NODE_TYPE_ANIMATED_PART:
+            case GRAPH_NODE_TYPE_HELD_OBJ:
+            case GRAPH_NODE_TYPE_GENERATED_LIST:
+            case GRAPH_NODE_TYPE_BACKGROUND:
+                break;
+            case GRAPH_NODE_TYPE_DISPLAY_LIST: {
+                struct GraphNodeDisplayList *dn = (struct GraphNodeDisplayList *) n;
+                // Each list starts from SM64's usual state (textured, vertex coloured).
+                st->geometryMode = 0;
+                st->textured = true;
+                st->shaded = true;
+                int layer = (n->flags >> 8) & 0xFF;
+                st->penalty = (layer == LAYER_OPAQUE || layer == LAYER_FORCE || layer == LAYER_OPAQUE_INTER) ? 0.0f
+                            : (layer == LAYER_OPAQUE_DECAL || layer == LAYER_ALPHA) ? 20.0f * 20.0f : 40.0f * 40.0f;
+                walk(st, segmented_to_virtual(dn->displayList), 0);
+                walk_nodes(st, n->children, depth + 1);
+                break;
+            }
+            default:
+                walk_nodes(st, n->children, depth + 1);
+                break;
+        }
+        n = n->next;
+    } while (n != first && n != NULL);
+}
+
+void mc_material_scan(void) {
+    forget();
+    if (gCurrentArea == NULL || gCurrentArea->root == NULL) {
+        return;
+    }
+    static struct DlState st;
+    memset(&st, 0, sizeof(st));
+    walk_nodes(&st, &gCurrentArea->root->node, 0);
+    printf("[MarioCraft] looked at %d visible triangles (%d textures) for what the level is made of\n", sNumVis, sNumTex);
+}
+
+int mc_material_visible_count(void) {
+    return sNumVis;
+}
+
+// ---- colour to material ---------------------------------------------------------------------
+
+static int from_color(const float *rgb, float ny, u16 terrain) {
+    float r = rgb[0], g = rgb[1], b = rgb[2];
+    float mx = fmaxf(r, fmaxf(g, b)), mn = fminf(r, fminf(g, b));
+    float v = mx / 255.0f, s = mx > 1.0f ? (mx - mn) / mx : 0.0f;
+    float h = 0.0f;
+    if (mx - mn > 1e-3f) {
+        if (mx == r)      h = 60.0f * fmodf((g - b) / (mx - mn) + 6.0f, 6.0f);
+        else if (mx == g) h = 60.0f * ((b - r) / (mx - mn) + 2.0f);
+        else              h = 60.0f * ((r - g) / (mx - mn) + 4.0f);
+    }
+    bool snowy = (terrain & TERRAIN_MASK) == TERRAIN_SNOW || (terrain & TERRAIN_MASK) == TERRAIN_SLIDE;
+    bool spooky = (terrain & TERRAIN_MASK) == TERRAIN_SPOOKY;
+    if (s < 0.16f || v < 0.10f) {
+        // Greys: snow if it's bright in a snowy level, otherwise stone.
+        if (snowy && v > 0.70f) {
+            return M_SNOW;
+        }
+        return M_STONE;
+    }
+    if (h >= 75.0f && h < 170.0f) {
+        return ny > -0.2f ? M_GRASS : M_DIRT;   // green: grass
+    }
+    if (h >= 170.0f && h < 260.0f) {
+        // Blue: ice only where it's icy; otherwise stone (castle walls, tiles, crystals... are
+        // often a little blue, and used to come out as ice).
+        return snowy ? M_ICE : M_STONE;
+    }
+    if (h >= 260.0f && h < 330.0f) {
+        return M_STONE;                          // purple, pink: stone
+    }
+    if (h >= 330.0f || h < 14.0f) {
+        // Red. Outdoors it's earth (Bob-omb Battlefield's reddish pits and cliffs are dirt);
+        // indoors, a strong red floor is carpet and red walls are bricks.
+        if (s < 0.30f) {
+            return M_STONE;
+        }
+        u16 t = terrain & TERRAIN_MASK;
+        if (t == TERRAIN_GRASS || t == TERRAIN_SAND || t == TERRAIN_SNOW || t == TERRAIN_SLIDE) {
+            return M_DIRT;
+        }
+        bool trueRed = (h >= 340.0f || h < 8.0f) && s > 0.55f;
+        if (ny > 0.95f) {
+            return trueRed ? M_RED_WOOL : M_DIRT;
+        }
+        return M_BRICKS;
+    }
+    if (h >= 40.0f && h < 75.0f) {
+        // Yellow: sand (and pale sandy paths); dark olive is dirt.
+        return v > 0.45f ? M_SAND : M_DIRT;
+    }
+    // Orange-brown: wood in haunted houses, a light warm brown is sand, otherwise dirt.
+    if (spooky) {
+        return M_PLANKS;
+    }
+    if (v > 0.75f && s < 0.45f) {
+        return M_SAND;
+    }
+    return M_DIRT;
+}
+
+// ---- matching a collision triangle with what's drawn there ----------------------------------
+
+static float point_tri_dist2(const float *p, const float *v) {
+    // Closest point on triangle (Ericson, Real-Time Collision Detection 5.1.5).
+    const float *a = v, *b = v + 3, *c = v + 6;
+    float ab[3], ac[3], ap[3];
+    for (int k = 0; k < 3; k++) { ab[k] = b[k] - a[k]; ac[k] = c[k] - a[k]; ap[k] = p[k] - a[k]; }
+    float d1 = ab[0] * ap[0] + ab[1] * ap[1] + ab[2] * ap[2];
+    float d2 = ac[0] * ap[0] + ac[1] * ap[1] + ac[2] * ap[2];
+    float q[3];
+    if (d1 <= 0 && d2 <= 0) { memcpy(q, a, 12); goto done; }
+    float bp[3];
+    for (int k = 0; k < 3; k++) bp[k] = p[k] - b[k];
+    float d3 = ab[0] * bp[0] + ab[1] * bp[1] + ab[2] * bp[2];
+    float d4 = ac[0] * bp[0] + ac[1] * bp[1] + ac[2] * bp[2];
+    if (d3 >= 0 && d4 <= d3) { memcpy(q, b, 12); goto done; }
+    float vc = d1 * d4 - d3 * d2;
+    if (vc <= 0 && d1 >= 0 && d3 <= 0) {
+        float t = d1 / (d1 - d3);
+        for (int k = 0; k < 3; k++) q[k] = a[k] + t * ab[k];
+        goto done;
+    }
+    float cp[3];
+    for (int k = 0; k < 3; k++) cp[k] = p[k] - c[k];
+    float d5 = ab[0] * cp[0] + ab[1] * cp[1] + ab[2] * cp[2];
+    float d6 = ac[0] * cp[0] + ac[1] * cp[1] + ac[2] * cp[2];
+    if (d6 >= 0 && d5 <= d6) { memcpy(q, c, 12); goto done; }
+    float vb = d5 * d2 - d1 * d6;
+    if (vb <= 0 && d2 >= 0 && d6 <= 0) {
+        float t = d2 / (d2 - d6);
+        for (int k = 0; k < 3; k++) q[k] = a[k] + t * ac[k];
+        goto done;
+    }
+    float va = d3 * d6 - d5 * d4;
+    if (va <= 0 && (d4 - d3) >= 0 && (d5 - d6) >= 0) {
+        float t = (d4 - d3) / ((d4 - d3) + (d5 - d6));
+        for (int k = 0; k < 3; k++) q[k] = b[k] + t * (c[k] - b[k]);
+        goto done;
+    }
+    {
+        float denom = 1.0f / (va + vb + vc);
+        float vv = vb * denom, ww = vc * denom;
+        for (int k = 0; k < 3; k++) q[k] = a[k] + ab[k] * vv + ac[k] * ww;
+    }
+done:;
+    float dx = p[0] - q[0], dy = p[1] - q[1], dz = p[2] - q[2];
+    return dx * dx + dy * dy + dz * dz;
+}
+
+// The visible triangle nearest a point, facing about the same way (or -1).
+static int nearest_visible(const float *p, const float *n) {
+    const float reach = 60.0f;  // further than this: it's not what's drawn here
+    int b0[3], b1[3];
+    for (int k = 0; k < 3; k++) {
+        b0[k] = (int) floorf((p[k] - reach) / BIN);
+        b1[k] = (int) floorf((p[k] + reach) / BIN);
+    }
+    int best = -1;
+    float bestD = reach * reach;
+    for (int x = b0[0]; x <= b1[0]; x++) {
+        for (int y = b0[1]; y <= b1[1]; y++) {
+            for (int z = b0[2]; z <= b1[2]; z++) {
+                struct Bin *b = &sBins[bin_hash(x, y, z)];
+                for (int i = 0; i < b->n; i++) {
+                    const struct VisTri *t = &sVis[b->idx[i]];
+                    float dot = t->n[0] * n[0] + t->n[1] * n[1] + t->n[2] * n[2];
+                    if (fabsf(dot) < 0.6f) {
+                        continue;
+                    }
+                    float d = point_tri_dist2(p, t->v) + t->penalty;
+                    if (d < bestD) {
+                        bestD = d;
+                        best = b->idx[i];
+                    }
+                }
+            }
+        }
+    }
+    return best;
+}
+
+// What a collision triangle (SM64 units, normal n) is made of, judged by what's drawn there; 0 if
+// nothing drawn there is close enough to tell.
+int mc_material_for(const float *v, const float *n, u16 terrain) {
+    if (sNumVis == 0) {
+        return 0;
+    }
+    // Look at a few points across the triangle and let them vote.
+    float pts[4][3];
+    for (int k = 0; k < 3; k++) {
+        float cen = (v[k] + v[3 + k] + v[6 + k]) / 3.0f;
+        pts[0][k] = cen;
+        pts[1][k] = (cen + v[k]) * 0.5f;
+        pts[2][k] = (cen + v[3 + k]) * 0.5f;
+        pts[3][k] = (cen + v[6 + k]) * 0.5f;
+    }
+    int votes[M_COUNT] = { 0 }, first = 0;
+    for (int i = 0; i < 4; i++) {
+        int t = nearest_visible(pts[i], n);
+        if (t < 0) {
+            continue;
+        }
+        int m = sVis[t].mat > 0 ? sVis[t].mat : from_color(sVis[t].rgb, n[1], terrain);
+        // The pale blue cobbles are icy rock in snowy levels, and plain cobblestone elsewhere
+        // (Bob-omb Battlefield's pond edge).
+        u16 tt = terrain & TERRAIN_MASK;
+        if (m == M_PACKED_ICE && tt != TERRAIN_SNOW && tt != TERRAIN_SLIDE) {
+            m = M_COBBLE;
+        }
+        if (m > 0 && m < M_COUNT) {
+            votes[m] += (i == 0) ? 2 : 1;  // the middle counts double
+            if (first == 0) first = m;
+        }
+    }
+    int best = first;
+    for (int m = 1; m < M_COUNT; m++) {
+        if (votes[m] > votes[best]) {
+            best = m;
+        }
+    }
+    return best;
+}
diff --git a/src/pc/mariocraft/mc_moving.c b/src/pc/mariocraft/mc_moving.c
new file mode 100644
index 000000000..8f1c2145e
--- /dev/null
+++ b/src/pc/mariocraft/mc_moving.c
@@ -0,0 +1,213 @@
+// MarioCraft: SM64's moving and solid objects, for Minecraft, every game frame.
+//
+// The level's own shape goes to Minecraft once (mc_collision.c). Objects are different: platforms
+// and elevators move, seesaws tilt, bridges fall, crates and "!" boxes come and go, gates open,
+// Whomps and Eyerok's hands are things to stand on. SM64 rebuilds their collision every frame;
+// here the triangles near Steve go into a table in the shared memory every game frame, each with
+// the object it belongs to and where that object is (its transform). Minecraft (MovingSurfaces in
+// SkyCraft) collides Steve with them like with the level, and when he stands on one it carries
+// him along with it: what that object did since the last tick happens to his feet too.
+//
+// The level's vanish-cap walls come this way too, so they are solid for Steve until Mario has
+// the vanish cap (the level's export leaves them out).
+
+#include "mariocraft_internal.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#include <windows.h>
+#define MC_BARRIER() MemoryBarrier()
+#else
+#define MC_BARRIER() __sync_synchronize()
+#endif
+
+#include "sm64.h"
+#include "game/memory.h"
+#include "game/area.h"
+#include "game/object_helpers.h"
+#include "game/object_list_processor.h"
+#include "engine/surface_load.h"
+#include "surface_terrains.h"
+
+#define MV_MAX_OBJECTS 256
+#define MV_MAX_TRIS    4096
+#define MV_RADIUS      2500.0f   // SM64 units around Steve (25 blocks), sideways and up/down
+#define OFF_MV_OBJECTS 0x40u
+#define OFF_MV_TRIS    0x6000u
+#define MV_NO_OBJECT   0xFFFFu
+#define MV_TRI_WALKABLE (1u << 4) // the collision ring's TRI_WALKABLE
+
+#pragma pack(push, 1)
+struct MovingHeader {
+    uint32_t seq;          // seqlock: odd while writing
+    uint32_t numObjects;
+    uint32_t numTris;
+    uint32_t worldId;
+    double   originX;      // Minecraft x of the area's SM64 x = 0
+    int32_t  shiftY;       // mc_origin_y_units: Minecraft y = (SM64 y - shiftY) / 100
+    uint32_t frame;        // counts game frames
+};
+struct MovingObject {
+    uint32_t id;           // the object's slot in SM64's object pool, plus one
+    uint32_t gen;          // changes when another object takes the slot
+    float    m[16];        // where it is: SM64 point (row) x m = world point, SM64 units
+    uint32_t pad[2];
+};
+struct MovingTri {
+    float    v[9];         // SM64 units
+    uint16_t object;       // index into the objects, or MV_NO_OBJECT
+    uint16_t flags;        // MV_TRI_WALKABLE
+};
+#pragma pack(pop)
+_Static_assert(sizeof(struct MovingHeader) == 0x20, "MovingHeader layout");
+_Static_assert(sizeof(struct MovingObject) == 80, "MovingObject layout");
+_Static_assert(sizeof(struct MovingTri) == 40, "MovingTri layout");
+_Static_assert(OFF_MV_OBJECTS + MV_MAX_OBJECTS * 80 <= OFF_MV_TRIS, "moving objects fit");
+_Static_assert(OFF_MV_TRIS + MV_MAX_TRIS * 40 <= MOVING_BYTES, "moving tris fit");
+
+static bool sEnabled = false;
+static uint32_t sFrame = 0;
+static int16_t sSlot[OBJECT_POOL_CAPACITY];  // object pool index -> table index this frame
+
+// The level's own vanish-cap walls (static), found again whenever the level's collision changes.
+static struct Surface **sVanish = NULL;
+static int sNumVanish = 0, sCapVanish = 0;
+static uint32_t sVanishGen = 0xFFFFFFFFu;
+
+void mc_moving_enable(bool enabled) {
+    sEnabled = enabled;
+}
+
+static bool near_point(const struct Surface *s, const float *c) {
+    float lo[3], hi[3];
+    for (int k = 0; k < 3; k++) {
+        float a = s->vertex1[k], b = s->vertex2[k], d = s->vertex3[k];
+        lo[k] = fminf(a, fminf(b, d));
+        hi[k] = fmaxf(a, fmaxf(b, d));
+        if (hi[k] < c[k] - MV_RADIUS || lo[k] > c[k] + MV_RADIUS) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void find_vanish_walls(void) {
+    if (sVanishGen == gStaticSurfacesGeneration) {
+        return;
+    }
+    sVanishGen = gStaticSurfacesGeneration;
+    sNumVanish = 0;
+    struct GrowingArray *pool = surface_get_static_pool();
+    growing_array_for_each_(pool, struct Surface, s) {
+        if (s == NULL || s->type != SURFACE_VANISH_CAP_WALLS) {
+            continue;
+        }
+        if (sNumVanish == sCapVanish) {
+            int cap = sCapVanish ? sCapVanish * 2 : 64;
+            struct Surface **grown = realloc(sVanish, sizeof(*sVanish) * (size_t) cap);
+            if (grown == NULL) {
+                break;
+            }
+            sVanish = grown;
+            sCapVanish = cap;
+        }
+        sVanish[sNumVanish++] = s;
+    }
+}
+
+static void put_tri(struct MovingTri *out, const struct Surface *s, uint16_t object, u16 terrain) {
+    const s16 *vs[3] = { s->vertex1, s->vertex2, s->vertex3 };
+    for (int k = 0; k < 9; k++) {
+        out->v[k] = (float) vs[k / 3][k % 3];
+    }
+    out->object = object;
+    out->flags = mc_surface_walkable(s, terrain) ? MV_TRI_WALKABLE : 0;
+}
+
+void mc_moving_write(uint32_t worldId, struct MarioState *m) {
+    if (!sEnabled || gMcShm == NULL || m == NULL || m->marioObj == NULL) {
+        return;
+    }
+    uint8_t *base = gMcShm + OFF_MOVING;
+    struct MovingHeader *h = (struct MovingHeader *) base;
+    struct MovingObject *objs = (struct MovingObject *) (base + OFF_MV_OBJECTS);
+    struct MovingTri *tris = (struct MovingTri *) (base + OFF_MV_TRIS);
+    volatile uint32_t *seq = &h->seq;
+    uint32_t s0 = *seq;
+    *seq = s0 | 1;  // odd: writing
+    MC_BARRIER();
+
+    for (int i = 0; i < OBJECT_POOL_CAPACITY; i++) {
+        sSlot[i] = -1;
+    }
+    u16 terrain = gCurrentArea != NULL ? gCurrentArea->terrainType : TERRAIN_STONE;
+    bool vanishCap = (m->flags & MARIO_VANISH_CAP) != 0;
+    float c[3] = { m->pos[0], m->pos[1], m->pos[2] };
+    uint32_t numObjects = 0, numTris = 0;
+
+    // Objects' collision: rebuilt every frame (moving), and loaded once (static object collision).
+    struct GrowingArray *pools[2] = { surface_get_dynamic_pool(), surface_get_soc_pool() };
+    for (int p = 0; p < 2 && numTris < MV_MAX_TRIS; p++) {
+        growing_array_for_each_(pools[p], struct Surface, s) {
+            if (numTris >= MV_MAX_TRIS) {
+                break;
+            }
+            if (s == NULL) {
+                continue;
+            }
+            if (mc_surface_skipped(s)) {
+                bool vanishWall = s->type == SURFACE_VANISH_CAP_WALLS && !(s->flags & SURFACE_FLAG_INTANGIBLE);
+                if (!vanishWall || vanishCap) {
+                    continue;
+                }
+            }
+            if (!near_point(s, c)) {
+                continue;
+            }
+            uint16_t slot = MV_NO_OBJECT;
+            struct Object *o = s->object;
+            if (o != NULL && o >= gObjectPool && o < gObjectPool + OBJECT_POOL_CAPACITY) {
+                int idx = (int) (o - gObjectPool);
+                if (sSlot[idx] < 0 && numObjects < MV_MAX_OBJECTS) {
+                    struct MovingObject *mo = &objs[numObjects];
+                    Mat4 mtx;
+                    obj_apply_scale_to_matrix(o, mtx, o->transform);
+                    mo->id = (uint32_t) idx + 1;
+                    mo->gen = (uint32_t) (uintptr_t) o->behavior;
+                    for (int k = 0; k < 16; k++) {
+                        mo->m[k] = mtx[k / 4][k % 4];
+                    }
+                    mo->pad[0] = mo->pad[1] = 0;
+                    sSlot[idx] = (int16_t) numObjects++;
+                }
+                if (sSlot[idx] >= 0) {
+                    slot = (uint16_t) sSlot[idx];
+                }
+            }
+            put_tri(&tris[numTris++], s, slot, terrain);
+        }
+    }
+
+    // The level's vanish-cap walls: solid until Mario has the vanish cap.
+    if (!vanishCap) {
+        find_vanish_walls();
+        for (int i = 0; i < sNumVanish && numTris < MV_MAX_TRIS; i++) {
+            if (near_point(sVanish[i], c)) {
+                put_tri(&tris[numTris++], sVanish[i], MV_NO_OBJECT, terrain);
+            }
+        }
+    }
+
+    h->numObjects = numObjects;
+    h->numTris = numTris;
+    h->worldId = worldId;
+    h->originX = mc_origin_x(worldId);
+    h->shiftY = mc_origin_y_units(worldId);
+    h->frame = ++sFrame;
+    MC_BARRIER();
+    *seq = (s0 | 1) + 1;  // even: done
+}
diff --git a/src/pc/mariocraft/mc_music.c b/src/pc/mariocraft/mc_music.c
new file mode 100644
index 000000000..3f1ea934c
--- /dev/null
+++ b/src/pc/mariocraft/mc_music.c
@@ -0,0 +1,155 @@
+// MarioCraft: C418's music instead of SM64's.
+//
+// SM64 still decides when music changes (entering a level, a cap, a boss, a race...). Each of its
+// background tracks gets a C418 one that fits the level, and Minecraft plays it (MarioSounds.java,
+// from the player's own Minecraft), while SM64's own background music is muted (pc_main.c asks
+// mariocraft_music_replaced). Short jingles (a star, a key, a secret) stay SM64's. Without
+// Minecraft connected, SM64's music plays as it always did.
+
+#include "mariocraft.h"
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+
+#include "sm64.h"
+#include "seq_ids.h"
+#include "level_table.h"
+#include "audio/external.h"
+#include "game/level_update.h"
+#include "game/area.h"
+
+#include "mariocraft_internal.h"
+
+#ifdef _WIN32
+#include <windows.h>
+#define MC_BARRIER() MemoryBarrier()
+#else
+#define MC_BARRIER() __sync_synchronize()
+#endif
+
+#define OFF_MUSIC_SEQ (0x11800ull + 0x600ull)  // Proto.LB_MUSIC_SEQ / LB_MUSIC
+#define OFF_MUSIC     (0x11800ull + 0x604ull)
+#define MUSIC_BYTES   64
+
+static uint32_t sSeq = 0;
+static const char *sTrack = "";
+static bool sReplaced = false;
+
+// Events that take over the background music: their own track whatever the level.
+static const char *event_track(u8 seq) {
+    switch (seq) {
+        case SEQ_MENU_TITLE_SCREEN:         return "menu/moog_city_2";
+        case SEQ_MENU_FILE_SELECT:          return "menu/mutation";
+        case SEQ_MENU_STAR_SELECT:          return "menu/beginning_2";
+        case SEQ_EVENT_CUTSCENE_INTRO:      return "menu/floating_trees";
+        case SEQ_EVENT_POWERUP:             return "game/creative/dreiton";        // wing and vanish caps
+        case SEQ_EVENT_METAL_CAP:           return "game/nether/concrete_halls";
+        case SEQ_EVENT_BOSS:                return "game/end/boss";                // King Bob-omb, Whomp King, Big Bully...
+        case SEQ_EVENT_RACE:                return "game/creative/aria_math";      // Koopa the Quick, the penguin, the slide
+        case SEQ_EVENT_MERRY_GO_ROUND:      return "game/creative/haunt_muskie";
+        case SEQ_EVENT_PIRANHA_PLANT:       return "game/subwoofer_lullaby";       // the sleeping lullaby
+        case SEQ_EVENT_ENDLESS_STAIRS:      return "game/haggstrom";
+        case SEQ_EVENT_KOOPA_MESSAGE:       return "game/end/boss";
+        case SEQ_LEVEL_BOSS_KOOPA:          return "game/end/boss";                // Bowser
+        case SEQ_LEVEL_BOSS_KOOPA_FINAL:    return "game/end/the_end";
+        case SEQ_EVENT_CUTSCENE_VICTORY:    return "game/minecraft";
+        case SEQ_EVENT_CUTSCENE_ENDING:     return "game/end/the_end";
+        case SEQ_EVENT_CUTSCENE_CREDITS:    return "game/end/alpha";
+        default:                            return NULL;
+    }
+}
+
+// Each level's own background music.
+static const char *level_track(s16 level) {
+    switch (level) {
+        case LEVEL_CASTLE_GROUNDS:   return "game/sweden";
+        case LEVEL_CASTLE:           return "game/clark";
+        case LEVEL_CASTLE_COURTYARD: return "game/wet_hands";
+        case LEVEL_BOB:              return "game/creative/biome_fest";
+        case LEVEL_WF:               return "game/living_mice";
+        case LEVEL_JRB:              return "game/water/shuniji";
+        case LEVEL_CCM:              return "game/mice_on_venus";
+        case LEVEL_BBH:              return "game/nether/dead_voxel";
+        case LEVEL_HMC:              return "game/subwoofer_lullaby";
+        case LEVEL_LLL:              return "game/nether/concrete_halls";
+        case LEVEL_SSL:              return "game/haggstrom";
+        case LEVEL_DDD:              return "game/water/dragon_fish";
+        case LEVEL_SL:               return "game/dry_hands";
+        case LEVEL_WDW:              return "game/water/axolotl";
+        case LEVEL_TTM:              return "game/creative/blind_spots";
+        case LEVEL_THI:              return "game/creative/biome_fest";
+        case LEVEL_TTC:              return "game/creative/aria_math";
+        case LEVEL_RR:               return "game/creative/taswell";
+        case LEVEL_BITDW:            return "game/nether/warmth";
+        case LEVEL_BITFS:            return "game/nether/ballad_of_the_cats";
+        case LEVEL_BITS:             return "game/end/alpha";
+        case LEVEL_BOWSER_1:
+        case LEVEL_BOWSER_2:         return "game/end/boss";
+        case LEVEL_BOWSER_3:         return "game/end/the_end";
+        case LEVEL_PSS:              return "game/creative/haunt_muskie";
+        case LEVEL_SA:               return "game/water/axolotl";
+        case LEVEL_WMOTR:            return "game/oxygene";
+        case LEVEL_TOTWC:            return "game/oxygene";
+        case LEVEL_COTMC:            return "game/key";
+        case LEVEL_VCUTM:            return "game/danny";
+        case LEVEL_ENDING:           return "game/end/the_end";
+        default:                     return NULL;
+    }
+}
+
+// Any other SM64 track, by kind (levels added by mods).
+static const char *kind_track(u8 seq) {
+    switch (seq) {
+        case SEQ_LEVEL_GRASS:         return "game/minecraft";
+        case SEQ_LEVEL_INSIDE_CASTLE: return "game/clark";
+        case SEQ_LEVEL_WATER:         return "game/water/shuniji";
+        case SEQ_LEVEL_HOT:           return "game/nether/concrete_halls";
+        case SEQ_LEVEL_SNOW:          return "game/mice_on_venus";
+        case SEQ_LEVEL_SLIDE:         return "game/creative/haunt_muskie";
+        case SEQ_LEVEL_SPOOKY:        return "game/nether/dead_voxel";
+        case SEQ_LEVEL_UNDERGROUND:   return "game/subwoofer_lullaby";
+        case SEQ_LEVEL_KOOPA_ROAD:    return "game/nether/warmth";
+        default:                      return NULL;
+    }
+}
+
+bool mariocraft_music_replaced(void) {
+    return sReplaced;
+}
+
+static void write_track(const char *track) {
+    if (gMcShm == NULL || strcmp(track, sTrack) == 0) {
+        return;
+    }
+    sTrack = track;
+    uint8_t name[MUSIC_BYTES];
+    memset(name, 0, sizeof(name));
+    size_t length = strlen(track);
+    memcpy(name, track, length < MUSIC_BYTES - 1 ? length : MUSIC_BYTES - 1);
+    volatile uint32_t *seq = (volatile uint32_t *) (gMcShm + OFF_MUSIC_SEQ);
+    sSeq += 2;
+    *seq = sSeq - 1;
+    MC_BARRIER();
+    memcpy(gMcShm + OFF_MUSIC, name, sizeof(name));
+    MC_BARRIER();
+    *seq = sSeq;
+}
+
+// Every game frame. `mcConnected`: Minecraft is in its world (it can play the music).
+void mc_music_update(bool mcConnected) {
+    u16 bg = get_current_background_music();
+    u8 seq = (u8) (bg & 0xFF);
+    const char *track = NULL;
+    if (bg != 0 && seq != 0) {
+        track = event_track(seq);
+        if (track == NULL) {
+            track = level_track(gCurrLevelNum);
+        }
+        if (track == NULL) {
+            track = kind_track(seq);
+        }
+    }
+    sReplaced = mcConnected && track != NULL;
+    write_track(mcConnected && track != NULL ? track : "");
+}
diff --git a/src/pc/mariocraft/mc_names.c b/src/pc/mariocraft/mc_names.c
new file mode 100644
index 000000000..d73577df6
--- /dev/null
+++ b/src/pc/mariocraft/mc_names.c
@@ -0,0 +1,199 @@
+// MarioCraft: what Mario's enemies are called, for Minecraft.
+//
+// Each enemy's stand-in in Minecraft is named after it (mc_actors.c), and every hit SM64 gives
+// Steve carries how it would kill him (mariocraft.c, IN_HURT_CAUSE): when Steve loses a life, the
+// chat says it like Minecraft's death messages do ("Steve was chomped by a Chain Chomp").
+
+#include "mariocraft_internal.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#include "sm64.h"
+#include "behavior_table.h"
+#include "object_fields.h"
+#include "game/object_list_processor.h"
+
+struct EnemyName {
+    const char *behavior;  // SM64's behavior name
+    const char *name;      // what Minecraft calls it
+    const char *death;     // "<player> ..." when it finishes Steve off
+};
+
+static const struct EnemyName sNames[] = {
+    { "bhvGoomba",                     "Goomba",            "was bumped off by a Goomba" },
+    { "bhvGoombaTripletSpawner",       "Goomba",            "was bumped off by a Goomba" },
+    { "bhvBobomb",                     "Bob-omb",           "was blown up by a Bob-omb" },
+    { "bhvKingBobomb",                 "King Bob-omb",      "was thrown out by King Bob-omb" },
+    { "bhvChainChomp",                 "Chain Chomp",       "was chomped by a Chain Chomp" },
+    { "bhvKoopa",                      "Koopa Troopa",      "was kicked around by a Koopa Troopa" },
+    { "bhvPiranhaPlant",               "Piranha Plant",     "was bitten by a Piranha Plant" },
+    { "bhvFirePiranhaPlant",           "Fire Piranha Plant", "was burnt by a Fire Piranha Plant" },
+    { "bhvThwomp",                     "Thwomp",            "was squashed by a Thwomp" },
+    { "bhvThwomp2",                    "Thwomp",            "was squashed by a Thwomp" },
+    { "bhvSmallWhomp",                 "Whomp",             "was flattened by a Whomp" },
+    { "bhvWhompKingBoss",              "King Whomp",        "was flattened by King Whomp" },
+    { "bhvSmallBully",                 "Bully",             "was shoved off by a Bully" },
+    { "bhvBigBully",                   "Big Bully",         "was shoved off by a Big Bully" },
+    { "bhvBigBullyWithMinions",        "Big Bully",         "was shoved off by a Big Bully" },
+    { "bhvSmallChillBully",            "Chill Bully",       "was shoved off by a Chill Bully" },
+    { "bhvBigChillBully",              "Big Chill Bully",   "was shoved off by a Big Chill Bully" },
+    { "bhvBoo",                        "Boo",               "was spooked to death by a Boo" },
+    { "bhvGhostHuntBoo",               "Boo",               "was spooked to death by a Boo" },
+    { "bhvBooWithCage",                "Big Boo",           "was spooked to death by Big Boo" },
+    { "bhvMerryGoRoundBoo",            "Boo",               "was spooked to death by a Boo" },
