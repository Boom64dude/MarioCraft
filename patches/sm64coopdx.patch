diff --git a/src/pc/network/packets/packet_mariocraft.c b/src/pc/network/packets/packet_mariocraft.c
new file mode 100644
index 000000000..7babf6eac
--- /dev/null
+++ b/src/pc/network/packets/packet_mariocraft.c
@@ -0,0 +1,61 @@
+#include <stdio.h>
+#include <string.h>
+#include "../network.h"
+#include "pc/debuglog.h"
+
+// MarioCraft: each player says, about once a second, whether they're playing as Steve and whether
+// their Minecraft is in the shared world; the host also sends its Minecraft world's address (an
+// e4mc link) so everyone's Minecraft can join it (src/pc/mariocraft/mc_lobby.c). A Steve also sends
+// their skin's face, for everyone's player list and star select (mc_steve.c).
+
+#define MARIOCRAFT_LINK_MAX 255
+#define MARIOCRAFT_FACE_PIXELS 64
+#define MARIOCRAFT_PF_FACE (1u << 2)
+
+extern void mariocraft_lobby_received(u8 globalIndex, u8 flags, const char *link, const u32 *face);
+
+void network_send_mariocraft(u8 flags, const char *link, const u32 *face) {
+    if (gNetworkPlayerLocal == NULL) { return; }
+    u8 globalIndex = gNetworkPlayerLocal->globalIndex;
+    u8 length = 0;
+    if (link != NULL) {
+        size_t n = strlen(link);
+        length = (u8) (n > MARIOCRAFT_LINK_MAX ? MARIOCRAFT_LINK_MAX : n);
+    }
+    if (face == NULL) { flags &= (u8) ~MARIOCRAFT_PF_FACE; }
+    struct Packet p = { 0 };
+    packet_init(&p, PACKET_MARIOCRAFT, false, PLMT_NONE);
+    packet_write(&p, &globalIndex, sizeof(u8));
+    packet_write(&p, &flags, sizeof(u8));
+    packet_write(&p, &length, sizeof(u8));
+    if (length > 0) {
+        packet_write(&p, (void *) link, length);
+    }
+    if (flags & MARIOCRAFT_PF_FACE) {
+        packet_write(&p, (void *) face, MARIOCRAFT_FACE_PIXELS * sizeof(u32));
+    }
+    network_send(&p);
+}
+
+void network_receive_mariocraft(struct Packet* p) {
+    u8 globalIndex = 0, flags = 0, length = 0;
+    char link[MARIOCRAFT_LINK_MAX + 1] = { 0 };
+    u32 face[MARIOCRAFT_FACE_PIXELS] = { 0 };
+    packet_read(p, &globalIndex, sizeof(u8));
+    packet_read(p, &flags, sizeof(u8));
+    packet_read(p, &length, sizeof(u8));
+    if (length > 0) {
+        packet_read(p, link, length);
+    }
+    if (flags & MARIOCRAFT_PF_FACE) {
+        packet_read(p, face, sizeof(face));
+    }
+    if (p->error) { return; }
+    if (packet_spoofed(p, globalIndex)) {
+        LOG_ERROR("rx spoofed mariocraft");
+        return;
+    }
+    // Only the host's own packet may say where the shared world is.
+    if (globalIndex != 0) { link[0] = '\0'; }
+    mariocraft_lobby_received(globalIndex, flags, link, (flags & MARIOCRAFT_PF_FACE) ? face : NULL);
+}
