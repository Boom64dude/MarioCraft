diff --git a/src/pc/lua/utils/smlua_text_utils.c b/src/pc/lua/utils/smlua_text_utils.c
index 328530b45..cfad23ca3 100644
--- a/src/pc/lua/utils/smlua_text_utils.c
+++ b/src/pc/lua/utils/smlua_text_utils.c
@@ -144,6 +144,64 @@ static void smlua_text_utils_replace_course_or_act_name(struct ReplacedName *nam
     name->modNum = modIndex + 1;
 }
 
+// MarioCraft: "Mario" becomes "Steve" (same length) in a copy of `text`, or NULL if it has none.
+static char *mariocraft_steve_text(const char *text) {
+    if (text == NULL || (strstr(text, "Mario") == NULL && strstr(text, "MARIO") == NULL && strstr(text, "mario") == NULL)) {
+        return NULL;
+    }
+    char *out = strdup(text);
+    if (out == NULL) {
+        return NULL;
+    }
+    static const char *from[] = { "Mario", "MARIO", "mario" };
+    static const char *to[] = { "Steve", "STEVE", "steve" };
+    for (int w = 0; w < 3; w++) {
+        for (char *p = strstr(out, from[w]); p != NULL; p = strstr(p + 5, from[w])) {
+            memcpy(p, to[w], 5);
+        }
+    }
+    return out;
+}
+
+static void mariocraft_steve_name(struct ReplacedName *name) {
+    if (!name->name.get_table) {
+        return;
+    }
+    char *steve = mariocraft_steve_text(name->name.value);
+    if (steve != NULL) {
+        smlua_text_utils_replace_course_or_act_name(name, steve, name->modNum - 1, false);
+        free(steve);
+    }
+}
+
+// MarioCraft: you play as Steve, so every text the game shows says so: dialogs ("Dear Steve..."),
+// course and star names ("Wing Steve over the Rainbow"). Called now and then (mods resetting text
+// put Mario back); cheap when there's nothing left to change.
+void smlua_text_utils_mariocraft_steve(void) {
+    if (gDialogTable != NULL) {
+        for (s32 i = 0; i < (s32) gDialogTable->count; i++) {
+            struct DialogEntry *dialog = dialog_table_get(i);
+            if (dialog == NULL) {
+                continue;
+            }
+            char *steve = mariocraft_steve_text(dialog->text);
+            if (steve != NULL) {
+                smlua_text_utils_dialog_replace(i, dialog->unused, dialog->linesPerBox, dialog->leftOffset, dialog->width, steve);
+                free(steve);
+            }
+        }
+    }
+    if (!sSmluaTextUtilsInited) {
+        return;
+    }
+    for (s16 courseNum = 0; courseNum <= COURSE_END; courseNum++) {
+        mariocraft_steve_name(&gReplacedCourseActNameTable[courseNum].courseName);
+        for (s16 actIndex = 0; actIndex < MAX_ACTS_AND_100_COINS; actIndex++) {
+            mariocraft_steve_name(&gReplacedCourseActNameTable[courseNum].actName[actIndex]);
+        }
+    }
+}
+
 void smlua_text_utils_reset_all(void) {
     dialog_table_reset();
 
diff --git a/src/pc/mariocraft/mariocraft.c b/src/pc/mariocraft/mariocraft.c
new file mode 100644
index 000000000..f16a27d9c
--- /dev/null
+++ b/src/pc/mariocraft/mariocraft.c
@@ -0,0 +1,2473 @@
+// MarioCraft link, SM64 side.
+//
+// Speaks SkyCraft's shared-memory protocol (version 11, protocol/skycraft_protocol.h in the
+// SkyCraft repo). SM64 plays the part Skyrim plays in SkyCraft:
+//
+//   * You play as Steve. Minecraft runs Steve's movement (walk, sprint, jump, crouch, swim) against
+//     the shape of Mario's level, which SM64 sends it (mc_collision.c).
+//   * SM64 draws everything: its level, Minecraft's blocks, mobs and Steve (mc_render.c), and
+//     Minecraft's HUD, hand and screens on top (mc_overlay.c). Its camera is Steve's eyes, or
+//     Minecraft's F5 third-person views.
+//   * Mario is an invisible stand-in that goes wherever Steve goes, so SM64's own things still
+//     react to you: coins, enemies, paintings, death planes.
+//
+// Coordinates: SM64 and Minecraft are both Y-up and right-handed, so only the scale changes.
+// 1 Minecraft block = 100 SM64 units. Each level/area gets its own patch of the Minecraft world
+// so builds in one level never show up in another.
+
+#include "mariocraft.h"
+
+#ifdef _WIN32
+
+#include <windows.h>
+#include <math.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include <stdio.h>
+
+#include "sm64.h"
+#include "game/level_update.h"
+#include "game/area.h"
+#include "game/mario.h"
+#include "engine/surface_collision.h"
+#include "engine/math_util.h"
+#include "pc/djui/djui.h"
+#include "pc/djui/djui_popup.h"
+#include "pc/djui/djui_gfx.h"
+#include "pc/controller/controller_mouse.h"
+#include "pc/gfx/gfx_window_manager_api.h"
+#include "game/game_init.h"
+#include "game/camera.h"
+#include "dialog_ids.h"
+#include "surface_terrains.h"
+#include "game/object_list_processor.h"
+#include "game/interaction.h"
+#include "course_table.h"
+#include "game/hardcoded.h"
+#include "pc/configfile.h"
+#include "audio/external.h"
+#include "engine/surface_load.h"
+#include "game/memory.h"
+#include "behavior_table.h"
+
+#include "mariocraft_internal.h"
+
+extern bool gMarioCraftCapturePad;  // mc_overlay.c
+extern OSContPad gMarioCraftPad;
+
+// SkyState flags
+#define SKY_IN_GAME  (1u << 0)
+#define SKY_LOADING  (1u << 2)
+#define SKY_PUPPET    (1u << 3)  // SM64 is carrying Steve: Minecraft keeps him at posX/Y/Z
+#define SKY_WING_CAP  (1u << 4)  // MarioCraft: Mario has the wing cap: Steve can fly (double-tap Space)
+#define SKY_SHOW_BODY (1u << 5)  // MarioCraft: send Steve's body even in first person (cutscenes)
+#define SKY_METAL_CAP (1u << 6)  // MarioCraft: Mario has the metal cap: Minecraft effects for it (MarioCaps)
+#define SKY_VANISH_CAP (1u << 7) // MarioCraft: ... the vanish cap
+#define SKY_SLIDING   (1u << 8)  // MarioCraft: sliding down a slide (a puppet): Minecraft draws him sitting
+#define SKY_WATER_LEVEL (1u << 9) // MarioCraft: an underwater level: Steve breathes in its water
+static uint32_t sSkyExtraFlags = 0;
+static double sCarryPos[3];      // while SM64 carries Steve: where (Minecraft blocks)
+
+// McState flags
+#define MC_IN_WORLD     (1u << 0)
+#define MC_SCREEN_OPEN  (1u << 1)  // a Minecraft screen (inventory, crafting, chest, pause...) is open
+#define MC_ON_GROUND    (1u << 2)
+#define MC_SNEAKING     (1u << 3)  // Shift held (in the air too)
+#define MC_DEAD         (1u << 5)  // Steve died (Minecraft's death screen)
+
+#pragma pack(push, 1)
+struct McHeader {
+    uint32_t magic;
+    uint32_t version;
+    uint32_t skyrimPid;  // "the game that owns the mapping": us
+    uint32_t mcPid;
+    uint64_t skyrimHeartbeatMs;
+    uint64_t mcHeartbeatMs;
+};
+
+struct McSkyState {
+    uint32_t seq;  // seqlock: odd while writing
+    uint32_t flags;
+    uint32_t worldId;
+    uint32_t collisionEpoch;
+    double   posX, posY, posZ;  // where Minecraft puts Steve when teleportSeq changes
+    float    yaw, pitch;        // where Steve looks (we turn him with the mouse)
+    uint32_t teleportSeq;
+    uint32_t viewportW, viewportH;
+    float    gameHour;
+};
+
+// What Minecraft reports about Steve (McState in the protocol).
+struct McState {
+    uint32_t seq;
+    uint32_t flags;
+    double   x, y, z;          // feet
+    float    yaw, pitch;
+    float    eyeHeight;
+    float    sensitivity;      // Minecraft's mouse sensitivity option (0..1)
+    uint32_t teleportAck;
+    uint32_t guiScale;
+    uint64_t frameCounter;
+    float    fovDeg;           // vertical FOV, with sprint/water changes
+    float    bobPhase, bobAmount;
+    uint32_t pad4C;
+    double   eyeX, eyeY, eyeZ;
+    int64_t  tickQpc;
+    double   prevX, prevY, prevZ;
+    double   curX, curY, curZ;
+    float    tickEyeO, tickEye;
+    float    walkDistO, walkDist;
+    float    bobO, bob;
+    float    tickMs;
+    uint32_t tickPad;
+    uint32_t cameraMode;       // 0 first person, 1 third person behind, 2 third person in front
+    float    cameraDistance;
+};
+#pragma pack(pop)
+
+_Static_assert(sizeof(struct McHeader) == 0x20, "header layout");
+_Static_assert(sizeof(struct McSkyState) == 0x40, "SkyState layout");
+_Static_assert(sizeof(struct McState) == 0xC8, "McState layout");
+
+static HANDLE sMapping = NULL;
+uint8_t *gMcShm = NULL;
+static uint32_t sLastMcPid = 0;
+static uint32_t sSkySeq = 0;
+static uint32_t sTeleportSeq = 1;
+static uint32_t sEpoch = 1;
+static uint32_t sLastWorldId = 0xFFFFFFFFu;
+static bool sWasMcInWorld = false;
+static uint32_t sExportedWorldId = 0xFFFFFFFFu;
+
+// Steve
+static struct McState sMc;          // latest consistent copy
+static bool sSteveActive = false;   // Minecraft has Steve where we asked: he's in charge now
+static double sTeleportPos[3];      // where we last asked Minecraft to put Steve (MC blocks)
+static float sYaw = 0, sPitch = 0;  // Steve's look, in Minecraft degrees
+static float sLastPuppetPos[3];
+static bool sHaveLastPuppetPos = false;
+static uint32_t sWorldId = 0xFFFFFFFFu;
+static bool sSteveHadControls = false;
+static bool sSteveDead = false;       // Minecraft's death screen is up
+static int sLifeCooldown = 0;         // frames until another death can cost a life
+static bool sRehoming = false;        // Steve is being moved (unstuck, a warp) while he was playing
+static bool sRmbDown = false;
+static bool sLmbDown = false;
+
+// Read by the renderer (rendering_graph_node.c): SM64's camera becomes Steve's.
+struct MarioCraftCamera gMarioCraftCamera = { 0 };
+
+// Read by controller_sdl.c.
+bool gMarioCraftOwnsMouse = false;    // mouse buttons belong to Minecraft, not Mario's punch/jump
+bool gMarioCraftLockMouse = false;    // mouse-look: hide and capture the pointer
+bool gMarioCraftWantsPointer = false; // a Minecraft screen is open: normal pointer
+
+static struct McHeader *header(void) { return (struct McHeader *) (gMcShm + OFF_HEADER); }
+static volatile struct McSkyState *sky_state(void) { return (volatile struct McSkyState *) (gMcShm + OFF_SKY_STATE); }
+
+static bool read_mc_state(void) {
+    const uint8_t *src = gMcShm + OFF_MC_STATE;
+    for (int tries = 0; tries < 4; tries++) {
+        uint32_t seq0, seq1;
+        memcpy(&seq0, src, 4);
+        if (seq0 & 1) {
+            continue;
+        }
+        MemoryBarrier();
+        struct McState copy;
+        memcpy(&copy, src, sizeof(copy));
+        MemoryBarrier();
+        memcpy(&seq1, src, 4);
+        if (seq0 == seq1) {
+            sMc = copy;
+            return true;
+        }
+    }
+    return false;
+}
+
+void mariocraft_init(void) {
+    LARGE_INTEGER size;
+    size.QuadPart = (LONGLONG) MAPPING_BYTES;
+    sMapping = CreateFileMappingW(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE,
+                                  (DWORD) size.HighPart, (DWORD) size.LowPart, MC_MAPPING_NAME);
+    if (sMapping == NULL) {
+        printf("[MarioCraft] couldn't create shared memory (error %lu)\n", GetLastError());
+        return;
+    }
+    gMcShm = (uint8_t *) MapViewOfFile(sMapping, FILE_MAP_ALL_ACCESS, 0, 0, 0);
+    if (gMcShm == NULL) {
+        printf("[MarioCraft] couldn't map shared memory (error %lu)\n", GetLastError());
+        CloseHandle(sMapping);
+        sMapping = NULL;
+        return;
+    }
+
+    // Start from a clean slate, like a fresh Skyrim session: everything Minecraft reads is zeroed
+    // (ring heads/tails, overlay control, actor table...). The big pixel/ring areas can stay.
+    memset(gMcShm, 0, OFF_COLLISION_RING + 0x80);
+    memset(gMcShm + OFF_RENDER_RING, 0, 0x80);
+    mc_collision_reset();
+    mc_overlay_reset();
+
+    // MarioCraft's additions at the end of the mapping (moving platforms): only if this mapping
+    // is ours at full size. A Minecraft still holding the mapping of an older SM64 build keeps it
+    // at that size; then they stay off until both are restarted.
+    MEMORY_BASIC_INFORMATION mbi;
+    bool roomy = VirtualQuery(gMcShm, &mbi, sizeof(mbi)) != 0 && mbi.RegionSize >= MAPPING_BYTES;
+    uint32_t features = FEATURE_LOBBY;  // (inside the part every build's mapping has)
+    if (roomy) {
+        memset(gMcShm + OFF_MOVING, 0, 0x40);
+        features |= FEATURE_MOVING;
+    } else {
+        printf("[MarioCraft] shared memory is from an older build: restart Minecraft too for moving platforms\n");
+    }
+    mc_moving_enable(roomy);
+    memcpy(gMcShm + OFF_FEATURES, &features, 4);
+
+    struct McHeader *h = header();
+    h->version = MC_VERSION;
+    h->skyrimPid = GetCurrentProcessId();
+    MemoryBarrier();
+    h->magic = MC_MAGIC;
+
+    // A different teleport number each run, so Minecraft always places Steve afresh.
+    sTeleportSeq = (uint32_t) (GetTickCount64() % 100000) + 2;
+    printf("[MarioCraft] shared memory ready; waiting for Minecraft\n");
+}
+
+// ---- input ring (we write, Minecraft reads): Minecraft's keyboard and mouse -----------------
+#define OFF_INPUT_RING     0x1000ull
+#define IN_RING_ENTRIES    4096u
+#define IN_KEY             1
+#define IN_MOUSE_BUTTON    2
+#define IN_SCROLL          3
+#define IN_CURSOR          4
+#define IN_TEXT            5
+#define IN_RELEASE_ALL     6
+#define IN_SOUND           22  // MarioCraft: a Minecraft sound (code: SND_*)
+#define SND_POUND          1
+#define SND_BURN           2
+#define SND_PICKUP         3
+#define SND_THROW          4
+#define SND_CRUSH          5
+#define MOUSE_LEFT         1  // attack / mine
+#define MOUSE_RIGHT        3  // use / place
+
+static void push_input_xyz(uint16_t type, uint16_t code, int32_t a, int32_t b, int32_t c);
+static void mc_sound(int code);  // (below: Minecraft's sound for something SM64 did)
+
+static void push_input_xy(uint16_t type, uint16_t code, int32_t a, int32_t b) {
+    push_input_xyz(type, code, a, b, 0);
+}
+
+static void push_input_xyz(uint16_t type, uint16_t code, int32_t a, int32_t b, int32_t c) {
+    uint8_t *ring = gMcShm + OFF_INPUT_RING;
+    volatile uint64_t *head = (volatile uint64_t *) ring;
+    volatile uint64_t *tail = (volatile uint64_t *) (ring + 0x40);
+    uint64_t h = *head;
+    if (h - *tail >= IN_RING_ENTRIES) {
+        return;  // Minecraft isn't reading (not running): drop it
+    }
+    uint8_t *e = ring + 0x80 + (h % IN_RING_ENTRIES) * 16;
+    memcpy(e, &type, 2);
+    memcpy(e + 2, &code, 2);
+    memcpy(e + 4, &a, 4);
+    memcpy(e + 8, &b, 4);
+    memcpy(e + 12, &c, 4);
+    MemoryBarrier();
+    *head = h + 1;
+}
+
+static void push_input(uint16_t type, uint16_t code, int32_t a) {
+    push_input_xy(type, code, a, 0);
+}
+
+// Minecraft's own keys, read straight from Windows and passed on as the SDL scancodes Minecraft
+// expects.
+struct McKey {
+    int vk;            // Windows virtual key
+    uint16_t sdl;      // SDL scancode sent to Minecraft
+    bool inScreens;    // also passed on while a Minecraft screen is open
+    bool screenOnly;   // only while a Minecraft screen is open (text editing keys)
+    bool repeats;      // held down: repeats, like typing (backspace in chat...)
+    bool down;
+    int heldFrames;
+    bool releasedOnly; // held across a release-all: Minecraft already let go, send no key-up
+};
+static struct McKey sKeys[] = {
+    { 'W', 26, false }, { 'A', 4, false }, { 'S', 22, false }, { 'D', 7, false },  // move
+    { VK_SPACE, 44, false },       // jump (double-tap in water: swim up)
+    { VK_LCONTROL, 224, false },   // sprint
+    { VK_LSHIFT, 225, true },      // sneak; shift-click in screens
+    { '1', 30, true }, { '2', 31, true }, { '3', 32, true }, { '4', 33, true }, { '5', 34, true },
+    { '6', 35, true }, { '7', 36, true }, { '8', 37, true }, { '9', 38, true },  // hotbar slots
+    { 'E', 8, true },              // inventory (opens and closes)
+    { 'Q', 20, true },             // drop the held item
+    { 'F', 9, false },             // swap item to off hand
+    { VK_F5, 62, false },          // first person / third person behind / in front
+    { VK_F1, 58, false },          // hide the HUD
+    { VK_F3, 60, false },          // debug screen; F3+F4 switches game mode, F3+B hitboxes...
+    { VK_F4, 61, false },
+    { 'B', 5, false }, { 'N', 17, false }, { 'G', 10, false }, { 'H', 11, false },  // for F3+B, F3+N...
+    { 'T', 23, false },            // open chat
+    { VK_OEM_2, 56, false },       // open chat with "/" for a command
+    { VK_ESCAPE, 41, true },       // closes a Minecraft screen (only sent while one is open)
+    // Editing keys for chat and other text boxes (the letters themselves come as typed text).
+    { VK_RETURN, 40, true, true, false }, { VK_BACK, 42, true, true, true }, { VK_TAB, 43, true, true, false },
+    { VK_DELETE, 76, true, true, true }, { VK_LEFT, 80, true, true, true }, { VK_RIGHT, 79, true, true, true },
+    { VK_UP, 82, true, true, true }, { VK_DOWN, 81, true, true, true }, { VK_HOME, 74, true, true, false },
+    { VK_END, 77, true, true, false },
+};
+#define NUM_KEYS (sizeof(sKeys) / sizeof(sKeys[0]))
+
+static bool sMouseGrabbed = false;
+static bool sLeftDown = false, sRightDown = false;
+static bool sMouseReleasedOnly = false;
+static uint32_t sLastScrollStamp = 0;
+static int32_t sCursorX = -1, sCursorY = -1;
+static bool sScreenOpen = false;
+
+static bool game_has_keyboard(void) {
+    extern struct GfxWindowManagerAPI *gWindowApi;
+    extern bool gDjuiChatBoxFocus;
+    extern bool gDjuiConsoleFocus;
+    extern bool gDjuiPanelPauseCreated;
+    return gWindowApi != NULL && gWindowApi->has_focus() && !gDjuiChatBoxFocus && !gDjuiConsoleFocus
+        && !gDjuiPanelPauseCreated && !gDjuiInMainMenu;
+}
+
+// Minecraft lets go of everything. A key still held (the E that just opened the inventory...)
+// only counts again once it's been released and pressed anew, so holding a key never toggles.
+static void release_everything(void) {
+    push_input(IN_RELEASE_ALL, 0, 0);
+    for (size_t i = 0; i < NUM_KEYS; i++) {
+        sKeys[i].down = (GetAsyncKeyState(sKeys[i].vk) & 0x8000) != 0;
+        sKeys[i].heldFrames = 0;
+        sKeys[i].releasedOnly = sKeys[i].down;
+    }
+    sLeftDown = (mouse_window_buttons & MOUSE_BUTTON_1) != 0;
+    sRightDown = (mouse_window_buttons & MOUSE_BUTTON_3) != 0;
+    sMouseReleasedOnly = sLeftDown || sRightDown;
+}
+
+static void forward_keys_and_mouse(bool screenOpen) {
+    bool focus = game_has_keyboard();
+    for (size_t i = 0; i < NUM_KEYS; i++) {
+        struct McKey *k = &sKeys[i];
+        if (k->sdl == 41 && !screenOpen && !k->down) {
+            continue;  // Esc with no Minecraft screen open is SM64's pause menu, not Minecraft's
+        }
+        bool wanted = screenOpen ? k->inScreens : !k->screenOnly;
+        bool down = focus && wanted && (GetAsyncKeyState(k->vk) & 0x8000) != 0;
+        if (down != k->down) {
+            k->down = down;
+            k->heldFrames = 0;
+            if (!down && k->releasedOnly) {
+                k->releasedOnly = false;  // Minecraft already let go of it
+                continue;
+            }
+            k->releasedOnly = false;
+            push_input(IN_KEY, k->sdl, down ? 1 : 0);
+        } else if (down && k->repeats && ++k->heldFrames > 12) {
+            push_input(IN_KEY, k->sdl, 1);  // still held: a repeat, like a held key when typing
+        }
+    }
+
+    // Mouse buttons: left mines / attacks (hold), right places / uses.
+    bool left = focus && (mouse_window_buttons & MOUSE_BUTTON_1) != 0;
+    bool right = focus && (mouse_window_buttons & MOUSE_BUTTON_3) != 0;
+    if (sMouseReleasedOnly) {
+        // Buttons held across a release-all: wait until they're both up.
+        sMouseReleasedOnly = left || right;
+        sLeftDown = left;
+        sRightDown = right;
+    } else {
+        if (left != sLeftDown) {
+            sLeftDown = left;
+            push_input(IN_MOUSE_BUTTON, MOUSE_LEFT, left ? 1 : 0);
+        }
+        if (right != sRightDown) {
+            sRightDown = right;
+            push_input(IN_MOUSE_BUTTON, MOUSE_RIGHT, right ? 1 : 0);
+        }
+    }
+
+    // Scroll wheel: the hotbar (or scrolling lists in screens).
+    if (focus && mouse_scroll_timestamp != sLastScrollStamp && mouse_scroll_y != 0) {
+        sLastScrollStamp = mouse_scroll_timestamp;
+        push_input(IN_SCROLL, 0, (int32_t) (mouse_scroll_y * 120.0f));
+    }
+
+    if (screenOpen) {
+        // In screens, Minecraft's cursor follows the real mouse pointer.
+        int w = mc_overlay_width(), h = mc_overlay_height();
+        u32 winW = 0, winH = 0;
+        gfx_get_dimensions(&winW, &winH);
+        if (w > 0 && h > 0 && winW > 0 && winH > 0) {
+            int32_t x = (int32_t) ((int64_t) mouse_window_x * w / (int64_t) winW);
+            int32_t y = (int32_t) ((int64_t) mouse_window_y * h / (int64_t) winH);
+            if (x != sCursorX || y != sCursorY) {
+                sCursorX = x;
+                sCursorY = y;
+                push_input_xy(IN_CURSOR, 0, x, y);
+            }
+            mc_overlay_set_cursor((float) x, (float) y, true);
+        }
+    }
+}
+
+// ---- mouse-look -------------------------------------------------------------------------
+// Every mouse movement SM64 reads (once per game tick, and again by us for every frame drawn)
+// adds up here, and turns Steve when it's used.
+static int32_t sMouseAccX = 0, sMouseAccY = 0;
+static bool sLookWasLocked = false;
+
+void mariocraft_mouse_moved(s32 dx, s32 dy) {
+    if (!gMarioCraftLockMouse) {
+        return;
+    }
+    sMouseAccX += dx;
+    sMouseAccY += dy;
+}
+
+static void apply_mouse_look(void) {
+    if (!gMarioCraftLockMouse) {
+        sMouseAccX = sMouseAccY = 0;
+        sLookWasLocked = false;
+        return;
+    }
+    if (!sLookWasLocked) {
+        // The first reading after the pointer is captured jumps from wherever it was.
+        sMouseAccX = sMouseAccY = 0;
+        sLookWasLocked = true;
+        return;
+    }
+    // Minecraft's own sensitivity curve, so its options slider still works.
+    float sens = sMc.sensitivity > 0.0f ? sMc.sensitivity : 0.5f;
+    float f = sens * 0.6f + 0.2f;
+    float k = f * f * f * 8.0f * 0.15f;
+    sYaw += (float) sMouseAccX * k;
+    sPitch += (float) sMouseAccY * k;
+    sMouseAccX = sMouseAccY = 0;
+    if (sPitch > 90.0f) sPitch = 90.0f;
+    if (sPitch < -90.0f) sPitch = -90.0f;
+    sYaw = fmodf(sYaw, 360.0f);
+}
+
+// Typed text (chat, sign text, renaming in an anvil...) goes to Minecraft while one of its screens
+// is open. Called by controller_keyboard.c; true means "taken".
+bool mariocraft_take_text(const char *text) {
+    if (gMcShm == NULL || !sScreenOpen || text == NULL) {
+        return false;
+    }
+    const unsigned char *p = (const unsigned char *) text;
+    while (*p) {
+        uint32_t cp;
+        int n;
+        if (p[0] < 0x80) { cp = p[0]; n = 1; }
+        else if ((p[0] & 0xE0) == 0xC0) { cp = p[0] & 0x1F; n = 2; }
+        else if ((p[0] & 0xF0) == 0xE0) { cp = p[0] & 0x0F; n = 3; }
+        else { cp = p[0] & 0x07; n = 4; }
+        for (int i = 1; i < n; i++) {
+            if ((p[i] & 0xC0) != 0x80) { n = i; break; }
+            cp = (cp << 6) | (p[i] & 0x3F);
+        }
+        if (cp >= 0x20 && cp != 0x7F) {
+            push_input(IN_TEXT, 0, (int32_t) cp);
+        }
+        p += n;
+    }
+    return true;
+}
+
+// Minecraft screen open or not: the pointer, and nothing left held across the switch.
+static void set_screen_mode(bool screenOpen) {
+    if (screenOpen == sScreenOpen) {
+        return;
+    }
+    sScreenOpen = screenOpen;
+    // The window only reports typed text while asked to (SM64-coop's text boxes do the same).
+    extern struct GfxWindowManagerAPI *gWindowApi;
+    if (gWindowApi != NULL && gWindowApi->start_text_input != NULL && gWindowApi->stop_text_input != NULL) {
+        if (screenOpen) {
+            gWindowApi->start_text_input();
+        } else {
+            gWindowApi->stop_text_input();
+        }
+    }
+    release_everything();
+    sCursorX = sCursorY = -1;
+    if (!screenOpen) {
+        mc_overlay_set_cursor(0, 0, false);
+    }
+}
+
+static void minecraft_controls(bool mcInWorld) {
+    gMarioCraftOwnsMouse = mcInWorld;
+    if (!mcInWorld) {
+        return;
+    }
+    if (!sMouseGrabbed) {
+        // Minecraft treats the first click as "focus the window", like a real mouse.
+        push_input(IN_MOUSE_BUTTON, MOUSE_LEFT, 1);
+        push_input(IN_MOUSE_BUTTON, MOUSE_LEFT, 0);
+        sMouseGrabbed = true;
+        return;
+    }
+    forward_keys_and_mouse(sScreenOpen);
+}
+
+static void write_sky_state(uint32_t flags, uint32_t worldId) {
+    volatile struct McSkyState *s = sky_state();
+    sSkySeq++;
+    s->seq = sSkySeq * 2 - 1;  // odd: writing
+    MemoryBarrier();
+    uint32_t extra = (flags & SKY_IN_GAME) ? sSkyExtraFlags : 0;
+    s->flags = flags | extra;
+    s->worldId = worldId;
+    s->collisionEpoch = sEpoch;
+    const double *pos = (extra & SKY_PUPPET) ? sCarryPos : sTeleportPos;
+    s->posX = pos[0];
+    s->posY = pos[1];
+    s->posZ = pos[2];
+    s->yaw = sYaw;
+    s->pitch = sPitch;
+    s->teleportSeq = sTeleportSeq;
+    // Minecraft's window (and so its HUD image) matches SM64's shape: its GUI is pixel art, so it
+    // scales up fine, and a smaller image is quicker to copy every frame.
+    u32 winW = 1280, winH = 720;
+    gfx_get_dimensions(&winW, &winH);
+    if (winW < 320 || winH < 240) {
+        winW = 1280;
+        winH = 720;
+    }
+    // At most 896 wide (896x504 for 16:9: Minecraft picks GUI scale 2 for that, and the image fits
+    // a 1024x512 texture, a quarter of the copying a 1280-wide one needed every frame).
+    uint32_t vw = winW > 896 ? 896 : winW;
+    s->viewportW = vw;
+    s->viewportH = (uint32_t) ((uint64_t) vw * winH / winW);
+    s->gameHour = 12.0f;
+    MemoryBarrier();
+    s->seq = sSkySeq * 2;  // even: done
+}
+
+// Puts Steve where Mario is (level entry, warps). Steve takes over again once Minecraft says so.
+static void teleport_steve_to_mario(struct MarioState *m) {
+    sRehoming = sSteveActive;  // Steve was playing: SM64 doesn't get the controls while he's moved
+    double originX = mc_origin_x(sWorldId);
+    sTeleportPos[0] = originX + m->pos[0] / UNITS_PER_BLOCK;
+    sTeleportPos[1] = sm64_to_mc_y(sWorldId, m->pos[1]);
+    sTeleportPos[2] = m->pos[2] / UNITS_PER_BLOCK;
+    sYaw = -(float) m->faceAngle[1] * (360.0f / 65536.0f);
+    sPitch = 0.0f;
+    sTeleportSeq++;
+    sSteveActive = false;
+    sHaveLastPuppetPos = false;
+}
+
+// ---- Mario as Steve's invisible stand-in (called from mario.c every frame) -----------------
+
+// ---- SM64's water, for Minecraft --------------------------------------------------------------
+// SM64's water (the castle moat, Jolly Roger Bay, Dire Dire Docks, the rising water of Wet-Dry
+// World...) is a list of boxes with a surface height. Minecraft gets the surface over the 16x16
+// block columns around Steve (SkyCraft's WaterGrid), and treats air below it as water: Steve
+// swims, floats, sinks and runs out of air there as in Minecraft water.
+#define OFF_WATER_GRID 0x400ull
+#define WATER_GRID     16
+
+static void write_water_grid(uint32_t worldId) {
+    uint8_t *g = gMcShm + OFF_WATER_GRID;
+    volatile uint32_t *seq = (volatile uint32_t *) g;
+    int32_t ox = (int32_t) floor(sMc.x) - WATER_GRID / 2, oz = (int32_t) floor(sMc.z) - WATER_GRID / 2;
+    double originX = mc_origin_x(worldId);
+    float surface[WATER_GRID * WATER_GRID];
+    float none = gLevelValues.floorLowerLimit + 1.0f;
+    for (int z = 0; z < WATER_GRID; z++) {
+        for (int x = 0; x < WATER_GRID; x++) {
+            f32 sx = (f32) ((ox + x + 0.5 - originX) * UNITS_PER_BLOCK);
+            f32 sz = (f32) ((oz + z + 0.5) * UNITS_PER_BLOCK);
+            f32 level = find_water_level(sx, sz);
+            surface[z * WATER_GRID + x] = level > none ? (float) sm64_to_mc_y(worldId, level) : -1.0e30f;
+        }
+    }
+    uint32_t s = *seq;
+    *seq = s | 1;
+    MemoryBarrier();
+    memcpy(g + 4, &ox, 4);
+    memcpy(g + 8, &oz, 4);
+    memcpy(g + 12, &worldId, 4);
+    memcpy(g + 16, surface, sizeof(surface));
+    MemoryBarrier();
+    *seq = (s | 1) + 1;
+}
+
+// ---- doors and paintings --------------------------------------------------------------------
+// Minecraft doesn't know SM64's doors are there (they're objects, not level geometry), so Steve
+// would walk straight through them. Instead, walking into a door opens it the SM64 way: Mario's
+// door action plays (Steve waits), and Steve carries on from the other side, or from wherever a
+// warp door leads. A locked door (not enough stars, no key) shows SM64's message and stays shut.
+
+static char sDoorNote[64] = "";           // for the status line
+static struct Object *sTrackDoor = NULL;  // the door Steve is next to
+static float sTrackAlong = 0;             // which side of it he was on
+static int sDoorCooldown = 0;
+
+static bool key_held(int vk) {
+    return (GetAsyncKeyState(vk) & 0x8000) != 0 && game_has_keyboard();
+}
+
+static struct Object *nearest_door(struct MarioState *m, float *outAlong, float *outSide) {
+    struct Object *best = NULL;
+    float bestScore = 1e30f;
+    struct ObjectNode *head = &gObjectLists[OBJ_LIST_SURFACE];
+    for (struct ObjectNode *n = head->next; n != NULL && n != head; n = n->next) {
+        struct Object *o = (struct Object *) n;
+        if (o->activeFlags == ACTIVE_FLAG_DEACTIVATED || !(o->oInteractType & (INTERACT_DOOR | INTERACT_WARP_DOOR))) {
+            continue;
+        }
+        float dy = m->pos[1] - o->oPosY;
+        if (dy < -120.0f || dy > 200.0f) {
+            continue;
+        }
+        // The door's own axes: `along` through the doorway, `side` across it.
+        float fx = sins(o->oMoveAngleYaw), fz = coss(o->oMoveAngleYaw);
+        float dx = m->pos[0] - o->oPosX, dz = m->pos[2] - o->oPosZ;
+        float along = dx * fx + dz * fz, side = dx * fz - dz * fx;
+        if (fabsf(side) > 170.0f || fabsf(along) > 170.0f) {
+            continue;
+        }
+        float score = along * along + side * side;
+        if (score < bestScore) {
+            bestScore = score;
+            best = o;
+            *outAlong = along;
+            *outSide = side;
+        }
+    }
+    return best;
+}
+
+static void steve_doors(struct MarioState *m, float moveX, float moveZ, bool onGround) {
+    if (sDoorCooldown > 0) {
+        sDoorCooldown--;
+    }
+    float along = 0, side = 0;
+    struct Object *door = nearest_door(m, &along, &side);
+    if (door == NULL) {
+        sTrackDoor = NULL;
+        return;
+    }
+    float fx = sins(door->oMoveAngleYaw), fz = coss(door->oMoveAngleYaw);
+    float step = moveX * fx + moveZ * fz;        // this frame's movement through the doorway
+    bool toward = (along > 0 && step < -1.0f) || (along < 0 && step > 1.0f);
+    // Doors are solid for Steve now (SM64's own door collision): pressing W while facing one
+    // he's standing against counts as walking into it too.
+    float look = sins(m->faceAngle[1]) * fx + coss(m->faceAngle[1]) * fz;
+    if (key_held('W') && ((along > 0 && look < -0.5f) || (along < 0 && look > 0.5f))) {
+        toward = true;
+    }
+    snprintf(sDoorNote, sizeof(sDoorNote), "door %.0f/%.0f %s", along, side, toward ? "->" : "");
+
+    // Walking into it (within about a block of it): open it.
+    if (toward && onGround && fabsf(along) < 110.0f && fabsf(side) < 150.0f && sDoorCooldown == 0) {
+        u32 oldAction = m->action;
+        m->action = ACT_WALKING;  // what SM64's doors want of Mario
+        vec3f_copy(m->marioObj->header.gfx.pos, m->pos);
+        u32 opened = (door->oInteractType & INTERACT_WARP_DOOR) ? interact_warp_door(m, INTERACT_WARP_DOOR, door)
+                                                                 : interact_door(m, INTERACT_DOOR, door);
+        sDoorCooldown = 20;
+        if (opened) {
+            snprintf(sDoorNote, sizeof(sDoorNote), "door opened");
+            sTrackDoor = NULL;
+            return;
+        }
+        if (m->action == ACT_WALKING) {
+            m->action = oldAction;
+        }
+    }
+
+    // Walked through it without it opening (locked): back to the side he came from.
+    if (door == sTrackDoor && fabsf(side) < 150.0f && door->oAction == 0
+        && ((sTrackAlong > 0 && along <= 0) || (sTrackAlong < 0 && along >= 0))) {
+        float back = sTrackAlong > 0 ? 60.0f : -60.0f;
+        m->pos[0] = door->oPosX + fx * back + fz * side;
+        m->pos[2] = door->oPosZ + fz * back - fx * side;
+        teleport_steve_to_mario(m);
+        snprintf(sDoorNote, sizeof(sDoorNote), "door locked");
+        sTrackDoor = NULL;
+        return;
+    }
+    sTrackDoor = door;
+    sTrackAlong = along;
+}
+
+static bool is_painting_warp(const struct Surface *s) {
+    return s != NULL && s->type >= SURFACE_PAINTING_WARP_D3 && s->type <= SURFACE_PAINTING_WARP_FC;
+}
+
+// A painting's warp floor right where Steve is or just in front of him, between his feet and his
+// head, while he walks (or jumps) into it.
+static struct Surface *painting_in_front(struct MarioState *m, f32 *outHeight) {
+    bool pushing = key_held('W') || (sMc.flags & (1u << 2)) == 0;  // walking forward, or in the air
+    static const float ahead[] = { 0.0f, 35.0f, 60.0f, 85.0f };
+    float fx = sins(m->faceAngle[1]), fz = coss(m->faceAngle[1]);
+    for (int i = 0; i < 4; i++) {
+        if (i > 0 && !pushing) {
+            break;
+        }
+        struct Surface *s = NULL;
+        f32 h = find_floor(m->pos[0] + fx * ahead[i], m->pos[1] + 190.0f, m->pos[2] + fz * ahead[i], &s);
+        if (is_painting_warp(s) && h > m->pos[1] - 40.0f && h < m->pos[1] + 190.0f) {
+            *outHeight = h;
+            return s;
+        }
+    }
+    return NULL;
+}
