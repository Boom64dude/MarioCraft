+// Going somewhere (doors, paintings, pipes, coming into a level, leaving it). SM64's own screen
+// transitions show it (and the dirt screen, update_fade); Minecraft doesn't hurt the landing after (MarioFalls).
+static bool is_transition_action(u32 action) {
+    switch (action) {
+        case ACT_PULLING_DOOR: case ACT_PUSHING_DOOR: case ACT_WARP_DOOR_SPAWN: case ACT_ENTERING_STAR_DOOR:
+        case ACT_UNLOCKING_KEY_DOOR: case ACT_UNLOCKING_STAR_DOOR:
+        case ACT_DISAPPEARED: case ACT_EMERGE_FROM_PIPE: case ACT_TELEPORT_FADE_OUT: case ACT_TELEPORT_FADE_IN:
+        case ACT_SPAWN_SPIN_AIRBORNE: case ACT_SPAWN_SPIN_LANDING: case ACT_SPAWN_NO_SPIN_AIRBORNE:
+        case ACT_SPAWN_NO_SPIN_LANDING: case ACT_EXIT_AIRBORNE: case ACT_FALLING_EXIT_AIRBORNE:
+        case ACT_SPECIAL_EXIT_AIRBORNE: case ACT_DEATH_EXIT: case ACT_UNUSED_DEATH_EXIT: case ACT_FALLING_DEATH_EXIT:
+        case ACT_SPECIAL_DEATH_EXIT: case ACT_DEATH_EXIT_LAND: case ACT_BBH_ENTER_JUMP: case ACT_BBH_ENTER_SPIN:
+            return true;
+        default:
+            return false;
+    }
+}
+
+// SM64 cutscenes that show something happening out in the level (rather than to Mario): the
+// Chain Chomp breaking free, a star or the red-coin star appearing, a cap switch, a Bob-omb
+// Buddy opening a cannon, Bowser arriving, the opening and the ending. SM64's camera shows them;
+// Steve stands still and can be seen standing there, as Mario was.
+static bool world_cutscene(void) {
+    if (gCamera == NULL) {
+        return false;
+    }
+    switch (gCamera->cutscene) {
+        case CUTSCENE_STAR_SPAWN: case CUTSCENE_RED_COIN_STAR_SPAWN: case CUTSCENE_CAP_SWITCH_PRESS:
+        case CUTSCENE_PREPARE_CANNON: case CUTSCENE_SSL_PYRAMID_EXPLODE: case CUTSCENE_ENTER_BOWSER_ARENA:
+        case CUTSCENE_INTRO_PEACH: case CUTSCENE_GRAND_STAR: case CUTSCENE_ENDING: case CUTSCENE_END_WAVING:
+        case CUTSCENE_CREDITS:
+            return true;
+        default:
+            return false;
+    }
+}
+
+// The screen fades to black with a spinning dirt block (like Minecraft's loading screen) while
+// Steve goes through a door or pipe, comes into a level or leaves one, and until Minecraft has put
+// him where Mario came out. Not for paintings: going into one shows SM64's own ripple and fade.
+static float sFade = 0.0f;   // how black the screen is
+static int sFadeHold = 0;    // after a transition: frames left to wait for Steve to be put in place
+static bool sFadeAwaitSteve = false;
+static int sWarpFadeFrames = 0;
+static int sPaintingFrames = 0;     // Steve touched a painting this recently (frames)
+static bool sPaintingWarp = false;  // going through a painting: no dirt screen until he's out in the course
+static int sStarSelectFrames = 0;   // the star select was on screen this recently (frames)
+static bool sStarSelectNow = false; // ... this frame (no Minecraft HUD over it either)
+
+// SM64 started a painting's warp (level_update.c), however Steve got into the painting.
+void mariocraft_painting_warp(void) {
+    sPaintingWarp = true;
+}
+
+void mariocraft_star_select_shown(void) {
+    sStarSelectFrames = 3;
+}
+
+static void update_fade(struct MarioState *m, bool inLevel) {
+    if (sPaintingFrames > 0) {
+        sPaintingFrames--;
+    }
+    sStarSelectNow = sStarSelectFrames > 0;
+    if (sStarSelectFrames > 0) {
+        // The star select: nothing over it. Once an act is picked, the course loading after it
+        // gets the dirt screen again.
+        sStarSelectFrames--;
+        mc_overlay_set_visible(false);
+        sPaintingWarp = false;
+        sFadeAwaitSteve = false;
+        sFade = 0.0f;
+        mc_overlay_set_fade(0.0f, false);
+        return;
+    }
+    bool moving = inLevel && m->marioObj != NULL && is_transition_action(m->action);
+    // SM64's own screen transitions count too, but never for more than 5 seconds on their own:
+    // the screen must not stay black if one gets stuck.
+    bool sm64Fade = inLevel && gWarpTransition.isActive && !moving;
+    if (sm64Fade) {
+        if (++sWarpFadeFrames > 150) {
+            sm64Fade = false;
+        }
+    } else {
+        sWarpFadeFrames = 0;
+    }
+    bool going = moving || sm64Fade;
+    if (going && sPaintingFrames > 0) {
+        sPaintingWarp = true;
+    }
+    if (going) {
+        sFadeAwaitSteve = true;
+        sFadeHold = 90;  // up to 3 seconds for Minecraft to put Steve where Mario came out
+    } else if (sFadeAwaitSteve) {
+        if ((sSteveActive && sHaveLastPuppetPos) || --sFadeHold <= 0 || !inLevel) {
+            sFadeAwaitSteve = false;
+        }
+    }
+    if (sPaintingWarp && !inLevel) {
+        // Through the painting: the star select (no dirt over it). Coming into the course after
+        // it is a level loading: the dirt screen again.
+        sPaintingWarp = false;
+    }
+    extern s32 gDialogID;
+    bool black = inLevel && !sPaintingWarp && (going || sFadeAwaitSteve) && gDialogID == DIALOG_NONE
+              && sCurrPlayMode != PLAY_MODE_PAUSED;
+    if (black) {
+        sFade = fminf(1.0f, sFade + 0.2f);   // about a sixth of a second to black
+    } else {
+        sFade = fmaxf(0.0f, sFade - 0.12f);  // a little slower back
+    }
+    mc_overlay_set_fade(sFade, black);
+}
+
+static void steve_talk(struct MarioState *m) {
+    struct Object *best = NULL;
+    float bestDist = 300.0f;
+    s16 look = m->faceAngle[1];
+    for (int i = 0; i < OBJECT_POOL_CAPACITY; i++) {
+        struct Object *o = &gObjectPool[i];
+        if (o->activeFlags == ACTIVE_FLAG_DEACTIVATED || !(o->oInteractType & INTERACT_TEXT)
+            || !(o->oInteractionSubtype & (INT_SUBTYPE_NPC | INT_SUBTYPE_SIGN))) {
+            continue;
+        }
+        float dx = o->oPosX - m->pos[0], dy = o->oPosY - m->pos[1], dz = o->oPosZ - m->pos[2];
+        float dist = sqrtf(dx * dx + dz * dz);
+        if (dist >= bestDist || dy < -150.0f || dy > 250.0f) {
+            continue;
+        }
+        s16 dYaw = (s16) (atan2s(dz, dx) - look);
+        if (dist > 60.0f && (dYaw < -0x3000 || dYaw > 0x3000)) {
+            continue;  // not in front of him
+        }
+        best = o;
+        bestDist = dist;
+    }
+    if (best == NULL) {
+        return;
+    }
+    u32 oldAction = m->action;
+    m->action = ACT_IDLE;  // SM64 only lets Mario talk while standing or walking
+    m->faceAngle[1] = atan2s(best->oPosZ - m->pos[2], best->oPosX - m->pos[0]);
+    m->input |= INPUT_B_PRESSED;
+    u32 talked = interact_text(m, INTERACT_TEXT, best);
+    m->input &= ~INPUT_B_PRESSED;
+    if (!talked && m->action == ACT_IDLE) {
+        m->action = oldAction;
+        m->faceAngle[1] = look;
+    }
+    snprintf(sDoorNote, sizeof(sDoorNote), talked ? "talking" : "can't talk from here");
+}
+
+// ---- picking things up ------------------------------------------------------------------------
+// Mario picks things up with B: Bob-ombs, crates, the baby penguin, Mips, Ukiki, a Koopa shell
+// underwater... Steve does it with a right click (Minecraft's "use"), puts it down with another,
+// and throws it with a left click. SM64 holds it as Mario's, so it does what it does when Mario
+// carries it (Mips talks, the penguin's mother waits for her baby), and it's drawn in Steve's arms
+// (mariocraft_after_objects). Bosses that grab Mario (King Bob-omb, Chuckya) and Bowser are thrown
+// by hitting them instead (mc_actors.c).
+static bool is_pickup(const struct Object *o) {
+    return o->activeFlags != ACTIVE_FLAG_DEACTIVATED && (o->oInteractType & INTERACT_GRABBABLE) && o->oHeldState == HELD_FREE
+        && !(o->oInteractionSubtype & (INT_SUBTYPE_NOT_GRABBABLE | INT_SUBTYPE_GRABS_MARIO))
+        && get_id_from_behavior(o->behavior) != id_bhvBowser;
+}
+
+static struct Object *pickup_in_front(struct MarioState *m, float *outDist) {
+    struct Object *best = NULL;
+    float bestDist = 250.0f;
+    for (int i = 0; i < OBJECT_POOL_CAPACITY; i++) {
+        struct Object *o = &gObjectPool[i];
+        if (!is_pickup(o)) {
+            continue;
+        }
+        float dx = o->oPosX - m->pos[0], dy = o->oPosY - m->pos[1], dz = o->oPosZ - m->pos[2];
+        float dist = sqrtf(dx * dx + dz * dz);
+        if (dist >= bestDist || dy < -150.0f || dy > 220.0f) {
+            continue;
+        }
+        s16 dYaw = (s16) (atan2s(dz, dx) - m->faceAngle[1]);
+        if (dist > 60.0f && (dYaw < -0x3000 || dYaw > 0x3000)) {
+            continue;  // not in front of him
+        }
+        best = o;
+        bestDist = dist;
+    }
+    *outDist = bestDist;
+    return best;
+}
+
+// Where what Steve carries is: in front of his chest.
+static void held_position(struct MarioState *m, f32 out[3]) {
+    out[0] = m->pos[0] + sins(m->faceAngle[1]) * 60.0f;
+    out[1] = m->pos[1] + 90.0f;
+    out[2] = m->pos[2] + coss(m->faceAngle[1]) * 60.0f;
+}
+
+static void steve_talk(struct MarioState *m);
+
+// A right click: put down what he carries, or pick up what's in front of him, or talk / read.
+static void steve_use(struct MarioState *m) {
+    if (m->heldObj != NULL) {
+        if (m->marioBodyState != NULL) {
+            held_position(m, m->marioBodyState->heldObjLastPosition);
+        }
+        mario_drop_held_object(m);
+        snprintf(sDoorNote, sizeof(sDoorNote), "put down");
+        return;
+    }
+    float dist = 0;
+    struct Object *o = pickup_in_front(m, &dist);
+    if (o != NULL) {
+        m->usedObj = o;
+        mario_grab_used_object(m);
+        if (m->heldObj == o) {
+            mc_sound(SND_PICKUP);
+            snprintf(sDoorNote, sizeof(sDoorNote), "carrying %d", get_id_from_behavior(o->behavior));
+            return;
+        }
+    }
+    steve_talk(m);
+}
+
+// A left click while carrying something: throw it the way Steve looks.
+static void steve_throw(struct MarioState *m) {
+    if (m->heldObj == NULL) {
+        return;
+    }
+    if (m->marioBodyState != NULL) {
+        held_position(m, m->marioBodyState->heldObjLastPosition);
+    }
+    mario_throw_held_object(m);
+    mc_sound(SND_THROW);
+    snprintf(sDoorNote, sizeof(sDoorNote), "thrown");
+}
+
+// After SM64's objects ran this frame (object_list_processor.c): what Steve carries is in his arms
+// and drawn there. (Its own code hides it while held: Mario's model would draw it in his hands.)
+void mariocraft_after_objects(void) {
+    struct MarioState *m = &gMarioStates[0];
+    if (gMcShm == NULL || !sSteveActive || m->marioObj == NULL || m->heldObj == NULL) {
+        return;
+    }
+    struct Object *o = m->heldObj;
+    if (o->activeFlags == ACTIVE_FLAG_DEACTIVATED || o->oHeldState != HELD_HELD) {
+        m->heldObj = NULL;  // (it went away: exploded, gave its star...)
+        return;
+    }
+    f32 pos[3];
+    held_position(m, pos);
+    if (m->marioBodyState != NULL) {
+        vec3f_copy(m->marioBodyState->heldObjLastPosition, pos);
+    }
+    o->oPosX = pos[0];
+    o->oPosY = pos[1];
+    o->oPosZ = pos[2];
+    o->oFaceAngleYaw = m->faceAngle[1];
+    vec3f_copy(o->header.gfx.pos, pos);
+    o->header.gfx.angle[1] = m->faceAngle[1];
+    o->header.gfx.node.flags |= GRAPH_RENDER_ACTIVE;
+    o->header.gfx.node.flags &= ~GRAPH_RENDER_INVISIBLE;
+}
+
+static void steve_hurt_by_mario(struct MarioState *m);
+
+// Steve's ground pound: holding Shift (sneak) as he lands from a fall of more than a block.
+// For one moment Mario is in SM64's ground-pound landing: Whomps and King Whomp take damage
+// from it when he lands on their backs, stakes go in, enemies under him are pounded flat.
+static bool sWasOnGround = true;
+static float sAirTopY = 0;      // highest point of the current jump or fall (SM64 units)
+static int sSinceSneak = 99;    // game frames since Shift was last held in the air
+static int sPoundFrames = 0;    // Mario stays in the ground-pound landing this many more frames
+static int sPounds = 0;         // for the status line
+
+// What SM64's world does to the player that Minecraft has no way to: a cannon, a pole or tree
+// (jump into it), hanging from Hoot, riding a Koopa shell, a tornado, a whirlpool, a gust of
+// wind, being grabbed and thrown. SM64 works out where the player goes (its own physics and
+// objects), and Steve is carried there: every tick Minecraft puts him where SM64 says (SkyState's
+// puppet flag). He keeps his own view, body and keys, and Mario stays hidden. His keys steer it
+// (carry_pad): WASD, the mouse (aims the cannon, steers Hoot), Space (fire, jump off a pole),
+// Shift (let go of a pole or of Hoot).
+static bool is_slide_action(u32 action);  // (below, with slides)
+
+static bool is_carried_action(u32 action) {
+    if (action & (ACT_FLAG_ON_POLE | ACT_FLAG_RIDING_SHELL)) {
+        return true;
+    }
+    if (is_slide_action(action)) {
+        return true;
+    }
+    switch (action) {
+        case ACT_IN_CANNON: case ACT_SHOT_FROM_CANNON: case ACT_RIDING_HOOT: case ACT_GRABBED:
+        case ACT_TORNADO_TWIRLING: case ACT_CAUGHT_IN_WHIRLPOOL: case ACT_GETTING_BLOWN:
+        case ACT_THROWN_FORWARD: case ACT_THROWN_BACKWARD:
+            return true;
+        default:
+            return false;
+    }
+}
+static bool sCarried = false;   // SM64 is carrying Steve
+static int sCarries = 0;        // for the status line
+
+#define IN_VELOCITY 20  // MarioCraft: Minecraft sets the player's velocity (a, b, c: blocks/tick x 10000)
+#define IN_HEAL     21  // MarioCraft: Minecraft heals the player (a: health x 100)
+static void push_input_xyz(uint16_t type, uint16_t code, int32_t a, int32_t b, int32_t c);
+
+static s16 steve_face_yaw(void) {
+    return (s16) (-sYaw * (65536.0f / 360.0f));
+}
+
+// Held by King Bob-omb, Chuckya or anything else that grabs Mario: Steve crouches (Minecraft's
+// sneak, so his body shows it, to him in F5 and to other players), and stands once he's thrown.
+static bool sGrabCrouch = false;
+
+static void set_grab_crouch(bool crouch) {
+    if (crouch == sGrabCrouch) {
+        return;
+    }
+    sGrabCrouch = crouch;
+    // Left Shift, as if held (unless it really is: then letting go is the player's).
+    if (crouch || (GetAsyncKeyState(VK_LSHIFT) & 0x8000) == 0) {
+        push_input(IN_KEY, 225, crouch ? 1 : 0);
+    }
+}
+
+// One frame of being carried: aim the cannon where Steve looks, and tell Minecraft where he is.
+static void carried_frame(struct MarioState *m) {
+    sTrackDoor = NULL;
+    set_grab_crouch(m->action == ACT_GRABBED);
+    if (m->hurtCounter > 0) {
+        steve_hurt_by_mario(m);  // King Bob-omb's throw, a Piranha Plant by the pole...
+    }
+    sWasOnGround = true;  // (coming down from it isn't a ground pound)
+    sPoundFrames = 0;
+    if (m->action == ACT_IN_CANNON && m->actionState == 2) {
+        // The cannon points where Steve looks (SM64 allows 0 to 80 degrees up, 90 either side).
+        float up = -sPitch;
+        s16 pitch = (s16) (fmaxf(0.0f, fminf(up, 80.0f)) * (65536.0f / 360.0f));
+        s32 rel = (s16) (steve_face_yaw() - m->marioObj->oMarioCannonObjectYaw);
+        if (rel > 0x4000) rel = 0x4000;
+        if (rel < -0x4000) rel = -0x4000;
+        m->faceAngle[0] = pitch;
+        m->marioObj->oMarioCannonInputYaw = rel;
+    }
+    // Steve's feet where Mario's are; hanging from Hoot, low enough that his head isn't in Hoot.
+    float y = m->pos[1] - (m->action == ACT_RIDING_HOOT ? 160.0f : 0.0f);
+    sCarryPos[0] = mc_origin_x(sWorldId) + m->pos[0] / UNITS_PER_BLOCK;
+    sCarryPos[1] = sm64_to_mc_y(sWorldId, y);
+    sCarryPos[2] = m->pos[2] / UNITS_PER_BLOCK;
+    vec3f_copy(sLastPuppetPos, m->pos);
+    sHaveLastPuppetPos = true;
+    sSkyExtraFlags |= SKY_PUPPET;  // (straight away, for the frames drawn before update())
+    m->marioObj->header.gfx.node.flags |= GRAPH_RENDER_INVISIBLE;
+}
+
+// Let go in mid-air (off a pole, off Hoot, out of a cannon shot): Steve keeps Mario's speed.
+static void hand_over_velocity(struct MarioState *m) {
+    const float perTick = 1.5f / (float) UNITS_PER_BLOCK;  // SM64 units/frame -> blocks/tick
+    float v[3] = { m->vel[0] * perTick, m->vel[1] * perTick, m->vel[2] * perTick };
+    for (int i = 0; i < 3; i++) {
+        v[i] = fmaxf(-3.0f, fminf(3.0f, v[i]));
+    }
+    push_input_xyz(IN_VELOCITY, 0, (int32_t) (v[0] * 10000.0f), (int32_t) (v[1] * 10000.0f), (int32_t) (v[2] * 10000.0f));
+}
+
+
+static bool steve_unstick(struct MarioState *m, const float *feet);  // (below, with the hurting)
+
+// ---- out of the level ---------------------------------------------------------------------------
+// Where Steve last stood on SM64's ground in this area. Falling out of a level with no death floor
+// under it (Bowser's sub in Dire, Dire Docks, swimming out under the map) left him falling forever
+// in Minecraft's void: once he's well below that ground with nothing at all under him, it's a fall
+// out of the level, as for Mario (a lost life in a course), and he's put back on that ground.
+static float sSafePos[3];
+static bool sHaveSafePos = false;
+static int sOutFrames = 0;
+
+static void steve_back_to_safety(struct MarioState *m) {
+    if (!sHaveSafePos) {
+        return;
+    }
+    vec3f_copy(m->pos, sSafePos);
+    vec3f_set(m->vel, 0, 0, 0);
+    teleport_steve_to_mario(m);
+}
+
+// True if he fell out (and was dealt with).
+static bool steve_fell_out(struct MarioState *m, const float *feet, bool onGround) {
+    struct Surface *under = NULL;
+    find_floor(feet[0], feet[1] + 100.0f, feet[2], &under);
+    if (under != NULL && onGround) {
+        sSafePos[0] = feet[0];
+        sSafePos[1] = fmaxf(feet[1], find_floor(feet[0], feet[1] + 100.0f, feet[2], &under));
+        sSafePos[2] = feet[2];
+        sHaveSafePos = true;
+    }
+    bool out = under == NULL && sHaveSafePos && feet[1] < sSafePos[1] - 1500.0f;
+    sOutFrames = out ? sOutFrames + 1 : 0;
+    if (sOutFrames < 10) {
+        return false;
+    }
+    sOutFrames = 0;
+    printf("[MarioCraft] Steve fell out of the level: back to %.0f %.0f %.0f\n", sSafePos[0], sSafePos[1], sSafePos[2]);
+    steve_back_to_safety(m);
+    if (gCurrCourseNum != COURSE_NONE && sCurrPlayMode == PLAY_MODE_NORMAL && sLifeCooldown == 0) {
+        sLifeCooldown = 150;
+        level_trigger_warp(m, WARP_OP_DEATH);  // (a fall out of the level is a lost life, as for Mario)
+    }
+    return true;
+}
+
+// ---- slides -------------------------------------------------------------------------------------
+// The Princess's Secret Slide, the slides in Cool, Cool Mountain and Tall, Tall Mountain, and any
+// floor too slippery to stand on: Mario sits down and slides, steering left and right. So does
+// Steve: SM64's own butt slide moves him (is_carried_action), WASD steer it the way he looks, Space
+// jumps out of it, and Minecraft draws him sitting (SKY_SLIDING).
+static int sSlideWait = 0;  // frames before he can start sliding again (just got out of one)
+
+static bool is_slide_action(u32 action) {
+    switch (action) {
+        case ACT_BUTT_SLIDE: case ACT_BUTT_SLIDE_AIR: case ACT_HOLD_BUTT_SLIDE: case ACT_HOLD_BUTT_SLIDE_AIR:
+        case ACT_STOMACH_SLIDE: case ACT_DIVE_SLIDE:
+            return true;
+        default:
+            return false;
+    }
+}
+
+// SM64's should_begin_sliding, for Steve: a floor too steep for its slipperiness, and either a
+// slide level or going downhill.
+static bool steve_should_slide(struct MarioState *m, float mx, float mz) {
+    if (m->floor == NULL || m->area == NULL || !mario_floor_is_slippery(m)) {
+        return false;
+    }
+    bool slideLevel = (m->area->terrainType & TERRAIN_MASK) == TERRAIN_SLIDE;
+    if (slideLevel) {
+        return true;
+    }
+    // Elsewhere only the slipperiest floors (ice, the slides' own surface), and only going down them.
+    if (mario_get_floor_class(m) != SURFACE_CLASS_VERY_SLIPPERY) {
+        return false;
+    }
+    float nx = m->floor->normal.x, nz = m->floor->normal.z;  // (points downhill)
+    return mx * nx + mz * nz > 0.5f;
+}
+
+static void begin_steve_slide(struct MarioState *m, float mx, float mz) {
+    float speed = sqrtf(mx * mx + mz * mz);
+    if (speed < 4.0f) {
+        // Starting from standing: down the slope.
+        mx = m->floor->normal.x * 8.0f;
+        mz = m->floor->normal.z * 8.0f;
+        speed = 8.0f;
+    }
+    m->slideVelX = mx;
+    m->slideVelZ = mz;
+    m->slideYaw = atan2s(mz, mx);
+    m->forwardVel = speed;
+    m->faceAngle[1] = m->slideYaw;
+    set_mario_action(m, ACT_BUTT_SLIDE, 0);
+}
+
+// ---- Mario's moves, for Steve ---------------------------------------------------------------
+// Stars are built around what Mario can do. Steve jumps Minecraft's jump (a block and a bit), and
+// on top of it gets Mario's:
+//   double jump    jump again just as you land                  (about 2 blocks)
+//   triple jump    and once more, running                       (about 3 blocks)
+//   long jump      Shift + Space while running: far and low     (about 8 blocks)
+//   backflip       Shift + Space standing still                 (about 3.5 blocks)
+//   wall kick      Space in the air against a wall: off it, up  (about 2.5 blocks, chains)
+// Minecraft does the moving (IN_VELOCITY); the extra height doesn't count towards fall damage.
+#define MC_FLYING    (1u << 7)  // creative flight or an elytra
+#define MC_IN_FLUID  (1u << 8)  // water, lava, a ladder or vines
+#define CHAIN_FRAMES 6          // a landing this recent still chains into the next jump
+
+static bool sMoveWasGround = true;
+static bool sMoveSpaceWas = false;
+static int sMoveLanded = 99;   // frames since the last landing
+static int sMoveChain = 0;     // 1 after a jump, 2 after a double jump
+static int sMoveAir = 0;       // frames in the air
+static int sMoveKickWait = 0;  // frames until the next wall kick
+static float sMoveSpeed = 0;   // recent sideways speed (blocks/tick), its peak over a few frames
+static int sMoveCount = 0;     // for the status line
+static int sMoveSincePress = 99;
+
+static void mario_move(float vx, float vy, float vz, bool keepSideways, float extraBlocks) {
+    uint16_t code = (uint16_t) ((keepSideways ? 1 : 0) | ((int) (extraBlocks * 10.0f + 0.5f) << 4));
+    push_input_xyz(IN_VELOCITY, code, (int32_t) (vx * 10000.0f), (int32_t) (vy * 10000.0f), (int32_t) (vz * 10000.0f));
+    sMoveCount++;
+}
+
+static void steve_mario_moves(struct MarioState *m, const float *newPos, bool onGround, bool sneaking) {
+    bool space = key_held(VK_SPACE);
+    bool spaceEdge = space && !sMoveSpaceWas;
+    sMoveSpaceWas = space;
+    // (Holding Space hops again on landing, Minecraft's way: only a fresh press chains Mario's.)
+    sMoveSincePress = spaceEdge ? 0 : sMoveSincePress + 1;
+    bool freshPress = sMoveSincePress <= CHAIN_FRAMES + 2;
+    float dx = newPos[0] - m->pos[0], dz = newPos[2] - m->pos[2];
+    float speed = sqrtf(dx * dx + dz * dz) * 1.5f / UNITS_PER_BLOCK;  // units/frame -> blocks/tick
+    sMoveSpeed = fmaxf(speed, sMoveSpeed * 0.85f);
+    if (sMoveKickWait > 0) {
+        sMoveKickWait--;
+    }
+    bool takeoff = sMoveWasGround && !onGround && newPos[1] > m->pos[1];
+    bool landing = !sMoveWasGround && onGround;
+    sMoveWasGround = onGround;
+    sMoveAir = onGround ? 0 : sMoveAir + 1;
+    if (landing) {
+        sMoveLanded = 0;
+    } else if (onGround && ++sMoveLanded > CHAIN_FRAMES) {
+        sMoveChain = 0;
+    }
+    if ((sMc.flags & (MC_FLYING | MC_IN_FLUID)) || sCarried || speed > 3.0f) {
+        sMoveChain = 0;
+        return;  // (swimming, climbing, flying: Minecraft's own; a teleport isn't speed)
+    }
+    float yaw = sYaw * 3.14159265f / 180.0f;
+    float fwdX = -sinf(yaw), fwdZ = cosf(yaw);  // where Steve faces, in Minecraft's x and z
+
+    if (takeoff && space) {
+        if (sneaking && sMoveSpeed > 0.15f) {
+            // Long jump: from a run, crouch and jump. Far and low, like Mario's.
+            mario_move(fwdX * 0.75f, 0.38f, fwdZ * 0.75f, false, 0.0f);
+            sMoveChain = 0;
+        } else if (sneaking && sMoveSpeed < 0.06f) {
+            // Backflip: crouch and jump standing still. High, a little backwards.
+            mario_move(-fwdX * 0.12f, 0.78f, -fwdZ * 0.12f, false, 2.4f);
+            sMoveChain = 0;
+        } else if (freshPress && sMoveLanded <= CHAIN_FRAMES && sMoveChain == 2 && sMoveSpeed > 0.18f) {
+            mario_move(0, 0.72f, 0, true, 2.0f);  // triple jump
+            sMoveChain = 0;
+        } else if (freshPress && sMoveLanded <= CHAIN_FRAMES && sMoveChain == 1) {
+            mario_move(0, 0.56f, 0, true, 0.9f);  // double jump
+            sMoveChain = 2;
+        } else {
+            sMoveChain = 1;  // Minecraft's own jump: the first of a chain
+        }
+        return;
+    }
+    // Wall kick: Space while in the air, with a wall (SM64's, or a block) at Steve's side.
+    if (!onGround && spaceEdge && sMoveAir > 3 && sMoveKickWait == 0) {
+        struct WallCollisionData w = { 0 };
+        w.x = newPos[0];
+        w.y = newPos[1];
+        w.z = newPos[2];
+        w.offsetY = 60.0f;
+        w.radius = 60.0f;
+        find_wall_collisions(&w);
+        for (int i = 0; i < w.numWalls && i < 4; i++) {
+            struct Surface *wall = w.walls[i];
+            if (wall == NULL || mc_surface_skipped(wall)) {
+                continue;
+            }
+            float nx = wall->normal.x, nz = wall->normal.z, len = sqrtf(nx * nx + nz * nz);
+            if (len < 0.5f) {
+                continue;
+            }
+            nx /= len;
+            nz /= len;
+            mario_move(nx * 0.42f, 0.62f, nz * 0.42f, false, 1.4f);
+            m->particleFlags |= PARTICLE_VERTICAL_STAR;
+            sMoveKickWait = 8;
+            sMoveChain = 0;
+            break;
+        }
+    }
+}
+
+// True: Mario was put where Steve is; SM64 then only runs his interactions (coins, enemies,
+// paintings, death planes), not his own movement, and keeps him hidden.
+bool mariocraft_steve_drives_mario(struct MarioState *m) {
+    if (gMcShm == NULL || !sSteveActive || m->playerIndex != 0 || m->marioObj == NULL) {
+        return false;
+    }
+    if (sMc.flags & MC_DEAD) {
+        return false;  // Steve is on Minecraft's death screen: Mario waits where he is
+    }
+    // Cutscenes (grabbing a star, talking, going through a door...) play out as SM64's, but it's
+    // Steve they happen to: Mario is never seen.
+    if ((m->action & ACT_GROUP_MASK) == ACT_GROUP_CUTSCENE) {
+        sTrackDoor = NULL;
+        m->marioObj->header.gfx.node.flags |= GRAPH_RENDER_INVISIBLE;
+        return false;
+    }
+    if (is_carried_action(m->action)) {
+        if (!sCarried) {
+            sCarried = true;
+            sCarries++;
+        }
+        carried_frame(m);
+        return false;
+    }
+    if (sCarried) {
+        sCarried = false;
+        sSlideWait = 10;                // (out of a slide: not straight back into it)
+        set_grab_crouch(false);         // thrown: he stands up again
+        sSkyExtraFlags &= ~SKY_PUPPET;  // Minecraft lets go of him now, before the speed arrives
+        if (m->action & ACT_FLAG_AIR) {
+            hand_over_velocity(m);
+        }
+    }
+    // Something in SM64 moved Mario itself (a warp, a cannon...): Steve goes there too.
+    if (sHaveLastPuppetPos) {
+        float dx = m->pos[0] - sLastPuppetPos[0], dy = m->pos[1] - sLastPuppetPos[1], dz = m->pos[2] - sLastPuppetPos[2];
+        if (dx * dx + dy * dy + dz * dz > 60.0f * 60.0f) {
+            teleport_steve_to_mario(m);
+            sTrackDoor = NULL;
+            return false;
+        }
+    }
+    double originX = mc_origin_x(sWorldId);
+    float newPos[3] = {
+        (float) ((sMc.x - originX) * UNITS_PER_BLOCK),
+        (float) mc_to_sm64_y(sWorldId, sMc.y),
+        (float) (sMc.z * UNITS_PER_BLOCK),
+    };
+    // Inside something solid that moved into him (a Thwomp came down on him...): squished, and
+    // put back out.
+    if (steve_unstick(m, newPos)) {
+        sTrackDoor = NULL;
+        return false;
+    }
+    if (steve_fell_out(m, newPos, (sMc.flags & MC_ON_GROUND) != 0)) {
+        sTrackDoor = NULL;
+        return false;
+    }
+    // Walking or standing, as far as SM64 is concerned: doors only open for a walking Mario.
+    float mx = newPos[0] - m->pos[0], mz = newPos[2] - m->pos[2];
+    bool onGround = (sMc.flags & MC_ON_GROUND) != 0;
+    bool sneaking = (sMc.flags & MC_SNEAKING) != 0;
+    steve_mario_moves(m, newPos, onGround, sneaking);
+    if (!onGround) {
+        sAirTopY = sWasOnGround ? newPos[1] : fmaxf(sAirTopY, newPos[1]);
+        sSinceSneak = sneaking ? 0 : sSinceSneak + 1;
+    }
+    bool pound = onGround && !sWasOnGround && sAirTopY - newPos[1] >= 120.0f && (sneaking || sSinceSneak < 8);
+    sWasOnGround = onGround;
+    u32 newAction = (onGround && mx * mx + mz * mz > 2.0f * 2.0f) ? ACT_WALKING
+                  : onGround ? ACT_IDLE : ACT_FREEFALL;
+    // Leaning into something with W held but not getting anywhere: SM64's "pushing" (metal boxes
+    // slide away from Mario while he pushes them).
+    if (onGround && key_held('W') && mx * mx + mz * mz < 1.0f) {
+        m->flags |= MARIO_UNKNOWN_31;
+    } else {
+        m->flags &= ~MARIO_UNKNOWN_31;
+    }
+    if (pound) {
+        sPoundFrames = 5;
+        sPounds++;
+        mc_sound(SND_POUND);
+        m->particleFlags |= PARTICLE_MIST_CIRCLE | PARTICLE_HORIZONTAL_STAR;
+    }
+    if (sPoundFrames > 0) {
+        newAction = ACT_GROUND_POUND_LAND;
+    }
+    if (newAction != m->action) {
+        m->prevAction = m->action;
+        m->action = newAction;
+        m->actionState = 0;
+    } else if (sPoundFrames > 0 && !pound) {
+        m->actionState = 1;  // only the landing frame itself pounds what's under him
+    }
+    if (sPoundFrames > 0) {
+        sPoundFrames--;
+    }
+    // Falling speed counts too: landing on a Goomba squishes it, like when Mario does it.
+    float fall = newPos[1] - m->pos[1];
+    if (pound) {
+        fall = fminf(fall, -40.0f);  // SM64 only counts a ground pound on the way down
+    }
+    vec3f_copy(m->pos, newPos);
+    vec3f_set(m->vel, 0, fall, 0);
+    m->forwardVel = 0;
+    m->faceAngle[1] = (s16) (-sYaw * (65536.0f / 360.0f));
+    if (m->usedObj == NULL) {
+        m->usedObj = m->marioObj;  // (SM64 only lets Mario grab Hoot if he's "used" something before)
+    }
+    m->marioObj->header.gfx.angle[1] = m->faceAngle[1];  // which way a kicked Bob-omb flies
+    struct Surface *floor = NULL;
+    m->floorHeight = find_floor(m->pos[0], m->pos[1] + 100.0f, m->pos[2], &floor);
+    // Paintings: Mario enters one by jumping into it and landing on the warp floor behind it.
+    // Steve enters by walking (or jumping) into it: a painting's warp floor right in front of
+    // him, anywhere from his feet to his head, counts as his floor.
+    f32 paintingHeight = 0;
+    struct Surface *painting = painting_in_front(m, &paintingHeight);
+    if (painting != NULL) {
+        floor = painting;
+        m->floorHeight = paintingHeight;
+        snprintf(sDoorNote, sizeof(sDoorNote), "painting %02X", painting->type);
+        sPaintingFrames = 30;  // (going in: no dirt screen, SM64's own painting fade)
+    }
+    m->floor = floor;
+    if (floor != NULL) {
+        m->floorAngle = atan2s(floor->normal.z, floor->normal.x);
+    }
+    // Standing: right on the floor, as far as SM64 can tell. It counts Mario as on a platform
+    // (elevators, seesaws, switches, sinking and tilting platforms, Dorrie...) only within 4
+    // units of it, and Steve's height comes from Minecraft's ticks, a little behind a moving one.
+    if (onGround && floor != NULL && painting == NULL && fabsf(m->pos[1] - m->floorHeight) < 40.0f) {
+        m->pos[1] = m->floorHeight;
+    }
+    // On a slide: SM64 slides him down it on his backside, as it does Mario (carried from now on).
+    if (sSlideWait > 0) {
+        sSlideWait--;
+    } else if (onGround && floor != NULL && painting == NULL && steve_should_slide(m, mx, mz)) {
+        begin_steve_slide(m, mx, mz);
+    }
+    vec3f_copy(m->marioObj->header.gfx.pos, m->pos);
+    m->marioObj->oPosX = m->pos[0];
+    m->marioObj->oPosY = m->pos[1];
+    m->marioObj->oPosZ = m->pos[2];
+    m->marioObj->header.gfx.node.flags |= GRAPH_RENDER_INVISIBLE;
+    vec3f_copy(sLastPuppetPos, m->pos);
+    sHaveLastPuppetPos = true;
+    if (m->invincTimer > 0) {
+        m->invincTimer--;
+    }
+    steve_doors(m, mx, mz, onGround);
+    return true;
+}
+
+// While SM64 carries Steve (see is_carried_action), his keys are SM64's controller.
+static bool sHadCarried = false;
+
+static void carry_pad(struct MarioState *m) {
+    OSContPad *p = &gControllerPads[0];
+    memset(p, 0, sizeof(*p));
+    bool w = key_held('W'), a = key_held('A'), s = key_held('S'), d = key_held('D');
+    bool space = key_held(VK_SPACE), click = key_held(VK_LBUTTON), shift = key_held(VK_SHIFT);
+    s16 face = steve_face_yaw();
+    if (m->action & ACT_FLAG_ON_POLE) {
+        // A pole or tree: W and S climb, A and D go round it, Space jumps off, Shift lets go.
+        p->stick_y = (s8) (w ? 80 : s ? -80 : 0);
+        p->stick_x = (s8) (d ? 80 : a ? -80 : 0);
+        if (space) p->button |= A_BUTTON;
+        if (shift) p->button |= Z_TRIG;
+    } else if (m->action == ACT_IN_CANNON) {
+        // Aimed with the mouse (carried_frame); a click or Space fires.
+        if (space || click) p->button |= A_BUTTON;
+    } else if (m->action == ACT_RIDING_HOOT) {
+        // Hang on until Shift; Hoot turns the way Steve looks.
+        if (!shift) p->button |= A_BUTTON;
+        if (m->usedObj != NULL) {
+            s32 diff = (s16) (face - m->usedObj->oMoveAngleYaw);
+            s32 sx = -diff / 40;
+            p->stick_x = (s8) (sx > 64 ? 64 : sx < -64 ? -64 : sx);
+        }
+    } else {
+        // Anything else (a shell, a tornado, struggling free): WASD go the way Steve looks.
+        int fx = (d ? 1 : 0) - (a ? 1 : 0), fy = (w ? 1 : 0) - (s ? 1 : 0);
+        if (fx != 0 || fy != 0) {
+            float mvx = sins(face) * fy - coss(face) * fx;
+            float mvz = coss(face) * fy + sins(face) * fx;
+            s16 camYaw = (m->area != NULL && m->area->camera != NULL) ? m->area->camera->yaw : 0;
+            s16 r = (s16) (atan2s(mvz, mvx) - camYaw);
+            p->stick_x = (s8) (64.0f * sins(r));
+            p->stick_y = (s8) (-64.0f * coss(r));
+        }
+        if (space) p->button |= A_BUTTON;
+        if (click) p->button |= B_BUTTON;
+        if (shift) p->button |= Z_TRIG;
+    }
+}
+
+// ---- SM64 hurting Steve -------------------------------------------------------------------
+// Mario's health is 8 wedges; Steve's is 20 Minecraft health points (10 hearts). One wedge of
+// SM64 damage costs Steve 3 health (1.5 hearts), about a zombie's hit on Normal: a Goomba bump
+// is one wedge, a Bob-omb blast two, a Whomp or Thwomp three. Steve's armour still counts.
+#define IN_HURT          7
+#define HURT_MELEE       0
+#define HURT_OTHER       3
+#define MC_HP_PER_WEDGE  3.0f
+#define SKYRIM_TO_MC     5.0f  // SkyCombat divides what it's sent by this
+#define LAVA_HP          4.0f  // a touch of SM64 lava: like Minecraft lava's 4 a hit
+static int sLavaCooldown = 0;
+
+#define HURT_POWER_ATTACK (1 << 1)  // a big hit: Minecraft knocks Steve back harder
+
+// `attacker`: the enemy's stand-in in Minecraft (mc_actors.c), so Steve is knocked back away from
+// it and it counts as a mob's hit (red flash, hurt sound, armour, shield); 0 for none.
+#define IN_HURT_CAUSE    23  // how the next IN_HURT would kill him, 12 bytes of text per part
+
+// `cause`: how it reads when this hit finishes Steve off ("was chomped by a Chain Chomp"),
+// said in Minecraft's chat after his name (mc_names.c).
+static void hurt_steve_because(float mcHealth, uint16_t kind, uint32_t attacker, int32_t flags, const char *cause) {
+    if (cause != NULL && cause[0] != '\0') {
+        char text[48] = { 0 };
+        snprintf(text, sizeof(text), "%s", cause);
+        size_t len = strlen(text);
+        for (uint16_t part = 0; part < 4 && part * 12u <= len; part++) {
+            int32_t w[3];
+            memcpy(w, text + part * 12, 12);
+            push_input_xyz(IN_HURT_CAUSE, part, w[0], w[1], w[2]);
+        }
+    }
+    push_input_xyz(IN_HURT, kind, (int32_t) (mcHealth * SKYRIM_TO_MC * 100.0f), (int32_t) attacker, flags);
+}
+
+// Whatever SM64 did to Mario's health goes to Steve's hearts instead, and Mario stays healthy.
+static void steve_hurt_by_mario(struct MarioState *m) {
+    float wedges = m->hurtCounter / 4.0f;  // SM64 takes a quarter wedge per frame
+    struct Object *by = m->interactObj;
+    int32_t flags = (by != NULL && by->oDamageOrCoinValue >= 3) ? HURT_POWER_ATTACK : 0;
+    char cause[48] = "";
+    if (by != NULL) {
+        mc_enemy_death(by, cause, sizeof(cause));
+    } else if (m->floor != NULL && m->floor->type == SURFACE_BURNING) {
+        snprintf(cause, sizeof(cause), "tried to swim in lava");
+    }
+    hurt_steve_because(wedges * MC_HP_PER_WEDGE, HURT_MELEE, mc_actor_form_id(by), flags, cause);
+    m->hurtCounter = 0;
+    m->health = 0x880;
+    m->invincTimer = 30;  // SM64's own second of safety after a hit
+}
+
+// ---- SM64's squishes, for Steve ---------------------------------------------------------------
+// Something solid moved into Steve: a Thwomp or crusher came down on him, a platform rose into
+// him, a wall slid over him. Minecraft only stops the player moving into things, not things moving
+// into the player, so he ended up inside them (and was flung off ledges when they moved again).
+// Mario is squished in SM64: so is Steve (3 wedges) if it came down on him, and either way he's put
+// back out at the nearest side with ground to stand on (or on top), never pushed off an edge.
+static int sCrushCooldown = 0;
+static struct Object *sLastSolid = NULL;
+static float sLastSolidBottom = 0;
+
+static bool steve_unstick(struct MarioState *m, const float *feet) {
+    if (sCrushCooldown > 0) {
+        sCrushCooldown--;
+    }
+    // A moving object's top above his feet, right where he is.
+    struct Surface *top = NULL;
+    f32 topY = find_floor(feet[0], feet[1] + 800.0f, feet[2], &top);
+    if (top == NULL || top->object == NULL || topY < feet[1] + 20.0f) {
+        sLastSolid = NULL;
+        return false;
+    }
+    struct Object *o = top->object;
+    // The object's box, from its collision this frame.
+    float lo[3] = { 1e30f, 1e30f, 1e30f }, hi[3] = { -1e30f, -1e30f, -1e30f };
+    struct GrowingArray *pool = surface_get_dynamic_pool();
+    growing_array_for_each_(pool, struct Surface, s) {
+        if (s == NULL || s->object != o) {
+            continue;
+        }
+        const s16 *vs[3] = { s->vertex1, s->vertex2, s->vertex3 };
+        for (int i = 0; i < 3; i++) {
+            for (int k = 0; k < 3; k++) {
+                lo[k] = fminf(lo[k], vs[i][k]);
+                hi[k] = fmaxf(hi[k], vs[i][k]);
+            }
+        }
+    }
+    if (lo[0] > hi[0]) {
+        return false;  // (static collision of an object: it doesn't move into anyone)
+    }
+    bool movedDown = (o == sLastSolid && lo[1] < sLastSolidBottom - 0.5f) || o->oVelY < -1.0f;
+    sLastSolid = o;
+    sLastSolidBottom = lo[1];
+    const float r = 30.0f, height = 180.0f, in = 5.0f;  // Steve's half width and height (SM64 units)
+    // Its actual underside straight over him (not just its box: a Whomp tipping over has a box
+    // reaching far over the ground in front of it, long before its body gets there).
+    struct Surface *under = NULL;
+    f32 underY = find_ceil(feet[0], feet[1] + 5.0f, feet[2], &under);
+    bool overHead = under != NULL && under->object == o;
+    if (overHead && underY >= feet[1] + height) {
+        return false;  // all of it is above his head
+    }
+    bool inside = feet[0] + r > lo[0] + in && feet[0] - r < hi[0] - in && feet[2] + r > lo[2] + in && feet[2] - r < hi[2] - in
+               && feet[1] + height > lo[1] + in && feet[1] < hi[1] - in;
+    if (!inside) {
+        return false;
+    }
+    // Squished: it came down onto him (its underside over his feet, lower than his head).
+    if (movedDown && overHead && sCrushCooldown == 0 && !(m->flags & MARIO_METAL_CAP)) {
+        char cause[48];
+        mc_enemy_death(o, cause, sizeof(cause));
+        if (strncmp(cause, "was defeated", 12) == 0) {
+            snprintf(cause, sizeof(cause), "was squashed flat");  // (a platform, an elevator...)
+        }
+        hurt_steve_because(3 * MC_HP_PER_WEDGE, HURT_MELEE, 0, HURT_POWER_ATTACK, cause);
+        mc_sound(SND_CRUSH);
+        sCrushCooldown = 30;
+    }
+    // The nearest way out with ground under it at about his height.
+    const float margin = r + 15.0f;
+    float exits[4][2] = {
+        { lo[0] - margin, feet[2] }, { hi[0] + margin, feet[2] }, { feet[0], lo[2] - margin }, { feet[0], hi[2] + margin },
+    };
+    float best = 1e30f, out[3] = { 0, 0, 0 };
+    for (int i = 0; i < 4; i++) {
+        struct Surface *ground = NULL;
+        f32 gy = find_floor(exits[i][0], feet[1] + 100.0f, exits[i][1], &ground);
+        if (ground == NULL || ground->object == o || gy < feet[1] - 150.0f || gy > feet[1] + 60.0f) {
+            continue;  // a drop, a wall, or still the same object
+        }
+        float dx = exits[i][0] - feet[0], dz = exits[i][1] - feet[2];
+        float d = dx * dx + dz * dz;
+        if (d < best) {
+            best = d;
+            out[0] = exits[i][0];
+            out[1] = gy;
+            out[2] = exits[i][1];
+        }
+    }
+    if (best == 1e30f) {
+        if (hi[1] - feet[1] > 500.0f) {
+            return false;  // nowhere to go: leave him (Minecraft will push him out of it somehow)
+        }
+        out[0] = feet[0];  // on top of it
+        out[1] = hi[1] + 1.0f;
+        out[2] = feet[2];
+    }
+    vec3f_copy(m->pos, out);
+    teleport_steve_to_mario(m);
+    return true;
+}
+
+// ---- SM64's hazards, the Minecraft way ------------------------------------------------------
+// Minecraft runs Steve's movement, so SM64's own hazard code (which moves Mario) never reaches
+// him. Each hazard is done again here as something Minecraft has, by changing his speed (once
+// per Minecraft tick, from how far he moved last tick) or his hearts:
+//   quicksand ........ like a cobweb: he wades through it. Deep quicksand fills his lungs
+//                      (suffocation, a block's worth a second), the instant kind swallows him
+//                      (a death in SM64 too), and moving quicksand drags him along.
+//   wind ............. Rainbow Ride's gusts push him; an updraft lifts him like a bubble column.
+//   poison gas ....... Hazy Maze Cave's gas poisons him while he's in it (not with the metal cap).
+//   freezing water ... the water in snowy levels freezes him like powder snow.
+//   slides ........... very slippery slopes take his footing: he slides downhill as on ice.
+#define HURT_MAGIC        2
+#define MC_GROUND_FRICTION 0.546f  // Minecraft: what's left of his speed after a tick on the ground
+#define MC_AIR_FRICTION    0.91f   //                                                   in the air
+#define MC_ICE_FRICTION    0.89f   //                                                   on ice
+#define SM64_TO_MC_SPEED   0.015f  // SM64 units/frame -> blocks/tick (30 frames, 20 ticks a second)
+static char sHazardNote[24] = "";
+static int64_t sHazardTick = 0;    // the Minecraft tick Steve's speed was last changed for
+static int sHazardHurt = 0;        // frames until a hazard may hurt him again
+
+static bool is_quicksand(s16 type) {
+    switch (type) {
+        case SURFACE_SHALLOW_QUICKSAND: case SURFACE_SHALLOW_MOVING_QUICKSAND: case SURFACE_QUICKSAND:
+        case SURFACE_MOVING_QUICKSAND: case SURFACE_DEEP_QUICKSAND: case SURFACE_DEEP_MOVING_QUICKSAND:
+        case SURFACE_INSTANT_QUICKSAND: case SURFACE_INSTANT_MOVING_QUICKSAND:
+            return true;
+        default:
+            return false;
+    }
+}
+
+static void hazard_hurt(float mcHealth, uint16_t kind, int every, const char *cause) {
+    if (sHazardHurt == 0) {
+        hurt_steve_because(mcHealth, kind, 0, 0, cause);
+        sHazardHurt = every;
+    }
+}
+
+static void steve_hazards(struct MarioState *m) {
+    sHazardNote[0] = '\0';
+    if (sHazardHurt > 0) {
+        sHazardHurt--;
+    }
+    struct Surface *floor = m->floor;
+    bool onGround = (sMc.flags & MC_ON_GROUND) != 0;
+    bool metal = (m->flags & MARIO_METAL_CAP) != 0;
+    float aboveFloor = m->pos[1] - m->floorHeight;
+
+    // His speed last tick (blocks/tick), and whether a new tick has happened since we last set it.
+    float v[3] = { (float) (sMc.curX - sMc.prevX), (float) (sMc.curY - sMc.prevY), (float) (sMc.curZ - sMc.prevZ) };
+    bool newTick = sMc.tickQpc != sHazardTick;
+    bool push = false;
+    float friction = onGround ? MC_GROUND_FRICTION : MC_AIR_FRICTION;
+    v[0] *= friction;
+    v[2] *= friction;
+
+    // Quicksand.
+    if (floor != NULL && is_quicksand(floor->type) && onGround && aboveFloor < 30.0f) {
+        s16 t = floor->type;
+        float slow = (t == SURFACE_SHALLOW_QUICKSAND || t == SURFACE_SHALLOW_MOVING_QUICKSAND) ? 0.6f
+                   : (t == SURFACE_QUICKSAND || t == SURFACE_MOVING_QUICKSAND) ? 0.4f : 0.25f;
+        v[0] *= slow;
+        v[2] *= slow;
+        if (t == SURFACE_SHALLOW_MOVING_QUICKSAND || t == SURFACE_MOVING_QUICKSAND
+            || t == SURFACE_DEEP_MOVING_QUICKSAND || t == SURFACE_INSTANT_MOVING_QUICKSAND) {
+            static const float sandSpeeds[] = { 12, 8, 4, 0 };  // SM64's sMovingSandSpeeds
+            s16 angle = floor->force << 8;
+            float speed = sandSpeeds[(floor->force >> 8) & 3] * SM64_TO_MC_SPEED;
+            v[0] += speed * sins(angle);
+            v[2] += speed * coss(angle);
+        }
+        push = true;
+        if (t == SURFACE_INSTANT_QUICKSAND || t == SURFACE_INSTANT_MOVING_QUICKSAND) {
+            hazard_hurt(1000.0f, HURT_OTHER, 30, "was swallowed by quicksand");
+            snprintf(sHazardNote, sizeof(sHazardNote), "sand: swallowed");
+        } else if (t == SURFACE_DEEP_QUICKSAND || t == SURFACE_DEEP_MOVING_QUICKSAND) {
+            hazard_hurt(1.0f, HURT_OTHER, 15, "sank into quicksand");
+            snprintf(sHazardNote, sizeof(sHazardNote), "sand: sinking");
+        } else {
+            snprintf(sHazardNote, sizeof(sHazardNote), "sand");
+        }
+    }
+
+    // Wind: Rainbow Ride's gusts push sideways, an updraft lifts (SM64's apply_vertical_wind).
+    if (floor != NULL && floor->type == SURFACE_HORIZONTAL_WIND && aboveFloor < 400.0f) {
+        s16 angle = floor->force << 8;
+        float speed = onGround ? 0.06f : 0.02f;
+        v[0] += speed * sins(angle);
+        v[2] += speed * coss(angle);
+        push = true;
+        play_sound(SOUND_ENV_WIND2, m->marioObj->header.gfx.cameraToObject);
+        snprintf(sHazardNote, sizeof(sHazardNote), "wind");
+    }
+    if (floor != NULL && floor->type == SURFACE_VERTICAL_WIND && !onGround) {
+        float offsetY = m->pos[1] + 1500.0f;
+        if (offsetY > -3000.0f && offsetY < 2000.0f) {
+            float maxVelY = (offsetY >= 0.0f ? 10000.0f / (offsetY + 200.0f) : 50.0f) * SM64_TO_MC_SPEED;
+            if (v[1] < maxVelY) {
+                v[1] = fminf(maxVelY, v[1] + maxVelY / 8.0f);
+            }
+            push = true;
+            play_sound(SOUND_ENV_WIND2, m->marioObj->header.gfx.cameraToObject);
+            snprintf(sHazardNote, sizeof(sHazardNote), "updraft");
+        }
+    }
+
+    // Slides: SM64's very slippery slopes (and any steep slope in a slide level) are ice to him.
+    bool slideLevel = m->area != NULL && (m->area->terrainType & TERRAIN_MASK) == TERRAIN_SLIDE;
+    if (floor != NULL && onGround && aboveFloor < 30.0f && !push && floor->normal.y < 0.98f
+        && (mario_get_floor_class(m) == SURFACE_CLASS_VERY_SLIPPERY || (slideLevel && floor->normal.y < 0.94f))) {
+        float iceKeep = MC_ICE_FRICTION / MC_GROUND_FRICTION;  // undo his ground friction, then ice's
+        v[0] *= iceKeep;
+        v[2] *= iceKeep;
+        // Downhill is where the slope's normal leans; the steeper, the harder he's pulled.
+        v[0] += floor->normal.x * 0.08f;
+        v[2] += floor->normal.z * 0.08f;
+        float h = sqrtf(v[0] * v[0] + v[2] * v[2]);
+        if (h > 1.2f) {
+            v[0] *= 1.2f / h;
+            v[2] *= 1.2f / h;
+        }
+        v[1] = fminf(0.0f, v[1]);
+        push = true;
+        snprintf(sHazardNote, sizeof(sHazardNote), "sliding");
+    }
+
+    if (push && newTick) {
+        push_input_xyz(IN_VELOCITY, 0, (int32_t) (v[0] * 10000.0f), (int32_t) (v[1] * 10000.0f), (int32_t) (v[2] * 10000.0f));
+        sHazardTick = sMc.tickQpc;
+    }
+
+    // Poison gas, where SM64 counts Mario as in it (feet a little below the gas's top).
+    f32 gas = find_poison_gas_level(m->pos[0], m->pos[2]);
+    if (gas > gLevelValues.floorLowerLimit + 1.0f && m->pos[1] < gas - 100.0f && !metal) {
+        hazard_hurt(1.0f, HURT_MAGIC, 20, "choked on poison gas");
+        snprintf(sHazardNote, sizeof(sHazardNote), "poison gas");
+    }
+
+    // Freezing water: in a snowy level, more than half under the surface.
+    f32 water = find_water_level(m->pos[0], m->pos[2]);
+    bool snowy = m->area != NULL && (m->area->terrainType & TERRAIN_MASK) == TERRAIN_SNOW;
+    if (snowy && !metal && water > gLevelValues.floorLowerLimit + 1.0f && m->pos[1] < water - 90.0f) {
+        hazard_hurt(1.0f, HURT_OTHER, 40, "froze in icy water");
+        snprintf(sHazardNote, sizeof(sHazardNote), "freezing");
+    }
+}
+
+bool mariocraft_is_steve(struct MarioState *m);
+
+// Mario's own sounds (his action, movement and voice banks, played at him) are muted while he's
+// standing in for Steve, here or for a friend: Minecraft makes Steve's (audio/external.c).
+bool mariocraft_mute_sound(s32 soundBits, f32 *pos) {
+    u32 bank = ((u32) soundBits >> 28) & 0xF;
+    if (pos == NULL || (bank != SOUND_BANK_ACTION && bank != SOUND_BANK_MOVING && bank != SOUND_BANK_MARIO_VOICE)) {
+        return false;
+    }
+    for (int i = 0; i < MAX_PLAYERS; i++) {
+        struct MarioState *m = &gMarioStates[i];
+        if (m->marioObj != NULL && pos == m->marioObj->header.gfx.cameraToObject) {
+            return mariocraft_is_steve(m);
+        }
+    }
+    return false;
+}
+
+// A sound of Minecraft's for something SM64 did to Steve (MarioSounds.java).
+static void mc_sound(int code) {
+    push_input(IN_SOUND, (uint16_t) code, 0);
+}
+
+// This player is Steve (here, or a friend in the shared Minecraft world): no Mario voice for them
+// (characters.c).
+bool mariocraft_is_steve(struct MarioState *m) {
+    if (m == NULL) {
+        return false;
+    }
+    if (m->playerIndex == 0) {
+        return gMcShm != NULL && sSteveActive;
+    }
+    return mariocraft_hide_remote(m);
+}
+
+// The title screen's level (coopdx's main menu stands in one, Mario included): no Mario in it.
+bool mariocraft_hide_menu_mario(struct MarioState *m) {
+    if (m == NULL || m->playerIndex != 0 || gMcShm == NULL) {
+        return false;
+    }
+    // ...and never in a level while Steve is in Minecraft's world: not even for the moments SM64
+    // runs Mario itself while Minecraft puts Steve somewhere (pushed out of King Whomp after a
+    // ground pound, a warp): that showed Mario for a moment.
+    return gDjuiInMainMenu || (sMc.flags & MC_IN_WORLD) != 0;
+}
+
+// Called by mario.c right after Mario's interactions ran (only while he stands in for Steve).
+void mariocraft_after_interactions(struct MarioState *m) {
+    // SM64's lava boost (check_lava_boost, from mario_handle_special_floors) ran on the stand-in:
+    // 3 to 4.5 wedges for every frame he touches lava, which would kill Steve within a few frames.
+    // Steve gets Minecraft's lava below instead; the stand-in goes back to what it was doing.
+    if (m->action == ACT_LAVA_BOOST) {
+        m->hurtCounter = 0;
+        m->action = m->prevAction;
+    }
+    if (m->hurtCounter > 0) {
+        steve_hurt_by_mario(m);
+    }
+    steve_hazards(m);
+    // SM64 lava and fire floors burn Steve (Minecraft lava's 4 a hit, twice a second at most), and
+    // he hops off them as Mario does, so he can get out.
+    if (sLavaCooldown > 0) {
+        sLavaCooldown--;
+    }
+    bool onGround = (sMc.flags & MC_ON_GROUND) != 0;
+    if (m->floor != NULL && m->floor->type == SURFACE_BURNING && onGround
+        && m->pos[1] - m->floorHeight < 20.0f && sLavaCooldown == 0) {
+        if (!(m->flags & MARIO_METAL_CAP)) {
+            hurt_steve_because(LAVA_HP, HURT_OTHER, 0, 0, "tried to swim in lava");
+        }
+        float vx = (float) (sMc.curX - sMc.prevX) * MC_GROUND_FRICTION;
+        float vz = (float) (sMc.curZ - sMc.prevZ) * MC_GROUND_FRICTION;
+        push_input_xyz(IN_VELOCITY, 0, (int32_t) (vx * 10000.0f), (int32_t) (0.6f * 10000.0f), (int32_t) (vz * 10000.0f));
+        mc_sound(SND_BURN);
+        sLavaCooldown = 15;
+    }
+    m->health = 0x880;  // Mario himself never dies from this: Steve's hearts decide
+    // What SM64 would heal Mario (the spinning heart, coins: a quarter wedge per count) heals
+    // Steve instead, a wedge being 3 health (a coin: one and a half hearts).
+    if (m->healCounter > 0) {
+        push_input(IN_HEAL, 0, (int32_t) (m->healCounter * (MC_HP_PER_WEDGE / 4.0f) * 100.0f));
+        m->healCounter = 0;
+    }
+}
+
+// Where Steve's feet are right now (Minecraft blocks): between his last two Minecraft ticks, by the
+// time since the newest one. Minecraft moves him 20 times a second; drawing him (and looking
+// through his eyes) from where it last said he was jittered against SM64's frames, worst when
+// running. Its own figure for a frame (sMc.x...) can also arrive a frame late.
+static void steve_feet_now(double out[3]) {
+    static LARGE_INTEGER freq;
+    if (freq.QuadPart == 0) {
+        QueryPerformanceFrequency(&freq);
+    }
+    double t = 1.0;
+    if (sMc.tickQpc != 0 && sMc.tickMs > 1.0f) {
+        LARGE_INTEGER now;
+        QueryPerformanceCounter(&now);
+        double sinceMs = (double) (now.QuadPart - sMc.tickQpc) * 1000.0 / (double) freq.QuadPart;
+        t = sinceMs / sMc.tickMs;
+        t = t < 0.0 ? 0.0 : t > 1.0 ? 1.0 : t;
+    }
+    out[0] = sMc.prevX + (sMc.curX - sMc.prevX) * t;
+    out[1] = sMc.prevY + (sMc.curY - sMc.prevY) * t;
+    out[2] = sMc.prevZ + (sMc.curZ - sMc.prevZ) * t;
+    // (Nothing to go between yet, or a teleport: where Minecraft says he is.)
+    double dx = sMc.curX - sMc.prevX, dy = sMc.curY - sMc.prevY, dz = sMc.curZ - sMc.prevZ;
+    if (sMc.tickQpc == 0 || dx * dx + dy * dy + dz * dz > 25.0) {
+        out[0] = sMc.x;
+        out[1] = sMc.y;
+        out[2] = sMc.z;
+    }
+}
+
+// SM64's camera becomes Steve's eyes (or Minecraft's F5 views).
+static void mc_update_camera(bool active) {
+    extern f32 gOverrideNear;
+    if (!active) {
+        if (gMarioCraftCamera.active) {
+            gOverrideNear = 0;  // give SM64 its own near plane back
+        }
+        gMarioCraftCamera.active = false;
+        return;
+    }
+    double originX = mc_origin_x(sWorldId);
+    double feet[3];
+    steve_feet_now(feet);
+    // Eye height: Minecraft's, eased between ticks too (sneaking lowers it).
+    double eyeHeight = (sMc.tickEye > 0.1f) ? sMc.tickEye : (sMc.eyeY - sMc.y);
+    float eye[3] = {
+        (float) ((feet[0] - originX) * UNITS_PER_BLOCK),
+        (float) mc_to_sm64_y(sWorldId, feet[1] + eyeHeight),
+        (float) (feet[2] * UNITS_PER_BLOCK),
+    };
+    // Where Steve looks: our own yaw/pitch (no lag), Minecraft's axes. Not quite straight up or
+    // down: SM64's look-at maths has no answer for a camera pointing exactly along the vertical
+    // (every number turns into NaN and nothing in the world gets drawn: a black screen).
+    float pitch = sPitch > 89.5f ? 89.5f : (sPitch < -89.5f ? -89.5f : sPitch);
+    float yr = sYaw * 3.14159265f / 180.0f, pr = pitch * 3.14159265f / 180.0f;
+    float dir[3] = { -sinf(yr) * cosf(pr), -sinf(pr), cosf(yr) * cosf(pr) };
+    float dist = sMc.cameraDistance * (float) UNITS_PER_BLOCK;
+    if (sMc.cameraMode == 1) {         // behind Steve
+        for (int i = 0; i < 3; i++) {
+            gMarioCraftCamera.pos[i] = eye[i] - dir[i] * dist;
+            gMarioCraftCamera.focus[i] = eye[i];
+        }
+    } else if (sMc.cameraMode == 2) {  // in front, looking back at him
+        for (int i = 0; i < 3; i++) {
+            gMarioCraftCamera.pos[i] = eye[i] + dir[i] * dist;
+            gMarioCraftCamera.focus[i] = eye[i];
+        }
+    } else {                           // his eyes
+        for (int i = 0; i < 3; i++) {
+            gMarioCraftCamera.pos[i] = eye[i];
+            gMarioCraftCamera.focus[i] = eye[i] + dir[i] * 100.0f;
+        }
+    }
+    gMarioCraftCamera.fov = sMc.fovDeg > 10.0f ? sMc.fovDeg : 70.0f;
+    gMarioCraftCamera.active = true;
+    // SM64's sky (and its sound panning) go by Lakitu's camera: make that Steve's view too.
+    vec3f_copy(gLakituState.pos, gMarioCraftCamera.pos);
+    vec3f_copy(gLakituState.focus, gMarioCraftCamera.focus);
+    gOverrideNear = 8.0f;  // blocks right in front of Steve's face mustn't get clipped
+}
+
+// Called for every frame drawn (rendering_graph_node.c): Steve's camera from the newest mouse
+// movement and Minecraft's newest position, so looking around is as quick as the screen.
+// Minecraft gets the new look straight away too, which also makes it draw its hand and HUD
+// for every frame instead of every game tick.
+static bool camera_for_frame(f32 pos[3], f32 focus[3]);
+
+bool mariocraft_camera_for_frame(f32 pos[3], f32 focus[3]) {
+    mc_perf_frame_drawn();  // the real frame rate: this runs once for every frame on screen
+    double t0 = mc_perf_now();
+    // Minecraft's newest hand and HUD for every frame drawn. (Picking it up while SM64 built
+    // its frame only happened 30 times a second, however fast the screen went: a laggy hand.)
+    if (gMcShm != NULL) {
+        mc_overlay_poll();
+    }
+    double t1 = mc_perf_now();
+    mc_perf_add(PERF_OVERLAY, t1 - t0);
+    bool r = camera_for_frame(pos, focus);
+    mc_perf_add(PERF_CAMERA, mc_perf_now() - t1);
+    return r;
+}
+
+// The cutscene camera (see update): above and behind what the cutscene is about, on Steve's side
+// of it, never under the ground, easing after it as it moves (the Chain Chomp's jumps).
+static bool sFollowCut = false, sFollowInit = false;
+static f32 sFollowPos[3], sFollowFocus[3];
+
+static bool follow_camera(f32 pos[3], f32 focus[3]) {
+    extern struct Object *gCutsceneFocus;
+    struct Object *o = gCutsceneFocus;
+    if (o == NULL) {
+        return false;
+    }
+    f32 target[3] = { o->oPosX, o->oPosY + fmaxf(o->hitboxHeight * 0.5f, 60.0f), o->oPosZ };
+    // From the target toward Steve, flat: the camera sits on his side of it.
+    struct MarioState *m = &gMarioStates[0];
+    f32 dx = m->pos[0] - target[0], dz = m->pos[2] - target[2];
+    f32 len = sqrtf(dx * dx + dz * dz);
+    if (len < 1.0f) {
+        dx = sins(m->faceAngle[1] + 0x8000);
+        dz = coss(m->faceAngle[1] + 0x8000);
+        len = 1.0f;
+    }
+    f32 want[3] = { target[0] + dx / len * 1000.0f, target[1] + 450.0f, target[2] + dz / len * 1000.0f };
+    struct Surface *floor = NULL;
+    f32 ground = find_floor(want[0], want[1] + 2000.0f, want[2], &floor);
+    if (floor != NULL && want[1] < ground + 200.0f) {
+        want[1] = ground + 200.0f;
+    }
+    if (!sFollowInit) {
+        vec3f_copy(sFollowPos, want);
+        vec3f_copy(sFollowFocus, target);
+        sFollowInit = true;
+    }
+    for (int i = 0; i < 3; i++) {
+        sFollowPos[i] += (want[i] - sFollowPos[i]) * 0.12f;
+        sFollowFocus[i] += (target[i] - sFollowFocus[i]) * 0.25f;
+    }
+    vec3f_copy(pos, sFollowPos);
+    vec3f_copy(focus, sFollowFocus);
+    vec3f_copy(gLakituState.pos, pos);
+    vec3f_copy(gLakituState.focus, focus);
+    vec3f_copy(gMarioCraftCamera.pos, pos);
+    vec3f_copy(gMarioCraftCamera.focus, focus);
+    return true;
+}
+
+static bool camera_for_frame(f32 pos[3], f32 focus[3]) {
+    if (gMcShm == NULL || !gMarioCraftCamera.active) {
+        return false;
+    }
+    if (sFollowCut) {
+        read_mc_state();
+        double feet[3];
+        steve_feet_now(feet);
+        mc_render_avatar_frame(feet[0], feet[1], feet[2]);  // Steve stands in the shot
+        mc_render_frame();
+        write_sky_state(SKY_IN_GAME, sWorldId);  // (Minecraft draws a frame for each of ours)
+        return follow_camera(pos, focus);
+    }
+    if (gMarioCraftLockMouse) {
+        controller_mouse_read_relative();
+    }
+    apply_mouse_look();
+    if (sSteveHadControls && !sScreenOpen) {
+        forward_keys_and_mouse(false);  // keys too, every frame, not only every game tick
+    } else if (sScreenOpen) {
+        // An inventory, chest, crafting table...: the pointer goes to Minecraft for every frame
+        // drawn, not 30 times a second (dragging items felt laggy).
+        controller_mouse_read_window();
+        forward_keys_and_mouse(true);
+    }
+    read_mc_state();
+    mc_update_camera(true);
+    double feet[3];
+    steve_feet_now(feet);
+    mc_render_avatar_frame(feet[0], feet[1], feet[2]);  // Steve's body where the camera says he is
+    mc_render_frame();                                  // ...in Minecraft's newest pose, with everyone else
+    write_sky_state(SKY_IN_GAME, sWorldId);
+    for (int i = 0; i < 3; i++) {
+        pos[i] = gMarioCraftCamera.pos[i];
+        focus[i] = gMarioCraftCamera.focus[i];
+    }
+    return true;
+}
+
+// ---- frame rate ----------------------------------------------------------------------------
+// coopdx's frame loop (pc_main.c) asks us how fast to draw. Minecraft draws its hand and HUD once
+// for every frame drawn here, so with the frame rate on Unlimited (or a V-Sync the driver ignores)
+// both games were drawing 500+ frames a second, fighting over the GPU for nothing. Now it's the
+// screen's refresh rate at most, and never more than MC_MAX_FPS; a lower limit set in the game's
+// own options still wins.
+#define MC_MAX_FPS 165u
+static u32 sFrameCap = 0;
+
+void mariocraft_limit_frames(u32 *refreshRate, bool *shouldDelay, u32 displayRefreshRate) {
+    if (gMcShm == NULL) {
+        sFrameCap = 0;
+        return;
+    }
+    u32 cap = displayRefreshRate >= 30 ? displayRefreshRate : 60;
+    if (configWindow.vsync) {
+        while (cap > MC_MAX_FPS) {
+            cap /= 2;  // every other refresh (240 Hz: 120), so V-Sync still paces it evenly
+        }
+    } else if (cap > MC_MAX_FPS) {
+        cap = MC_MAX_FPS;
+    }
+    if (cap < 30) {
+        cap = 30;
+    }
+    if (*shouldDelay && *refreshRate < cap) {
+        cap = *refreshRate;
+    }
+    *refreshRate = cap;
+    *shouldDelay = true;
+    sFrameCap = cap;
+}
+
+// ---- timing --------------------------------------------------------------------------------
+static double sPerfMs[PERF_SLOTS], sPerfShown[PERF_SLOTS];
+static int sFramesDrawn = 0, sFps = 0, sMcFps = 0;
+static int sTicks = 0, sTps = 0;
+static double sPerfWindowStart = 0;
+static uint64_t sMcFramesAtStart = 0;
+
+double mc_perf_now(void) {
+    static LARGE_INTEGER freq;
+    LARGE_INTEGER now;
+    if (freq.QuadPart == 0) {
+        QueryPerformanceFrequency(&freq);
+    }
+    QueryPerformanceCounter(&now);
+    return (double) now.QuadPart * 1000.0 / (double) freq.QuadPart;
+}
+
+void mc_perf_add(int slot, double ms) {
+    if (slot >= 0 && slot < PERF_SLOTS) {
+        sPerfMs[slot] += ms;
+    }
+}
+
+void mc_perf_frame_drawn(void) {
+    sFramesDrawn++;
+    double now = mc_perf_now();
+    if (sPerfWindowStart == 0) {
+        sPerfWindowStart = now;
+        sMcFramesAtStart = sMc.frameCounter;
+    }
+    if (now - sPerfWindowStart >= 1000.0) {
+        double secs = (now - sPerfWindowStart) / 1000.0;
+        sFps = (int) (sFramesDrawn / secs + 0.5);
+        sTps = (int) (sTicks / secs + 0.5);
+        sTicks = 0;
+        sMcFps = (int) ((double) (sMc.frameCounter - sMcFramesAtStart) / secs + 0.5);
+        for (int i = 0; i < PERF_SLOTS; i++) {
+            sPerfShown[i] = sPerfMs[i] / secs;  // milliseconds per second of play
+            sPerfMs[i] = 0;
+        }
+        sFramesDrawn = 0;
+        sPerfWindowStart = now;
+        sMcFramesAtStart = sMc.frameCounter;
+    }
+}
+
+// Status lines in the corner for sorting out problems: F7 shows/hides them (hidden to start with).
+static bool sShowStatus = false;
+static bool sF7Down = false;
+static char sStatus[320];
+
+static char sPerfLine[200];
+
+const char *mariocraft_status_text(void) {
+    return sShowStatus && sStatus[0] ? sStatus : NULL;
+}
+
+// Third line: digging, doors and paintings, and what the level was judged to be made of.
+const char *mariocraft_extra_text(void) {
+    if (!sShowStatus) {
+        return NULL;
+    }
+    static char line[320];
+    int n = mc_dig_status(line, sizeof(line));
+    if (n < 0 || n >= (int) sizeof(line)) {
+        n = 0;
+    }
+    int a = mc_actors_status(line + n, (int) sizeof(line) - n);
+    if (a > 0 && n + a < (int) sizeof(line)) {
+        n += a;
+    }
+    a = mc_lobby_status(line + n, (int) sizeof(line) - n);
+    if (a > 0 && n + a < (int) sizeof(line)) {
+        n += a;
+    }
+    const struct Surface *floor = gMarioStates[0].floor;
+    snprintf(line + n, sizeof(line) - (size_t) n, "   %s %s   touching:%08X   floor:%02X/%.2f grid+%d pounds:%d   %s", sDoorNote, sHazardNote,
+             gMarioStates[0].marioObj != NULL ? (unsigned) gMarioStates[0].marioObj->collidedObjInteractTypes : 0u,
+             floor != NULL ? (unsigned) floor->type : 0xFFu, floor != NULL ? floor->normal.y : 0.0f,
+             mc_origin_y_units(sWorldId), sPounds, mc_collision_material_summary());
+    return line;
+}
+
+const char *mariocraft_perf_text(void) {
+    if (!sShowStatus) {
+        return NULL;
+    }
+    snprintf(sPerfLine, sizeof(sPerfLine),
+             "FPS %d (limit %u, game %d/s)   Minecraft FPS %d   ms/sec: update %.0f  read %.0f  build %.0f  camera %.0f  HUD %.0f",
+             sFps, (unsigned) sFrameCap, sTps, sMcFps, sPerfShown[PERF_UPDATE], sPerfShown[PERF_DRAIN], sPerfShown[PERF_GEO],
+             sPerfShown[PERF_CAMERA], sPerfShown[PERF_OVERLAY]);
+    return sPerfLine;
+}
+
+static void update(void);
+
+void mariocraft_update(void) {
+    sTicks++;
+    double t0 = mc_perf_now();
+    update();
+    mc_lobby_update(gMcShm != NULL && sSteveActive);
+    mc_steve_update();
+    mc_music_update(gMcShm != NULL && (sMc.flags & MC_IN_WORLD) != 0 && header()->mcPid != 0);
+    mc_perf_add(PERF_UPDATE, mc_perf_now() - t0);
+}
+
+static void update(void) {
+    if (gMcShm == NULL) {
+        return;
+    }
+    header()->skyrimHeartbeatMs = GetTickCount64();
+
+    struct MarioState *m = &gMarioStates[0];
+    bool inLevel = !gDjuiInMainMenu && m->marioObj != NULL && gCurrLevelNum > 1;
+
+    mc_render_drain();
+    mc_overlay_poll();
+    read_mc_state();
+
+    if (!inLevel) {
+        mc_render_set_world(0xFFFFFFFFu);
+        mc_render_set_avatar(false, 0, 0, 0);
+        mc_overlay_set_visible(false);
+        set_screen_mode(false);
+        mc_update_camera(false);
+        gMarioCraftCapturePad = false;
+        gMarioCraftOwnsMouse = gMarioCraftLockMouse = gMarioCraftWantsPointer = false;
+        sSteveActive = false;
+        sRehoming = false;
+        update_fade(m, false);
+        write_sky_state(SKY_LOADING, 0);
+        return;
+    }
+
+    // Each level/area lives in its own patch of the Minecraft world.
+    uint32_t worldId = (uint32_t) gCurrLevelNum * 16u + (uint32_t) gCurrAreaIndex;
+    if (worldId != sLastWorldId) {
+        sLastWorldId = worldId;
+        sWorldId = worldId;
+        sEpoch++;
+        mc_origin_y_compute(worldId);  // before anything goes to Minecraft in this area's heights
+        mc_dig_area_changed();
+        teleport_steve_to_mario(m);  // Steve starts where Mario spawns
+        sHaveSafePos = false;        // (the last area's ground isn't this one's)
+        sOutFrames = 0;
+        printf("[MarioCraft] level %d area %d\n", gCurrLevelNum, gCurrAreaIndex);
+    }
+    // Send the area's shape to Minecraft: on entering it, and again whenever a (new) Minecraft
+    // shows up, since a freshly started Minecraft knows nothing.
+    uint32_t mcPid = header()->mcPid;
+    if (worldId != sExportedWorldId || (mcPid != 0 && mcPid != sLastMcPid)) {
+        if (mcPid != sLastMcPid && worldId == sExportedWorldId) {
+            sEpoch++;
+            teleport_steve_to_mario(m);
+        }
+        sLastMcPid = mcPid;
+        sExportedWorldId = worldId;
+        mc_collision_export(worldId, sEpoch);
+    }
+    mc_collision_pump();
+    mc_dig_update(worldId);  // holes Steve dug: collision and visuals
+    mc_render_set_world(worldId);
+    mc_render_update_collision(worldId);
+
+    bool mcInWorld = (sMc.flags & MC_IN_WORLD) != 0;
+    bool screenOpen = mcInWorld && (sMc.flags & MC_SCREEN_OPEN) != 0;
+
+    // SM64's caps on Steve: the wing cap lets him fly (Minecraft's creative flight: double-tap
+    // Space). The vanish cap lets him through vanish-cap walls (mc_moving.c); the metal cap keeps
+    // enemies and lava from hurting him (SM64 already does no damage to metal Mario).
+    sSkyExtraFlags = ((m->flags & MARIO_WING_CAP) ? SKY_WING_CAP : 0) | ((m->flags & MARIO_METAL_CAP) ? SKY_METAL_CAP : 0)
+                   | ((m->flags & MARIO_VANISH_CAP) ? SKY_VANISH_CAP : 0);
+
+    // SM64's enemies: what Steve did to them in Minecraft, and where they are now for him to hit.
+    mc_actors_events(worldId);
+    mc_actors_write(worldId, m);
+    mc_moving_write(worldId, m);  // platforms, crates, gates... for Steve to stand on
+    write_water_grid(worldId);
+
+    // Steve died in Minecraft: in a course that's Mario losing a life (out to the castle, like
+    // SM64); once Minecraft respawns him, he comes back to wherever Mario is.
+    // Minecraft doesn't let Steve really die while he's Mario's (MarioLives.java: no death screen,
+    // no respawn; his health comes back): it says so with an event, and that's a lost life.
+    bool dead = mcInWorld && (sMc.flags & MC_DEAD) != 0;
+    bool lostLife = mc_actors_take_steve_died();
+    if (sLifeCooldown > 0) {
+        sLifeCooldown--;
+    }
+    if (lostLife && !dead && sLifeCooldown == 0) {
+        sLifeCooldown = 150;  // (one life for one death, however many hits finish him off)
+        steve_back_to_safety(m);  // (out of the void, the lava, whatever got him, while SM64 takes him out)
+        if (gCurrCourseNum != COURSE_NONE && sCurrPlayMode == PLAY_MODE_NORMAL) {
+            level_trigger_warp(m, WARP_OP_DEATH);
+        }
+    }
+    if (dead && !sSteveDead) {
+        sSteveDead = true;
+        if (gCurrCourseNum != COURSE_NONE && sCurrPlayMode == PLAY_MODE_NORMAL) {
+            level_trigger_warp(m, WARP_OP_DEATH);
+        }
+    } else if (sSteveDead && mcInWorld && !(sMc.flags & MC_DEAD)) {
+        sSteveDead = false;
+        teleport_steve_to_mario(m);
+    }
+
+    // Steve takes over once Minecraft has put him where we asked.
+    if (mcInWorld && !sSteveActive && sMc.teleportAck == sTeleportSeq) {
+        sSteveActive = true;
+        sRehoming = false;
+    }
+    if (!mcInWorld) {
+        sSteveActive = false;
+    }
+
+    // SM64 needs its own controls back for its text boxes, cutscenes (the intro, star grabs) and
+    // pause menu, and until Minecraft has Steve in place. The rest of the time every key is
+    // Minecraft's and Mario never reads the controller.
+    extern s32 gDialogID;
+    bool cutscene = (m->action & ACT_GROUP_MASK) == ACT_GROUP_CUTSCENE;
+    // SM64 showing something happen out in the level (the Chain Chomp breaking free, a star
+    // appearing, a cannon opening, Bowser arriving): its camera shows it, Steve stands there.
+    bool worldCut = world_cutscene();
+    bool sm64Busy = !sSteveActive || cutscene || worldCut || gDialogID != DIALOG_NONE || sCurrPlayMode == PLAY_MODE_PAUSED;
+    bool carried = sCarried && sSteveActive && !sm64Busy;  // see is_carried_action
+    bool steveControls = mcInWorld && !sm64Busy;
+    if ((steveControls && !gMarioCraftCapturePad) || (sHadCarried && !carried)
+        || (sRehoming && !sSteveActive && !cutscene && gDialogID == DIALOG_NONE)) {
+        memset(&gControllerPads[0], 0, sizeof(gControllerPads[0]));
+    }
+    // P: SM64's pause menu (Exit Course goes back to the castle). Its own Start key is Space,
+    // which is Steve's jump, and the controller is Minecraft's while Steve plays.
+    if (steveControls && !screenOpen && key_held('P')) {
+        gControllerPads[0].button |= START_BUTTON;
+    }
+    if (!steveControls && sSteveHadControls) {
+        release_everything();  // nothing stays held in Minecraft while SM64 has the keys
+    }
+    sSteveHadControls = steveControls;
+    gMarioCraftCapturePad = steveControls;
+    memset(&gMarioCraftPad, 0, sizeof(gMarioCraftPad));
+    if (carried) {
+        carry_pad(m);  // Steve's keys also steer what's carrying him
+    }
+    sHadCarried = carried;
+    sSkyExtraFlags |= (sCarried && sSteveActive) ? SKY_PUPPET : 0;
+    sSkyExtraFlags |= worldCut ? SKY_SHOW_BODY : 0;
+    sSkyExtraFlags |= (sCarried && sSteveActive && is_slide_action(m->action)) ? SKY_SLIDING : 0;
+    // Underwater levels: Steve breathes in their water (Minecraft's Water Breathing, MarioCaps).
+    switch (gCurrLevelNum) {
+        case LEVEL_JRB: case LEVEL_DDD: case LEVEL_SA: case LEVEL_WDW:
+            sSkyExtraFlags |= SKY_WATER_LEVEL;
+            break;
+        default:
+            break;
+    }
+
+    set_screen_mode(screenOpen);
+    gMarioCraftWantsPointer = screenOpen;
+    gMarioCraftLockMouse = steveControls && !screenOpen && game_has_keyboard();
+    if (steveControls || screenOpen) {
+        minecraft_controls(mcInWorld && sWasMcInWorld);
+    } else {
+        gMarioCraftOwnsMouse = false;  // SM64's mouse buttons work again (text boxes...)
+    }
+
+    // Steve's own view, always (doors and warps fade to black over it), except for SM64's
+    // cutscenes out in the level: those are SM64's camera, with Steve standing in the shot.
+    mc_update_camera(sSteveActive && !worldCut);
+    // A cutscene about something out in the level (the Chain Chomp breaking free, a star
+    // appearing...): our own camera follows it (camera_for_frame), not SM64's, which started from
+    // Steve's eyes at ground level and ended up in the ground.
+    extern struct Object *gCutsceneFocus;
+    bool follow = worldCut && sSteveActive && gCutsceneFocus != NULL && gCamera != NULL
+               && (gCamera->cutscene == CUTSCENE_STAR_SPAWN || gCamera->cutscene == CUTSCENE_RED_COIN_STAR_SPAWN
+                   || gCamera->cutscene == CUTSCENE_CAP_SWITCH_PRESS || gCamera->cutscene == CUTSCENE_PREPARE_CANNON);
+    if (follow != sFollowCut) {
+        sFollowCut = follow;
+        sFollowInit = false;
+    }
+    if (sFollowCut) {
+        gMarioCraftCamera.active = true;
+        gMarioCraftCamera.fov = 60.0f;
+    }
+    mc_render_set_avatar(sSteveActive && (worldCut || sMc.cameraMode != 0), sMc.x, sMc.y, sMc.z);
+    if (worldCut) {
+        mc_render_avatar_frame(sMc.x, sMc.y, sMc.z);  // (Steve's camera isn't placing it now)
+    }
+    update_fade(m, true);
+    // A right click: pick up / put down what's in front of Steve, or talk to someone / read a
+    // sign. A left click while carrying something throws it.
+    bool rmb = (GetAsyncKeyState(VK_RBUTTON) & 0x8000) != 0 && game_has_keyboard();
+    if (rmb && !sRmbDown && steveControls && !screenOpen) {
+        steve_use(m);
+    }
+    sRmbDown = rmb;
+    bool lmb = (GetAsyncKeyState(VK_LBUTTON) & 0x8000) != 0 && game_has_keyboard();
+    if (lmb && !sLmbDown && steveControls && !screenOpen && m->heldObj != NULL) {
+        steve_throw(m);
+    }
+    sLmbDown = lmb;
+    mc_overlay_set_visible(mcInWorld && !worldCut && !sStarSelectNow);  // no hand or hotbar over SM64's camera
+
+    // Minecraft draws one frame per SkyState update: while Steve's camera is on, the frame
+    // drawing (camera_for_frame) sends it once per SM64 frame; otherwise it goes from here.
+    if (!gMarioCraftCamera.active) {
+        write_sky_state(SKY_IN_GAME, worldId);
+    }
+
+    bool f7 = (GetAsyncKeyState(VK_F7) & 0x8000) != 0 && game_has_keyboard();
+    if (f7 && !sF7Down) {
+        sShowStatus = !sShowStatus;
+    }
+    sF7Down = f7;
+    snprintf(sStatus, sizeof(sStatus),
+             "MarioCraft step 32 | Minecraft:%s  Steve:%s  keys:%s  MCscreen:%s  dialog:%d  cutscene:%s  paused:%s  tp:%u/%u  moves:%d  (F7 hides)",
+             mcInWorld ? "in world" : "not in world", sSteveActive ? "active" : "waiting",
+             steveControls ? (carried ? "Minecraft (carried)" : "Minecraft") : worldCut ? "SM64 cutscene" : "SM64",
+             screenOpen ? "OPEN" : "closed", (int) gDialogID,
+             cutscene ? "yes" : "no", sCurrPlayMode == PLAY_MODE_PAUSED ? "yes" : "no",
+             sMc.teleportAck, sTeleportSeq, sMoveCount);
+
+    if (mcInWorld != sWasMcInWorld) {
+        sWasMcInWorld = mcInWorld;
+        printf("[MarioCraft] Minecraft %s\n", mcInWorld ? "connected" : "left the world");
+        djui_popup_create(mcInWorld ? "\\#a0ffa0\\MarioCraft:\\#ffffff\\ You're Steve! WASD move, mouse look, Space jump, Ctrl sprint, Shift sneak, F5 camera, T chat."
+                                    : "\\#ffa0a0\\MarioCraft:\\#ffffff\\ Minecraft disconnected.", 2);
+        if (!mcInWorld) {
+            set_screen_mode(false);
+            sMouseGrabbed = false;
+            gMarioCraftOwnsMouse = false;
+        }
+    }
+}
+
+#else  // not Windows: the link is Windows-only for now
+
+#include <stddef.h>
+#include "sm64.h"
+#include "mariocraft_internal.h"
+uint8_t *gMcShm = NULL;
+
+struct MarioCraftCamera gMarioCraftCamera = { 0 };
+bool gMarioCraftOwnsMouse = false;
+bool gMarioCraftLockMouse = false;
+bool gMarioCraftWantsPointer = false;
+
+void mariocraft_init(void) {}
+void mariocraft_update(void) {}
+bool mariocraft_steve_drives_mario(struct MarioState *m) { (void) m; return false; }
+void mariocraft_after_interactions(struct MarioState *m) { (void) m; }
+bool mariocraft_is_steve(struct MarioState *m) { (void) m; return false; }
+bool mariocraft_hide_menu_mario(struct MarioState *m) { (void) m; return false; }
+void mariocraft_painting_warp(void) {}
+void mariocraft_star_select_shown(void) {}
+void mariocraft_after_objects(void) {}
+bool mariocraft_mute_sound(s32 soundBits, f32 *pos) { (void) soundBits; (void) pos; return false; }
+bool mariocraft_take_text(const char *text) { (void) text; return false; }
+bool mariocraft_camera_for_frame(f32 pos[3], f32 focus[3]) { (void) pos; (void) focus; return false; }
+void mariocraft_mouse_moved(s32 dx, s32 dy) { (void) dx; (void) dy; }
+const char *mariocraft_status_text(void) { return NULL; }
+const char *mariocraft_perf_text(void) { return NULL; }
+const char *mariocraft_extra_text(void) { return NULL; }
+double mc_perf_now(void) { return 0; }
+void mc_perf_add(int slot, double ms) { (void) slot; (void) ms; }
+void mc_perf_frame_drawn(void) {}
+void mariocraft_limit_frames(u32 *refreshRate, bool *shouldDelay, u32 displayRefreshRate) {
+    (void) refreshRate; (void) shouldDelay; (void) displayRefreshRate;
+}
+
+#endif
diff --git a/src/pc/mariocraft/mariocraft.h b/src/pc/mariocraft/mariocraft.h
new file mode 100644
index 000000000..296639cde
--- /dev/null
+++ b/src/pc/mariocraft/mariocraft.h
@@ -0,0 +1,28 @@
+#ifndef MARIOCRAFT_H
+#define MARIOCRAFT_H
+
+// MarioCraft: links this game to a hidden Minecraft (the SkyCraft-based Fabric mod) through
+// shared memory. SM64 plays the part Skyrim plays in SkyCraft: it creates the mapping, and
+// Mario is the boss. The Minecraft player follows him around.
+
+#include <stdbool.h>
+
+void mariocraft_init(void);
+void mariocraft_update(void);
+
+// While active, SM64's camera is Steve's: set by mariocraft.c, used by rendering_graph_node.c.
+struct MarioCraftCamera {
+    bool active;
+    float pos[3], focus[3];
+    float fov;  // vertical, degrees
+};
+extern struct MarioCraftCamera gMarioCraftCamera;
+
+// A player's HUD head (16x16 RGBA16): a Steve's is their Minecraft skin's face (mc_steve.c), anyone
+// else's is `fallback` (their character's). By local player index.
+const void *mariocraft_head_texture(int localIndex, const void *fallback);
+
+// The star select is on screen this frame (star_select.c): MarioCraft's dirt screen stays off it.
+void mariocraft_star_select_shown(void);
+
+#endif
diff --git a/src/pc/mariocraft/mariocraft_internal.h b/src/pc/mariocraft/mariocraft_internal.h
new file mode 100644
index 000000000..ae1dde227
--- /dev/null
+++ b/src/pc/mariocraft/mariocraft_internal.h
@@ -0,0 +1,155 @@
+#ifndef MARIOCRAFT_INTERNAL_H
+#define MARIOCRAFT_INTERNAL_H
+
+// Shared between the MarioCraft source files. Layout constants mirror SkyCraft's
+// protocol/skycraft_protocol.h (version 11) and fabric/.../link/Proto.java.
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#define MC_MAGIC           0x43594B53u  // "SKYC"
+#define MC_VERSION         11u
+#define MC_MAPPING_NAME    L"Local\\MarioCraft_v1"
+
+#define OFF_HEADER         0x0ull
+#define OFF_SKY_STATE      0x100ull
+#define OFF_MC_STATE       0x200ull
+#define OFF_COLLISION_RING 0x20000ull
+#define COLLISION_RING_BYTES (32ull << 20)
+#define OFF_OVERLAY_PIXELS (OFF_COLLISION_RING + COLLISION_RING_BYTES)
+#define OVERLAY_SLOT_BYTES (3840ull * 2160ull * 4ull)
+#define OVERLAY_SLOTS      3ull
+#define OFF_RENDER_RING    (OFF_OVERLAY_PIXELS + OVERLAY_SLOT_BYTES * OVERLAY_SLOTS)
+#define RENDER_RING_BYTES  (64ull << 20)
+// MarioCraft's own addition at the end: SM64's moving and solid objects (mc_moving.c).
+#define OFF_MOVING         (OFF_RENDER_RING + RENDER_RING_BYTES)
+#define MOVING_BYTES       (256ull << 10)
+#define MAPPING_BYTES      (OFF_MOVING + MOVING_BYTES)
+
+// Header word Minecraft checks before using MarioCraft's additions (Proto.H_FEATURES).
+#define OFF_FEATURES       0x20ull
+#define FEATURE_MOVING     (1u << 0)
+#define FEATURE_LOBBY      (1u << 1)  // the multiplayer lobby block (mc_lobby.c)
+
+// Collision ring (SM64 writes, Minecraft reads)
+#define CR_HEAD       0x00ull
+#define CR_TAIL       0x40ull
+#define CR_DATA       0x80ull
+#define CR_DATA_BYTES (COLLISION_RING_BYTES - CR_DATA)
+#define COL_PAD    0u
+#define COL_CLEAR  1u
+#define COL_REGION 2u
+#define COL_TRIS   3u
+
+#define MC_REGION_SIZE 8  // blocks per collision region edge (SkyCollision.REGION_SIZE)
+
+// 1 Minecraft block = 100 SM64 units; each level/area gets its own patch of the Minecraft world.
+#define UNITS_PER_BLOCK 100.0
+#define LEVEL_SPACING   256.0
+#define LEVEL_ORIGIN_X  10000.0
+
+extern uint8_t *gMcShm;  // the shared mapping (NULL if it couldn't be created)
+
+static inline double mc_origin_x(uint32_t worldId) {
+    return LEVEL_ORIGIN_X + (double) worldId * LEVEL_SPACING;
+}
+
+// Heights. SM64's floors sit at any height, Minecraft's blocks at whole numbers, so each area's
+// patch is lowered by 0-99 SM64 units: its most common floor height then falls exactly on a block
+// boundary, and blocks placed on that ground sit flush on it instead of floating or sinking.
+// (mc_collision.c works it out from the area's own floors: the same every time it loads.)
+int mc_origin_y_units(uint32_t worldId);               // 0..99
+void mc_origin_y_compute(uint32_t worldId);           // the current area: work it out now
+static inline double sm64_to_mc_y(uint32_t worldId, double y) {
+    return (y - mc_origin_y_units(worldId)) / UNITS_PER_BLOCK;
+}
+static inline double mc_to_sm64_y(uint32_t worldId, double y) {
+    return y * UNITS_PER_BLOCK + mc_origin_y_units(worldId);
+}
+
+// mc_collision.c
+void mc_collision_reset(void);                          // new mapping: forget what was sent
+void mc_collision_export(uint32_t worldId, uint32_t epoch);  // send the current area's shape
+void mc_collision_pump(void);                           // move queued messages into the ring
+void mc_collision_refresh_box(int x0, int y0, int z0, int x1, int y1, int z1);  // holes changed there
+const char *mc_collision_material_summary(void);        // what the area was judged to be made of
+struct Surface;
+bool mc_surface_skipped(const struct Surface *s);       // not collision for Steve (camera walls...)
+bool mc_surface_walkable(const struct Surface *s, uint16_t terrainType);  // Mario walks up it
+
+// mc_moving.c: SM64's moving and solid objects, every game frame
+struct MarioState;
+void mc_moving_enable(bool enabled);                    // the mapping has room for them
+void mc_moving_write(uint32_t worldId, struct MarioState *m);
+
+// mc_material.c: what the level is made of, judged by its textures
+void mc_material_scan(void);                            // look at the current area's visible triangles
+int mc_material_for(const float *v, const float *n, uint16_t terrain);  // Proto.DIG_* or 0
+int mc_material_visible_count(void);
+
+// mc_dig.c: holes dug into Mario's level (Minecraft block coordinates, absolute)
+bool mc_dig_any(void);
+bool mc_dig_is_dug(int x, int y, int z);
+void mc_dig_read(const uint8_t *payload, uint32_t bytes);  // a REN_DUG message
+void mc_dig_update(uint32_t worldId);                     // apply changes (collision, visible holes)
+void mc_dig_area_changed(void);                           // SM64 loaded another area
+int mc_dig_status(char *out, int size);                   // for the status line
+
+// mc_render.c
+void mc_render_drain(void);                         // read Minecraft's meshes/textures
+void mc_render_update_collision(uint32_t worldId);  // keep block collision in step for Mario
+void mc_render_set_world(uint32_t worldId);         // which patch to draw (0xFFFFFFFF: none)
+void mc_render_set_avatar(bool show, double x, double y, double z);  // Steve's body (F5), feet in MC coords
+void mc_render_avatar_frame(double x, double y, double z);          // where his body is this frame drawn
+void mc_render_frame(void);                         // every frame drawn: newest poses of bodies and mobs
+
+// mc_actors.c: SM64's enemies as things Steve can hit
