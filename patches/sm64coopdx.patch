+// ---- talking and reading ----------------------------------------------------------------------
+// Mario talks to Bob-omb Buddies and Toads and reads signs with B. Steve does it with a right
+// click (Minecraft's "use") on them: the nearest one in front of him within reach.
+
+static bool is_talking_action(u32 action) {
+    return action == ACT_READING_SIGN || action == ACT_WAITING_FOR_DIALOG || action == ACT_READING_NPC_DIALOG
+        || action == ACT_READING_AUTOMATIC_DIALOG;
+}
